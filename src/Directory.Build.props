<Project>
  <!-- Shared settings for every C# project -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <Platforms>x64;ARM64</Platforms>
    <!-- Pinned to the .NET 10 levels, so a newer SDK does not add rules that the code did not pass -->
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Authors>Devin Green</Authors>
    <!-- The one place the app display name lives: exe name, installer names and AppInfo.DisplayName all read it -->
    <AppDisplayName>Messages</AppDisplayName>
    <!-- App version (AppInfo.Version, the MSI version and the release tag v1.0.0). A fourth part is a build bump
         (1.0.2.1). Windows Installer ignores it, so Package.wxs allows same-version upgrades to let it install -->
    <Version>1.0.2.1</Version>
  </PropertyGroup>

  <!-- Display Name: stamped into every assembly, read at runtime by AppInfo.DisplayName -->
  <ItemGroup>
    <AssemblyMetadata Include="AppDisplayName" Value="$(AppDisplayName)" />
  </ItemGroup>
</Project>
