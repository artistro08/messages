<Project>
  <!-- Shared settings for every C# project -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <Platforms>x64;ARM64</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Authors>Devin Green</Authors>
    <!-- The one place the app display name lives: exe name, MSIX names and AppInfo.DisplayName all read it -->
    <AppDisplayName>Messages</AppDisplayName>
    <!-- App version (AppInfo.Version); keep it in step with Identity Version in src/GMessages.App/Package.appxmanifest -->
    <Version>0.5.4</Version>
  </PropertyGroup>

  <!-- Display Name: stamped into every assembly, read at runtime by AppInfo.DisplayName -->
  <ItemGroup>
    <AssemblyMetadata Include="AppDisplayName" Value="$(AppDisplayName)" />
  </ItemGroup>
</Project>
