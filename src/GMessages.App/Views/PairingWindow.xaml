<Window
    x:Class="GMessages.App.Views.PairingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Mica Background -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Title Bar: the title is set from code; Plan 3 adds the menu button and profile picture here -->
        <TitleBar
            x:Name="AppTitleBar"
            AutomationProperties.AutomationId="Pairing.TitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Signed-Out Reason: only above the sign-in -->
        <InfoBar
            Grid.Row="1"
            Margin="16,16,16,0"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.ShowSignedOutReason, Mode=OneWay}"
            Message="{x:Bind ViewModel.SignedOutReason}"
            Severity="Warning" />

        <!-- Signing In: Google sign-in runs in its own window (the sign-in helper process) -->
        <StackPanel
            Grid.Row="2"
            MaxWidth="440"
            Padding="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.IsSigningIn, Mode=OneWay}">
            <ProgressRing
                Width="48"
                Height="48"
                AutomationProperties.AutomationId="Pairing.SignInPending"
                IsActive="{x:Bind ViewModel.IsSigningIn, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="Pairing.SignInPendingText"
                Text="Sign in to Google in the window that opened."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
        <!-- /Signing In -->

        <!-- Waiting For Phone -->
        <StackPanel
            Grid.Row="2"
            MaxWidth="440"
            Padding="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.IsWaitingForPhone, Mode=OneWay}">
            <ProgressRing
                Width="48"
                Height="48"
                AutomationProperties.AutomationId="Pairing.Waiting"
                IsActive="{x:Bind ViewModel.IsWaitingForPhone, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="Pairing.WaitingText"
                Text="Check your phone. If nothing shows up, open Google Messages on your phone."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
        <!-- /Waiting For Phone -->

        <!-- Emoji -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.IsShowingEmoji, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="Pairing.Emoji"
                FontSize="96"
                Text="{x:Bind ViewModel.Emoji, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Tap this emoji on your phone" />
        </StackPanel>
        <!-- /Emoji -->

        <!-- Failure -->
        <StackPanel
            Grid.Row="2"
            MaxWidth="440"
            Padding="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.IsFailed, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="Pairing.Message"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="Pairing.TryAgain"
                Click="OnTryAgainClick"
                Content="Try again"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
        <!-- /Failure -->

        <!-- Footer -->
        <Button
            Grid.Row="3"
            Margin="16"
            HorizontalAlignment="Right"
            AutomationProperties.AutomationId="Pairing.Cancel"
            Click="OnCancelClick"
            Content="Cancel" />
    </Grid>
</Window>
