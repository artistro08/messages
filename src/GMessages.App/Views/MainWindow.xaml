<Window
    x:Class="GMessages.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Mica Background -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Placeholder: Plan 3 replaces this with the conversations -->
    <Grid x:Name="RootGrid" RowDefinitions="Auto,*">

        <!-- Title Bar: the title is set from code; Plan 3 adds the menu button and profile picture here -->
        <TitleBar
            x:Name="AppTitleBar"
            AutomationProperties.AutomationId="Main.TitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <StackPanel
            Grid.Row="1"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8">
            <TextBlock
                x:Name="StatusText"
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="Main.Status"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
        </StackPanel>
    </Grid>
</Window>
