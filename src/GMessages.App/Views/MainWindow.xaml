<Window
    x:Class="GMessages.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GMessages.App.Views.Controls"
    xmlns:local="using:GMessages.App.Views">

    <!-- Mica Background -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        PreviewKeyDown="OnRootPreviewKeyDown"
        RowDefinitions="Auto,*">

        <!-- Title Bar: ☰ on the left, the title from code, the profile picture (the owner's photo, else the default glyph) on the right.
             Tall (48 px) like the caption buttons, which the window asks for in code. ☰ and the profile hide while pairing -->
        <TitleBar
            x:Name="AppTitleBar"
            AutomationProperties.AutomationId="Main.TitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>

            <!-- Menu Button: collapses and expands the list -->
            <TitleBar.LeftHeader>
                <Button
                    x:Name="MenuButton"
                    Width="48"
                    Height="48"
                    Padding="0"
                    AutomationProperties.AutomationId="Main.MenuButton"
                    AutomationProperties.Name="Show or hide conversations"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnMenuClick">
                    <FontIcon FontSize="16" Glyph="&#xE700;" />
                </Button>
            </TitleBar.LeftHeader>

            <!-- Profile Button: Spam & blocked, Settings and Unpair -->
            <TitleBar.RightHeader>
                <Button
                    x:Name="ProfileButton"
                    Height="48"
                    Padding="8,0"
                    AutomationProperties.AutomationId="Main.ProfileButton"
                    AutomationProperties.Name="Account"
                    Background="Transparent"
                    BorderThickness="0">
                    <PersonPicture
                        x:Name="ProfilePicture"
                        Width="28"
                        Height="28" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem
                                x:Name="ProfileSpamBlocked"
                                AutomationProperties.AutomationId="Main.Profile.SpamBlocked"
                                Click="OnSpamBlockedClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8F8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="Main.Profile.Settings"
                                Click="OnSettingsClick"
                                Text="Settings">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE713;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="Main.Profile.Unpair"
                                Click="OnUnpairClick"
                                IsEnabled="{x:Bind local:SettingsPage.Not(Settings.IsUnpairing), Mode=OneWay}"
                                Text="Unpair"
                                Visibility="{x:Bind Settings.CanUnpair, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C9;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- Body: the pairing steps until paired, then the chats (set from code) -->
        <Border x:Name="BodyHost" Grid.Row="1" />

        <!-- Settings: over the whole body while open, Back closes it (set from code) -->
        <Border x:Name="SettingsHost" Grid.Row="1" />

        <!-- Unpair Confirm -->
        <controls:UnpairDialog x:Name="UnpairDialog" Grid.Row="1" />

        <!-- Shortcut Help (Ctrl + ?) -->
        <local:ShortcutHelpDialog x:Name="ShortcutDialog" Grid.Row="1" />
    </Grid>
</Window>
