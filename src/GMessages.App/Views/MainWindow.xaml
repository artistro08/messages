<Window
    x:Class="GMessages.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GMessages.App.Views.Controls"
    xmlns:local="using:GMessages.App.Views">

    <!-- Mica Background -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        PreviewKeyDown="OnRootPreviewKeyDown"
        RowDefinitions="Auto,*">

        <!-- Title Bar: ☰ on the left (the title bar's own Back in its place on Settings and Spam & blocked), the title from
             code, the profile picture (the owner's photo, else the default glyph) beside the caption buttons. Tall (48 px)
             like the caption buttons, which the window asks for in code. ☰ and the profile hide while pairing -->
        <TitleBar
            x:Name="AppTitleBar"
            AutomationProperties.AutomationId="Main.TitleBar"
            BackRequested="OnTitleBarBackRequested">
            <!-- Leaf Calendar's title bar: the content fills the space up to the caption buttons, with a narrow drag strip -->
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarMinDragRegionWidth">8</x:Double>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>

            <!-- Menu Button: collapses and expands the list. Fluent's subtle button with Windows' default hover and press
                 fill (owner, Plan 7), so its own resources put back the subtle brushes App.xaml clears for icon buttons; no
                 press animation. High contrast keeps the system's colors -->
            <TitleBar.LeftHeader>
                <Button
                    x:Name="MenuButton"
                    Width="48"
                    Height="48"
                    Padding="0"
                    AutomationProperties.AutomationId="Main.MenuButton"
                    AutomationProperties.Name="Show or hide conversations"
                    Click="OnMenuClick"
                    Style="{StaticResource SubtleButtonStyle}">
                    <Button.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Default">
                                    <StaticResource x:Key="SubtleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                    <StaticResource x:Key="SubtleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <StaticResource x:Key="SubtleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                    <StaticResource x:Key="SubtleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </Button.Resources>
                    <FontIcon FontSize="16" Glyph="&#xE700;" />
                </Button>
            </TitleBar.LeftHeader>

            <!-- Profile Button: Archived, Spam & blocked, Settings and Unpair. Just the picture, no hover or pressed background. It
                 sits at the right end of the title bar's content, which fills the space up to the caption buttons, so it
                 moves with the window edge in the same layout pass (Leaf Calendar's way, see the window's code). Only
                 the picture takes clicks; the empty content around it drags the window. The icon button style's clear 1 px
                 border plus 7 px padding keep the picture 8 px from each side, where it sat before -->
            <TitleBar.Content>
                <Grid x:Name="TitleBarContent" SizeChanged="OnTitleBarContentSizeChanged">
                    <Button
                        x:Name="ProfileButton"
                        Height="48"
                        Padding="7,0"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="Main.ProfileButton"
                        AutomationProperties.Name="Account"
                        Style="{StaticResource IconButtonStyle}">
                        <PersonPicture
                            x:Name="ProfilePicture"
                            Width="28"
                            Height="28" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem
                                    x:Name="ProfileArchived"
                                    AutomationProperties.AutomationId="Main.Profile.Archived"
                                    Click="OnArchivedClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7B8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="ProfileSpamBlocked"
                                    AutomationProperties.AutomationId="Main.Profile.SpamBlocked"
                                    Click="OnSpamBlockedClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8F8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    AutomationProperties.AutomationId="Main.Profile.Settings"
                                    Click="OnSettingsClick"
                                    Text="Settings">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE713;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    AutomationProperties.AutomationId="Main.Profile.Unpair"
                                    Click="OnUnpairClick"
                                    IsEnabled="{x:Bind local:SettingsPage.Not(Settings.IsUnpairing), Mode=OneWay}"
                                    Text="Unpair"
                                    Visibility="{x:Bind Settings.CanUnpair, Mode=OneWay}">
                                    <!-- Phone With A Slash: Segoe Fluent Icons has none, so Material Symbols' mobile_off (Apache 2.0),
                                         outlined, drawn on 16 px -->
                                    <MenuFlyoutItem.Icon>
                                        <PathIcon Data="M13.667 15.533 0.467 2.333 l0.933 -0.933 L14.6 14.6 l-0.933 0.933ZM3.333 4.283 l1.333 1.333 v6.383 h6.4 l1.6 1.6 v0.4 q0 0.55 -0.392 0.942 T11.333 15.333 H4.667 q-0.55 0 -0.942 -0.392 T3.333 14 v-9.717Zm1.333 9.05 v0.667 h6.667 v-0.667 H4.667Zm1.217 -9.333 -1.317 -1.333 h6.767 v-0.667 H3.9 l-0.467 -0.467 q0.167 -0.383 0.492 -0.625 T4.667 0.667 h6.667 q0.55 0 0.942 0.392 T12.667 2 v8.767 l-1.333 -1.333 v-5.433 H5.883Zm2.117 9.333Zm-0.383 -10.667Z" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <!-- Body: the pairing steps until paired, then the chats (set from code) -->
        <Border x:Name="BodyHost" Grid.Row="1" />

        <!-- Settings: over the whole body while open, entering with the standard page entrance; the title bar's Back closes
             it (set from code) -->
        <Border x:Name="SettingsHost" Grid.Row="1">
            <Border.ChildTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition />
                </TransitionCollection>
            </Border.ChildTransitions>
        </Border>

        <!-- Photo Viewer: a clicked photo over the whole body (both panes) -->
        <controls:PhotoViewer x:Name="PhotoViewer" Grid.Row="1" />

        <!-- Download Confirm: "Saved to Downloads" with Show in folder, at the bottom over everything; closes itself after a few
             seconds -->
        <InfoBar
            x:Name="DownloadedBar"
            Grid.Row="1"
            Margin="16,0,16,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            AutomationProperties.AutomationId="Main.Downloaded"
            IsOpen="False"
            Severity="Success"
            Title="{x:Bind local:MainWindow.SavedToDownloadsText}">
            <InfoBar.ActionButton>
                <Button
                    AutomationProperties.AutomationId="Main.Downloaded.ShowInFolder"
                    Click="OnShowInFolderClick"
                    Content="{x:Bind local:MainWindow.ShowInFolderText}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Unpair Confirm -->
        <controls:UnpairDialog x:Name="UnpairDialog" Grid.Row="1" />

        <!-- Shortcut Help (Ctrl + ?) -->
        <local:ShortcutHelpDialog x:Name="ShortcutDialog" Grid.Row="1" />
    </Grid>
</Window>
