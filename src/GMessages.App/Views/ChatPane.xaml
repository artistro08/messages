<UserControl
    x:Class="GMessages.App.Views.ChatPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GMessages.App.Views.Controls"
    xmlns:main="using:GMessages.Presentation.Main">

    <UserControl.Resources>

        <!-- Icon Button: just the icon, no background or hover; dimmed while disabled -->
        <Style x:Key="IconOnlyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            Content="{TemplateBinding Content}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ContentPresenter>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header: avatar and name (a narrow window's back is the title bar's) -->
        <Grid
            Padding="12,8,16,8"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="12">
            <controls:Avatar
                VerticalAlignment="Center"
                Color="{x:Bind Chat.AvatarColor, Mode=OneWay, FallbackValue=0}"
                Initial="{x:Bind Chat.Initial, Mode=OneWay, FallbackValue=''}"
                PhotoId="{x:Bind Chat.PhotoId, Mode=OneWay, FallbackValue=''}"
                SecondColor="{x:Bind Chat.SecondColor, Mode=OneWay, FallbackValue=0}"
                SecondInitial="{x:Bind Chat.SecondInitial, Mode=OneWay, FallbackValue=''}"
                SecondPhotoId="{x:Bind Chat.SecondPhotoId, Mode=OneWay, FallbackValue=''}" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Chat.Header"
                MaxLines="1"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind Chat.Title, Mode=OneWay, FallbackValue=''}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Messages: oldest at the top, kept scrolled to the newest; reaching the top loads older ones -->
        <ListView
            x:Name="MessageList"
            Grid.Row="1"
            Padding="12,8"
            AutomationProperties.AutomationId="Chat.Messages"
            Loaded="OnMessageListLoaded"
            PreviewKeyDown="OnMessageListKeyDown"
            SelectionMode="None">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel VerticalAlignment="Bottom" ItemsUpdatingScrollMode="KeepLastItemInView" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="main:MessageBubbleViewModel">
                    <controls:MessageBubble Bubble="{x:Bind}" RetryRequested="OnRetryRequested" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Loading: the history with nothing cached to show yet -->
        <ProgressRing
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="Chat.Loading"
            IsActive="{x:Bind Chat.IsLoadingHistory, Mode=OneWay, FallbackValue=False}" />

        <!-- Loading Older: a ring in a small raised circle at the top while scrolling up loads more -->
        <Border
            Grid.Row="1"
            Width="40"
            Height="40"
            Margin="0,12,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Translation="0,0,16"
            Visibility="{x:Bind Chat.IsLoadingOlder, Mode=OneWay, FallbackValue=Collapsed}">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <ProgressRing
                Width="20"
                Height="20"
                AutomationProperties.AutomationId="Chat.LoadingOlder"
                IsActive="{x:Bind Chat.IsLoadingOlder, Mode=OneWay, FallbackValue=False}" />
        </Border>

        <!-- Scroll To Bottom: floats just above the message box, fading in once the newest messages are a screen or more
             below (set from code) -->
        <Button
            x:Name="ScrollToBottomButton"
            Grid.Row="1"
            Width="40"
            Height="40"
            Margin="0,0,0,8"
            Padding="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            AutomationProperties.AutomationId="Chat.ScrollToBottom"
            AutomationProperties.Name="Scroll to bottom"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Click="OnScrollToBottomClick"
            CornerRadius="20"
            IsHitTestVisible="False"
            IsTabStop="False"
            Opacity="0"
            Translation="0,0,16">
            <Button.Shadow>
                <ThemeShadow />
            </Button.Shadow>
            <Button.OpacityTransition>
                <ScalarTransition />
            </Button.OpacityTransition>
            <FontIcon FontSize="16" Glyph="&#xE74B;" />
        </Button>

        <!-- Compose: the message box (Enter sends, Shift + Enter adds a line), with the emoji icon inside it on the left and
             send inside it on the right, icons only -->
        <Grid Grid.Row="2" Padding="12,8,12,12">
            <TextBox
                x:Name="DraftBox"
                MinHeight="44"
                MaxHeight="160"
                Padding="44,11,44,11"
                AcceptsReturn="True"
                AutomationProperties.AutomationId="Chat.Draft"
                AutomationProperties.Name="Message"
                PreviewKeyDown="OnDraftKeyDown"
                Text="{x:Bind Chat.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                TextWrapping="Wrap" />
            <Button
                Width="32"
                Height="32"
                Margin="6,0,0,6"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="Chat.Emoji"
                AutomationProperties.Name="Emoji"
                Click="OnEmojiClick"
                Style="{StaticResource IconOnlyButtonStyle}">
                <FontIcon
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE76E;" />
            </Button>
            <Button
                Width="32"
                Height="32"
                Margin="0,0,6,6"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="Chat.Send"
                AutomationProperties.Name="Send"
                Click="OnSendClick"
                IsEnabled="{x:Bind Chat.CanSend, Mode=OneWay, FallbackValue=False}"
                Style="{StaticResource IconOnlyButtonStyle}">
                <FontIcon
                    FontSize="16"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE724;" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
