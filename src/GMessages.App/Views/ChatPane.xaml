<UserControl
    x:Class="GMessages.App.Views.ChatPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GMessages.App.Views.Controls"
    xmlns:local="using:GMessages.App.Views"
    xmlns:main="using:GMessages.Presentation.Main">

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

        <!-- Header: avatar and name, with the lock after it in an encrypted chat (a narrow window's back is the title bar's),
             and the ⋮ at the right edge. Transparent, so a right-click anywhere on it opens the same menu -->
        <Grid
            x:Name="HeaderBar"
            Padding="12,8,8,8"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="12"
            ContextRequested="OnHeaderContextRequested">
            <controls:Avatar
                VerticalAlignment="Center"
                Color="{x:Bind Chat.AvatarColor, Mode=OneWay, FallbackValue=0}"
                Initial="{x:Bind Chat.Initial, Mode=OneWay, FallbackValue=''}"
                PhotoId="{x:Bind Chat.PhotoId, Mode=OneWay, FallbackValue=''}"
                SecondColor="{x:Bind Chat.SecondColor, Mode=OneWay, FallbackValue=0}"
                SecondInitial="{x:Bind Chat.SecondInitial, Mode=OneWay, FallbackValue=''}"
                SecondPhotoId="{x:Bind Chat.SecondPhotoId, Mode=OneWay, FallbackValue=''}" />
            <Grid
                Grid.Column="1"
                HorizontalAlignment="Left"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Chat.Header"
                    MaxLines="1"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind Chat.Title, Mode=OneWay, FallbackValue=''}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Chat.Encrypted"
                    AutomationProperties.Name="{x:Bind local:ChatPane.EncryptedText}"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="&#xE72E;"
                    ToolTipService.ToolTip="{x:Bind local:ChatPane.EncryptedText}"
                    Visibility="{x:Bind Chat.IsEncrypted, Mode=OneWay, FallbackValue=Collapsed}" />
            </Grid>

            <!-- More Options: the ⋮, styled like a list row's -->
            <Button
                x:Name="MoreButton"
                Grid.Column="2"
                Width="32"
                Height="32"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Chat.More"
                AutomationProperties.Name="{x:Bind local:ChatPane.MoreOptionsText}"
                Click="OnMoreClick"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind local:ChatPane.MoreOptionsText}">
                <FontIcon FontSize="16" Glyph="&#xE712;" />
            </Button>
        </Grid>
        <!-- /Header -->

        <!-- Messages: oldest at the top, kept scrolled to the newest; reaching the top loads older ones -->
        <ListView
            x:Name="MessageList"
            Grid.Row="1"
            Padding="12,8"
            AutomationProperties.AutomationId="Chat.Messages"
            ContextRequested="OnMessageListContextRequested"
            GotFocus="OnMessageListFocusChanged"
            Loaded="OnMessageListLoaded"
            LostFocus="OnMessageListFocusChanged"
            PreviewKeyDown="OnMessageListKeyDown"
            SelectionMode="None"
            ShowsScrollingPlaceholders="False">
            <!-- No scrolling placeholders: the jump to the newest message on a chat switch counted as fast scrolling, so the
                 list painted its gray placeholder over every row for a frame or two (the flash between chats) -->
            <!-- KeepItemsInView, not KeepLastItemInView: that one puts the last bubble at the bottom edge without the list's
                 bottom padding, scrolling a just-opened chat 8 px short of its end. Staying on
                 the newest message is ChatPane's pin -->
            <!-- Reaction Picker: LibGM's seven reactions in enum order (the buttons are added from code and styled by the
                 panel), opened over a bubble by its pill, its menu's React or Shift + + -->
            <FlyoutBase.AttachedFlyout>
                <Flyout x:Name="ReactionPicker" Placement="Top">
                    <Flyout.FlyoutPresenterStyle>
                        <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="AutomationProperties.AutomationId" Value="ReactionPicker" />
                        </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <StackPanel
                        x:Name="ReactionButtons"
                        Orientation="Horizontal"
                        Spacing="2"
                        XYFocusKeyboardNavigation="Enabled">
                        <StackPanel.Resources>
                            <Style
                                x:Key="ReactionButtonStyle"
                                BasedOn="{StaticResource DefaultButtonStyle}"
                                TargetType="Button">
                                <Setter Property="MinWidth" Value="40" />
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                                <Setter Property="BorderBrush" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                                <Setter Property="FontSize" Value="20" />
                            </Style>
                            <Style BasedOn="{StaticResource ReactionButtonStyle}" TargetType="Button" />
                            <!-- My Reaction: the same soft accent fill as my reaction pill, set from code when the picker opens -->
                            <Style
                                x:Key="ReactionButtonSelectedStyle"
                                BasedOn="{StaticResource ReactionButtonStyle}"
                                TargetType="Button">
                                <Setter Property="Background" Value="{ThemeResource ReactionPillMineBrush}" />
                                <Setter Property="BorderBrush" Value="{ThemeResource ReactionPillMineBrush}" />
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </StackPanel.Resources>
                    </StackPanel>
                </Flyout>
            </FlyoutBase.AttachedFlyout>
            <!-- No Transitions: no entrance or reorder animation on the bubbles, so an older page goes in above without the
                 shown ones fading or sliding (Google Messages for web doesn't animate history either) -->
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel VerticalAlignment="Bottom" ItemsUpdatingScrollMode="KeepItemsInView" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <!-- Rows: no system focus visual across the whole row; a focused bubble rings itself instead (owner request).
                 High contrast puts the system visual back from code (see ShowFocusRing in ChatPane.xaml.cs) -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="main:MessageBubbleViewModel">
                    <controls:MessageBubble
                        x:Name="BubbleView"
                        Bubble="{x:Bind}"
                        ReactRequested="OnReactRequested"
                        ReplyRequested="OnReplyRequested"
                        RetryRequested="OnRetryRequested"
                        VoiceRequested="OnVoiceRequested" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Loading: the history with nothing cached to show yet -->
        <ProgressRing
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="Chat.Loading"
            IsActive="{x:Bind Chat.IsLoadingHistory, Mode=OneWay, FallbackValue=False}" />

        <!-- Top Ring: a ring in a small raised circle at the top while older messages load -->
        <Border
            Grid.Row="1"
            AutomationProperties.AutomationId="Chat.TopRing"
            Width="40"
            Height="40"
            Margin="0,12,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Translation="0,0,16"
            Visibility="{x:Bind Chat.IsLoadingOlder, Mode=OneWay, FallbackValue=Collapsed}">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <ProgressRing
                Width="20"
                Height="20"
                AutomationProperties.AutomationId="Chat.LoadingOlder"
                IsActive="{x:Bind Chat.IsLoadingOlder, Mode=OneWay, FallbackValue=False}" />
        </Border>

        <!-- Scroll To Bottom: floats just above the message box, fading in once the newest messages are a screen or more
             below (set from code) -->
        <Button
            x:Name="ScrollToBottomButton"
            Grid.Row="1"
            Width="40"
            Height="40"
            Margin="0,0,0,8"
            Padding="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            AutomationProperties.AutomationId="Chat.ScrollToBottom"
            AutomationProperties.Name="Scroll to bottom"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Click="OnScrollToBottomClick"
            CornerRadius="20"
            IsHitTestVisible="False"
            IsTabStop="False"
            Opacity="0"
            Translation="0,0,16">

            <!-- No Hover Or Press Background (Task 22): the circle keeps its own fill and edge; high contrast keeps the
                 system's own hover and press colors -->
            <Button.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="CardStrokeColorDefaultBrush" />
                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="CardStrokeColorDefaultBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="CardStrokeColorDefaultBrush" />
                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="CardStrokeColorDefaultBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </Button.Resources>
            <Button.Shadow>
                <ThemeShadow />
            </Button.Shadow>
            <Button.OpacityTransition>
                <ScalarTransition />
            </Button.OpacityTransition>
            <FontIcon FontSize="16" Glyph="&#xE74B;" />
        </Button>

        <!-- Typing: a received-style bubble with three dots while the other person types; outside the list, so it never
             moves the scroll. The dots bounce in turn while it shows (started from code) -->
        <Border
            x:Name="TypingBubble"
            Grid.Row="2"
            Margin="12,4,12,0"
            Padding="14,6"
            HorizontalAlignment="Left"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Visibility="{x:Bind Chat.IsTyping, Mode=OneWay, FallbackValue=Collapsed}">
            <Grid Height="21">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Ellipse
                        x:Name="TypingDot1"
                        Width="6"
                        Height="6"
                        Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Ellipse
                        x:Name="TypingDot2"
                        Width="6"
                        Height="6"
                        Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Ellipse
                        x:Name="TypingDot3"
                        Width="6"
                        Height="6"
                        Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Name: "Typing" for screen readers and the tests; draws nothing -->
                <TextBlock
                    AutomationProperties.AccessibilityView="Content"
                    AutomationProperties.AutomationId="Chat.Typing"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="{x:Bind local:ChatPane.TypingText}" />
            </Grid>
        </Border>
        <!-- /Typing -->

        <!-- Over The Message Box: the attachment chips, then the reply chip -->
        <StackPanel Grid.Row="3">
            <!-- Attachments: a chip per picked photo (the photo itself) or file (its icon and name), in send order, each with a
                 button to drop it. The too-big note shows over them when a picked file was refused -->
            <TextBlock
                Margin="12,8,12,0"
                AutomationProperties.AutomationId="Chat.AttachError"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Chat.AttachError, Mode=OneWay, FallbackValue=''}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Chat.HasAttachError, Mode=OneWay, FallbackValue=Collapsed}" />
            <ScrollViewer
                Margin="12,8,12,0"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                Visibility="{x:Bind Chat.HasAttachments, Mode=OneWay, FallbackValue=Collapsed}">
                <ItemsControl x:Name="AttachmentList" AutomationProperties.AutomationId="Chat.Attachments">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="main:PendingAttachment">
                            <Grid
                                Height="64"
                                MinWidth="64"
                                AutomationProperties.AutomationId="{x:Bind local:ChatPane.ChipIdOf('Chat.Attachment.', Id)}"
                                AutomationProperties.Name="{x:Bind Name}"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Image
                                    Width="64"
                                    Height="64"
                                    Source="{x:Bind local:ChatPane.ChipImage(Bytes, IsPhoto)}"
                                    Stretch="UniformToFill"
                                    Visibility="{x:Bind IsPhoto}" />
                                <StackPanel
                                    Padding="12,0,36,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind local:ChatPane.Not(IsPhoto)}">
                                    <FontIcon FontSize="20" Glyph="&#xE8A5;" />
                                    <TextBlock
                                        MaxWidth="160"
                                        VerticalAlignment="Center"
                                        MaxLines="1"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button
                                    Width="24"
                                    Height="24"
                                    Margin="0,4,4,0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    AutomationProperties.AutomationId="{x:Bind local:ChatPane.ChipIdOf('Chat.RemoveAttachment.', Id)}"
                                    AutomationProperties.Name="{x:Bind local:ChatPane.RemoveAttachmentText}"
                                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                    Click="OnRemoveAttachmentClick"
                                    CornerRadius="12"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind local:ChatPane.RemoveAttachmentText}">
                                    <FontIcon FontSize="10" Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <!-- /Attachments -->

            <!-- Microphone Off: access is off or there is no microphone; the link opens Windows' microphone privacy settings
                 (its runs are set from code, from the copy) -->
            <TextBlock
                x:Name="MicError"
                Margin="12,8,12,0"
                AutomationProperties.AutomationId="Chat.MicError"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Chat.Voice.IsMicrophoneOff, Mode=OneWay, FallbackValue=Collapsed}" />

            <!-- Voice Preview: the recording waiting for Send, with play or pause, its waveform (a click seeks), its length and
                 a button to remove it (which deletes it) -->
            <Grid
                Margin="12,8,12,0"
                Padding="4,4,4,4"
                HorizontalAlignment="Left"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                ColumnDefinitions="Auto,Auto,Auto,Auto"
                ColumnSpacing="8"
                CornerRadius="8"
                Visibility="{x:Bind Chat.Voice.IsPreview, Mode=OneWay, FallbackValue=Collapsed}">
                <Button
                    x:Name="PreviewPlay"
                    Width="32"
                    Height="32"
                    AutomationProperties.AutomationId="Chat.VoicePlay"
                    Click="OnPreviewPlayClick"
                    Style="{StaticResource IconButtonStyle}">
                    <FontIcon x:Name="PreviewGlyph" FontSize="16" />
                </Button>
                <controls:Waveform
                    x:Name="PreviewBars"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    BarBrush="{ThemeResource TextFillColorPrimaryBrush}"
                    SeekRequested="OnPreviewSeekRequested" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Chat.VoiceLength"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Chat.Voice.LengthText, Mode=OneWay, FallbackValue=''}" />
                <Button
                    Grid.Column="3"
                    Width="32"
                    Height="32"
                    AutomationProperties.AutomationId="Chat.VoiceRemove"
                    AutomationProperties.Name="{x:Bind local:ChatPane.RemoveAttachmentText}"
                    Click="OnPreviewRemoveClick"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind local:ChatPane.RemoveAttachmentText}">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>
            <!-- /Voice Preview -->

            <!-- Replying To: joined to the top of the message box as one control (the same width and left edge, rounded on top
                 only, while the box squares its top corners): an accent bar, the quoted text and a button to drop the reply -->
            <Grid
                Margin="12,8,12,0"
                Padding="8,6,4,6"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1,1,1,0"
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="8"
                CornerRadius="4,4,0,0"
                Visibility="{x:Bind Chat.IsReplying, Mode=OneWay, FallbackValue=Collapsed}">
                <Border
                    Width="3"
                    Background="{ThemeResource QuoteBarBrush}"
                    CornerRadius="1.5" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Chat.ReplyingTo"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="2"
                    Text="{x:Bind Chat.ReplyingTo.DisplayText, Mode=OneWay, FallbackValue=''}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <Button
                    Grid.Column="2"
                    Width="32"
                    Height="32"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Chat.CancelReply"
                    AutomationProperties.Name="{x:Bind local:ChatPane.CancelReplyText}"
                    Click="OnCancelReplyClick"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind local:ChatPane.CancelReplyText}">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </StackPanel>

        <!-- Compose: the message box (Enter sends, Shift + Enter adds a line), with the attach and emoji icons inside it on the
             left and the mic and send inside it on the right, icons only. Under the reply chip it meets the chip with square top corners -->
        <Grid Grid.Row="4" Padding="{x:Bind local:ChatPane.ComposePadding(Chat.IsReplying), Mode=OneWay}">
            <TextBox
                x:Name="DraftBox"
                MinHeight="44"
                MaxHeight="160"
                Padding="76,11,76,11"
                AcceptsReturn="True"
                AutomationProperties.AutomationId="Chat.Draft"
                AutomationProperties.Name="Message"
                CornerRadius="{x:Bind local:ChatPane.DraftCorners(Chat.IsReplying), Mode=OneWay}"
                PreviewKeyDown="OnDraftKeyDown"
                Text="{x:Bind Chat.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                TextWrapping="Wrap">

                <!-- One Color: the box keeps its focused (active) fill at rest and on hover too, so it never changes color.
                     The border and the bottom accent line keep their normal Fluent focus look. High contrast keeps the
                     system's own TextBox colors -->
                <TextBox.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default">
                                <StaticResource x:Key="TextControlBackground" ResourceKey="ControlFillColorInputActiveBrush" />
                                <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="ControlFillColorInputActiveBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <StaticResource x:Key="TextControlBackground" ResourceKey="ControlFillColorInputActiveBrush" />
                                <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="ControlFillColorInputActiveBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast">
                                <StaticResource x:Key="TextControlBackground" ResourceKey="SystemControlBackgroundAltMediumLowBrush" />
                                <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SystemControlBackgroundAltMediumBrush" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </TextBox.Resources>
            </TextBox>

            <!-- Attach: the ＋ opens the file picker for any files (Ctrl + Shift + a; Ctrl + Shift + p for photos) -->
            <Button
                Width="32"
                Height="32"
                Margin="6,0,0,6"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="Chat.Attach"
                AutomationProperties.Name="{x:Bind local:ChatPane.AttachText}"
                Click="OnAttachClick"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind local:ChatPane.AttachText}">
                <FontIcon
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE710;" />
            </Button>
            <Button
                Width="32"
                Height="32"
                Margin="38,0,0,6"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="Chat.Emoji"
                AutomationProperties.Name="Emoji"
                Click="OnEmojiClick"
                Style="{StaticResource IconButtonStyle}">
                <FontIcon
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE76E;" />
            </Button>
            <!-- Record: the mic, inside the box's right edge beside Send, always there -->
            <Button
                Width="32"
                Height="32"
                Margin="0,0,38,6"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="Chat.Record"
                AutomationProperties.Name="{x:Bind local:ChatPane.RecordText}"
                Click="OnRecordClick"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind local:ChatPane.RecordText}">
                <FontIcon
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE720;" />
            </Button>
            <Button
                Width="32"
                Height="32"
                Margin="0,0,6,6"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="Chat.Send"
                AutomationProperties.Name="Send"
                Click="OnSendClick"
                IsEnabled="{x:Bind Chat.CanSend, Mode=OneWay, FallbackValue=False}"
                Style="{StaticResource IconButtonStyle}">
                <!-- Dimmed While Disabled: the icon keeps its own accent color, so the button's disabled color can't reach it -->
                <FontIcon
                    FontSize="16"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE724;"
                    Opacity="{x:Bind local:ChatPane.EnabledOpacity(Chat.CanSend), Mode=OneWay, FallbackValue=0.4}" />
            </Button>

            <!-- Recording: over the message box while the mic records, a red dot, the running time, the live waveform of the
                 input level, then Cancel recording (deletes it) and Stop (keeps it for the preview chip). On a solid base, since
                 the box's fill lets what is under it show -->
            <Border
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                CornerRadius="{x:Bind local:ChatPane.DraftCorners(Chat.IsReplying), Mode=OneWay}"
                Visibility="{x:Bind Chat.Voice.IsRecording, Mode=OneWay, FallbackValue=Collapsed}">
                <Grid
                    Padding="12,0,6,0"
                    Background="{ThemeResource ControlFillColorInputActiveBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                    ColumnSpacing="8"
                    CornerRadius="{x:Bind local:ChatPane.DraftCorners(Chat.IsReplying), Mode=OneWay}">
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock
                        x:Name="RecordTimer"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Chat.RecordTimer" />
                    <controls:Waveform
                        x:Name="RecordBars"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        BarBrush="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button
                        Grid.Column="3"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Chat.CancelRecording"
                        AutomationProperties.Name="{x:Bind local:ChatPane.CancelRecordingText}"
                        Click="OnCancelRecordingClick"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind local:ChatPane.CancelRecordingText}">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE74D;" />
                    </Button>
                    <Button
                        x:Name="StopRecordingButton"
                        Grid.Column="4"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Chat.StopRecording"
                        AutomationProperties.Name="{x:Bind local:ChatPane.StopText}"
                        Click="OnStopRecordingClick"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind local:ChatPane.StopText}">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE71A;" />
                    </Button>
