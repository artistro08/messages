<UserControl
    x:Class="GMessages.App.Views.ChatPane"
    AutomationProperties.AutomationId="Chat.Pane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GMessages.App.Views.Controls"
    xmlns:local="using:GMessages.App.Views"
    xmlns:main="using:GMessages.Presentation.Main"
    xmlns:messaging="using:GMessages.Presentation.Messaging"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <UserControl.Resources>

        <!-- One bubble menu serves every bubble. A right-click opens it at the pointer. The Application key or
             Shift + F10 opens it over the back of the bubble. The ⋮ of the hover strip also opens it. See
             OnMessageListContextRequested. The items match the bubble that the menu opens on. A photo or file
             without a caption has no Copy. A received program or script has no Open. The owner chose that Open with
             shows on every attachment, those included. -->
        <MenuFlyout x:Name="BubbleMenu">
            <MenuFlyoutItem
                x:Name="BubbleMenuCopy"
                AutomationProperties.AutomationId="Bubble.Copy"
                Click="OnBubbleMenuCopyClick"
                Text="{x:Bind controls:MessageBubble.CopyText}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <!-- Copy link copies the first link in the text of a text message itself, never a link in its quote. -->
            <MenuFlyoutItem
                x:Name="BubbleMenuCopyLink"
                AutomationProperties.AutomationId="Bubble.CopyLink"
                Click="OnCopyLinkClick"
                Text="{x:Bind controls:MessageBubble.CopyLinkText}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE71B;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                x:Name="BubbleMenuOpen"
                AutomationProperties.AutomationId="Bubble.Open"
                Click="OnBubbleMenuOpenClick"
                Text="{x:Bind controls:MessageBubble.OpenText}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8E5;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                x:Name="BubbleMenuOpenWith"
                AutomationProperties.AutomationId="Bubble.OpenWith"
                Click="OnBubbleMenuOpenWithClick"
                Text="{x:Bind controls:MessageBubble.OpenWithText}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE7AC;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                x:Name="BubbleMenuSaveAs"
                AutomationProperties.AutomationId="Bubble.SaveAs"
                Click="OnBubbleMenuSaveAsClick"
                Text="{x:Bind controls:MessageBubble.SaveAsText}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE792;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                x:Name="BubbleMenuDownload"
                AutomationProperties.AutomationId="Bubble.Download"
                Click="OnBubbleMenuDownloadClick"
                Text="{x:Bind controls:MessageBubble.DownloadText}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE896;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                AutomationProperties.AutomationId="Bubble.React"
                Click="OnBubbleMenuReactClick"
                KeyboardAcceleratorTextOverride="Shift + +"
                Text="{x:Bind controls:MessageBubble.ReactText}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE76E;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                AutomationProperties.AutomationId="Bubble.Reply"
                Click="OnBubbleMenuReplyClick"
                KeyboardAcceleratorTextOverride="Ctrl + Enter"
                Text="{x:Bind controls:MessageBubble.ReplyText}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE97A;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                x:Name="BubbleMenuDelete"
                AutomationProperties.AutomationId="Bubble.Delete"
                Click="OnBubbleMenuDeleteClick"
                Text="{x:Bind controls:MessageBubble.DeleteText}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <!-- A link preview card opens this menu with Copy link in place of the bubble menu. -->
        <MenuFlyout x:Name="PreviewMenu">
            <MenuFlyoutItem
                AutomationProperties.AutomationId="Preview.CopyLink"
                Click="OnCopyLinkClick"
                Text="{x:Bind controls:MessageBubble.CopyLinkText}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE71B;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </UserControl.Resources>

    <Grid x:Name="PaneGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The header shows the avatar and the name, and the ⋮ at the right edge. A narrow window uses the Back of
             the title bar. The header is transparent, so a right-click anywhere on it opens the same menu. -->
        <Grid
            x:Name="HeaderBar"
            Padding="12,8,8,8"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="12"
            ContextRequested="OnHeaderContextRequested">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:Avatar
                VerticalAlignment="Center"
                Color="{x:Bind Chat.AvatarColor, Mode=OneWay, FallbackValue=0}"
                Initial="{x:Bind Chat.Initial, Mode=OneWay, FallbackValue=''}"
                PhotoId="{x:Bind Chat.PhotoId, Mode=OneWay, FallbackValue=''}"
                SecondColor="{x:Bind Chat.SecondColor, Mode=OneWay, FallbackValue=0}"
                SecondInitial="{x:Bind Chat.SecondInitial, Mode=OneWay, FallbackValue=''}"
                SecondPhotoId="{x:Bind Chat.SecondPhotoId, Mode=OneWay, FallbackValue=''}" />
            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Chat.Header"
                FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                MaxLines="1"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind Chat.Title, Mode=OneWay, FallbackValue=''}"
                TextTrimming="CharacterEllipsis" />

            <!-- The bell shows the mute state of the chat, crossed out while muted. A click flips the state, as Mute
                 or Unmute of the ⋮ menu does. The bell hides where the menu has neither, in spam and blocked. -->
            <Button
                x:Name="MuteButton"
                Grid.Column="2"
                Width="32"
                Height="32"
                Margin="0,0,-8,0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Chat.Mute"
                AutomationProperties.Name="{x:Bind local:ChatPane.MuteText(Chat.IsMuted), Mode=OneWay, FallbackValue=''}"
                Click="OnMuteClick"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind local:ChatPane.MuteText(Chat.IsMuted), Mode=OneWay, FallbackValue=''}"
                Visibility="{x:Bind Chat.CanMute, Mode=OneWay, FallbackValue=Collapsed}">
                <FontIcon FontSize="16" Glyph="{x:Bind local:ChatPane.MuteGlyph(Chat.IsMuted), Mode=OneWay, FallbackValue=''}" />
            </Button>

            <!-- The ⋮ has the style of the ⋮ of a list row. -->
            <Button
                x:Name="MoreButton"
                Grid.Column="3"
                Width="32"
                Height="32"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Chat.More"
                AutomationProperties.Name="{x:Bind local:ChatPane.MoreOptionsText}"
                Click="OnMoreClick"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind local:ChatPane.MoreOptionsText}">
                <FontIcon FontSize="16" Glyph="&#xE712;" />
            </Button>
        </Grid>

        <!-- The oldest message is at the top, and the list stays at the newest message. A scroll to the top loads
             older messages. The owner chose that the typing bubble, the chips and the message box float over the list.
             The bottom padding of the list keeps the newest bubble clear of them. The code sets it in
             KeepComposerClear. The bottom of the list fades out behind them. -->
        <ListView
            x:Name="MessageList"
            Grid.Row="1"
            Grid.RowSpan="4"
            Padding="12,8"
            AutomationProperties.AutomationId="Chat.Messages"
            ContextRequested="OnMessageListContextRequested"
            GotFocus="OnMessageListFocusChanged"
            Loaded="OnMessageListLoaded"
            LostFocus="OnMessageListFocusChanged"
            PreviewKeyDown="OnMessageListKeyDown"
            SelectionMode="None"
            ShowsScrollingPlaceholders="False">
            <!-- The list has no scrolling placeholders. The jump to the newest message on a chat switch counted as a
                 fast scroll. The list then painted its gray placeholder over every row for 1 or 2 frames. That was
                 the flash between chats. -->
            <!-- The list uses KeepItemsInView, not KeepLastItemInView. KeepLastItemInView puts the last bubble at the
                 bottom edge without the bottom padding of the list. A chat that just opened then stops 8 px short of
                 its end. The pin of ChatPane keeps the list on the newest message. -->
            <!-- The reaction picker shows the 7 reactions of LibGM in enum order, then More reactions. The code adds
                 the buttons, and the panel styles them. React in the bubble menu or the hover strip opens the
                 picker over a bubble, as does Shift + +. -->
            <FlyoutBase.AttachedFlyout>
                <Flyout x:Name="ReactionPicker" Placement="Top">
                    <Flyout.FlyoutPresenterStyle>
                        <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="AutomationProperties.AutomationId" Value="ReactionPicker" />
                        </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <StackPanel
                        x:Name="ReactionButtons"
                        Orientation="Horizontal"
                        Spacing="2"
                        XYFocusKeyboardNavigation="Enabled">
                        <StackPanel.Resources>
                            <Style
                                x:Key="ReactionButtonStyle"
                                BasedOn="{StaticResource DefaultButtonStyle}"
                                TargetType="Button">
                                <Setter Property="MinWidth" Value="40" />
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                                <Setter Property="BorderBrush" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                                <Setter Property="FontSize" Value="20" />
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                            <Style BasedOn="{StaticResource ReactionButtonStyle}" TargetType="Button" />

                            <!-- My reaction gets the soft accent fill of my reaction pill. The fill sits behind the
                                 button, and the code sets it when the picker opens. Behind the button, the hover only
                                 tints the fill. On the button itself, the hover swapped the fill for the hover fill.
                                 That swap ran through the 83 ms brush transition and caused the flicker. -->
                            <Style x:Key="ReactionSelectedBackStyle" TargetType="Border">
                                <Setter Property="Background" Value="{ThemeResource ReactionPillMineBrush}" />
                            </Style>

                            <!-- The emoji picker uses this style for the name of a category over its emoji. The note of
                                 an empty search also uses it. The code builds both. -->
                            <Style
                                x:Key="EmojiPickerNoteStyle"
                                BasedOn="{StaticResource CaptionTextBlockStyle}"
                                TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Style>
                        </StackPanel.Resources>
                    </StackPanel>
                </Flyout>
            </FlyoutBase.AttachedFlyout>
            <!-- The bubbles have no entrance or reorder animation. Thus an older page goes in above, and the shown
                 bubbles do not fade or slide. Google Messages for web does not animate the history either. -->
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- With KeepItemsInView, the first shown bubble stays in place as rows measure. While an older
                         page goes in above, the code switches to KeepLastItemInView. At the top of the list,
                         KeepItemsInView let the page take the view. It anchored the first row, which became the
                         first row of the page. The chat then jumped to the top of the page. -->
                    <ItemsStackPanel
                        VerticalAlignment="Bottom"
                        CacheLength="1"
                        ItemsUpdatingScrollMode="KeepItemsInView" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <!-- The rows have no system focus visual across the whole row. The owner asked that a focused bubble
                 rings itself instead. In high contrast the code puts the system visual back. See ShowFocusRing in
                 ChatPane.xaml.cs. -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="main:MessageBubbleViewModel">
                    <controls:MessageBubble
                        x:Name="BubbleView"
                        Bubble="{x:Bind}"
                        MenuRequested="OnMenuRequested"
                        ReactRequested="OnReactRequested"
                        QuoteRequested="OnQuoteRequested"
                        ReplyRequested="OnReplyRequested"
                        RetryRequested="OnRetryRequested"
                        VoiceRequested="OnVoiceRequested" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- This ring shows while the history loads with nothing in the cache to show yet. -->
        <muxc:ProgressRing
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="Chat.Loading"
            IsActive="{x:Bind Chat.IsLoadingHistory, Mode=OneWay, FallbackValue=False}" />

        <!-- A ring in a small raised circle shows at the top while older messages load. -->
        <Border
            Grid.Row="1"
            AutomationProperties.AutomationId="Chat.TopRing"
            Width="40"
            Height="40"
            Margin="0,12,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Translation="0,0,16"
            Visibility="{x:Bind Chat.IsLoadingOlder, Mode=OneWay, FallbackValue=Collapsed}">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <!-- At 24 px the ring draws a whole 3 px stroke, as the ring of the chat list does. At 20 px it drew a
                 jagged 2.5 px stroke. -->
            <muxc:ProgressRing
                Width="24"
                Height="24"
                AutomationProperties.AutomationId="Chat.LoadingOlder"
                IsActive="{x:Bind Chat.IsLoadingOlder, Mode=OneWay, FallbackValue=False}" />
        </Border>

        <!-- The scroll-to-bottom arrow floats just above the message box. It fades in when the newest messages are
             1 screen or more below, and the code sets that. The hand cursor shows over it, as over a link. See
             LinkCardButton. -->
        <controls:LinkCardButton
            x:Name="ScrollToBottomButton"
            Grid.Row="1"
            Width="40"
            Height="40"
            Margin="0,0,0,8"
            Padding="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            AutomationProperties.AutomationId="Chat.ScrollToBottom"
            AutomationProperties.Name="Scroll to bottom"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Click="OnScrollToBottomClick"
            CornerRadius="20"
            IsHitTestVisible="False"
            IsTabStop="False"
            Opacity="0">

            <!-- The owner chose no hover or press background in Task 22. The circle keeps its own fill and edge.
                 High contrast keeps the hover and press colors of the system. -->
            <controls:LinkCardButton.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="CardStrokeColorDefaultBrush" />
                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="CardStrokeColorDefaultBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="CardStrokeColorDefaultBrush" />
                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="CardStrokeColorDefaultBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </controls:LinkCardButton.Resources>
            <controls:LinkCardButton.Shadow>
                <ThemeShadow />
            </controls:LinkCardButton.Shadow>
            <controls:LinkCardButton.OpacityTransition>
                <ScalarTransition />
            </controls:LinkCardButton.OpacityTransition>
            <FontIcon FontSize="16" Glyph="&#xE74B;" />
        </controls:LinkCardButton>

        <!-- While the other person types, their avatar shows beside a received bubble with 3 dots. The bubble is
             outside the list, so it never moves the scroll. The dots bounce in turn while it shows. The code starts
             the bounce. -->
        <StackPanel
            x:Name="TypingBubble"
            Grid.Row="2"
            Margin="12,4,12,0"
            HorizontalAlignment="Left"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind Chat.IsTyping, Mode=OneWay, FallbackValue=Collapsed}">
            <!-- The avatar has the same 28 px as on received bubbles, centered on the bubble of the dots. -->
            <Viewbox
                Width="28"
                Height="28"
                VerticalAlignment="Center">
                <controls:Avatar
                    Color="{x:Bind Chat.TypingColor, Mode=OneWay, FallbackValue=0}"
                    Initial="{x:Bind Chat.TypingInitial, Mode=OneWay, FallbackValue=''}"
                    PhotoId="{x:Bind Chat.TypingPhotoId, Mode=OneWay, FallbackValue=''}" />
            </Viewbox>

            <Border
                Padding="14,6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="18">
                <Grid Height="21">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Ellipse
                            x:Name="TypingDot1"
                            Width="6"
                            Height="6"
                            Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Ellipse
                            x:Name="TypingDot2"
                            Width="6"
                            Height="6"
                            Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Ellipse
                            x:Name="TypingDot3"
                            Width="6"
                            Height="6"
                            Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- This element gives "Ann is typing" to screen readers and the tests. It draws nothing. -->
                    <TextBlock
                        AutomationProperties.AccessibilityView="Content"
                        AutomationProperties.AutomationId="Chat.Typing"
                        AutomationProperties.LiveSetting="Polite"
                        AutomationProperties.Name="{x:Bind Chat.TypingName, Mode=OneWay, FallbackValue=''}" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- The note for a refused file, the reply chip and the attachment chips sit over the message box. They
             stack and join the top of the message box as 1 control. -->
        <StackPanel Grid.Row="3">
            <!-- The note shows over the chips when the pane refused a picked file. -->
            <TextBlock
                Margin="12,8,12,0"
                AutomationProperties.AutomationId="Chat.AttachError"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Chat.AttachError, Mode=OneWay, FallbackValue=''}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Chat.HasAttachError, Mode=OneWay, FallbackValue=Collapsed}" />

            <!-- The reply chip joins the top of the message box as 1 control. It has the same width and left edge.
                 It is rounded only on top, while the box squares its top corners. It looks like the quote in a
                 bubble: a neutral frame around a darker card that holds the thumbnail or icon of quoted media, the
                 sender and up to 2 lines of the quoted text. Media shows "Image", "Video" or "GIF", or the file
                 name. A round button in the top right corner of the card drops the reply, as on an attachment chip.
                 See QuoteButton in MessageBubble.xaml. -->
            <Grid
                Margin="12,8,12,0"
                Padding="6"
                Background="{ThemeResource QuoteFrameBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1,1,1,0"
                CornerRadius="8,8,0,0"
                Visibility="{x:Bind Chat.IsReplying, Mode=OneWay, FallbackValue=Collapsed}">
                <Grid Padding="10,10,36,10" Style="{StaticResource QuoteCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:MediaThumb
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Chat.ReplyingToThumb"
                        Media="{x:Bind Chat.ReplyingTo.Media, Mode=OneWay}"
                        Visibility="{x:Bind Chat.ReplyingTo.HasMediaFile, Mode=OneWay, FallbackValue=Collapsed}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            AutomationProperties.AutomationId="Chat.ReplyingToSender"
                            Style="{StaticResource QuoteSenderTextStyle}"
                            Text="{x:Bind Chat.ReplyingToSender, Mode=OneWay, FallbackValue=''}"
                            Visibility="{x:Bind local:UiHelpers.ShownIfText(Chat.ReplyingToSender), Mode=OneWay, FallbackValue=Collapsed}" />
                        <TextBlock
                            AutomationProperties.AutomationId="Chat.ReplyingTo"
                            Style="{StaticResource QuoteBodyTextStyle}"
                            Text="{x:Bind Chat.ReplyingTo.ReplyChipText, Mode=OneWay, FallbackValue=''}" />
                    </StackPanel>
                </Grid>
                <Button
                    AutomationProperties.AutomationId="Chat.CancelReply"
                    AutomationProperties.Name="{x:Bind local:ChatPane.CancelReplyText}"
                    Click="OnCancelReplyClick"
                    Style="{StaticResource ChipRemoveButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind local:ChatPane.CancelReplyText}">

                    <!-- The round fill stays on hover and press, as on the remove button of an attachment chip. -->
                    <Button.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Light">
                                    <StaticResource x:Key="SubtleButtonBackgroundPointerOver" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                                    <StaticResource x:Key="SubtleButtonBackgroundPressed" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Dark">
                                    <StaticResource x:Key="SubtleButtonBackgroundPointerOver" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                                    <StaticResource x:Key="SubtleButtonBackgroundPressed" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </Button.Resources>
                    <FontIcon FontSize="10" Glyph="&#xE711;" />
                </Button>
            </Grid>

            <!-- The attachment chips join the box as the reply chip does. When both show, the strip sits under the
                 reply chip, and its top border is the line between them. The voice preview comes first. Then each
                 picked or pasted file gets a chip in send order, with a button that drops it. A photo chip shows the
                 photo. A video chip shows its frame when Windows has one. A file chip shows its icon and name. -->
            <Border
                Margin="{x:Bind local:ChatPane.StripMargin(Chat.IsReplying), Mode=OneWay}"
                Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1,1,1,0"
                CornerRadius="{x:Bind local:ChatPane.StripCorners(Chat.IsReplying), Mode=OneWay}"
                Visibility="{x:Bind local:ChatPane.AnyChips(Chat.HasAttachments, Chat.Voice.IsPreview), Mode=OneWay, FallbackValue=Collapsed}">
                <ScrollViewer
                    Padding="8"
                    AutomationProperties.AutomationId="Chat.AttachStrip"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- The voice preview holds the recording that waits for Send. It is the first chip, because
                             it sends first. It has play or pause, its waveform, its length and a remove button. A
                             click or the arrow keys on the waveform seek. The remove button deletes the recording. -->
                        <Grid
                            Height="64"
                            MinWidth="64"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{x:Bind Chat.Voice.IsPreview, Mode=OneWay, FallbackValue=Collapsed}">
                            <StackPanel
                                Padding="4,0,36,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="PreviewPlay"
                                    Width="32"
                                    Height="32"
                                    AutomationProperties.AutomationId="Chat.VoicePlay"
                                    Click="OnPreviewPlayClick"
                                    Style="{StaticResource IconButtonStyle}">
                                    <FontIcon x:Name="PreviewGlyph" FontSize="16" />
                                </Button>
                                <controls:Waveform
                                    x:Name="PreviewBars"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="Chat.VoiceWave"
                                    BarBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                    SeekRequested="OnPreviewSeekRequested" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="Chat.VoiceLength"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Chat.Voice.LengthText, Mode=OneWay, FallbackValue=''}" />
                            </StackPanel>
                            <Button
                                AutomationProperties.AutomationId="Chat.VoiceRemove"
                                AutomationProperties.Name="{x:Bind local:ChatPane.RemoveAttachmentText}"
                                Click="OnPreviewRemoveClick"
                                Style="{StaticResource ChipRemoveButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind local:ChatPane.RemoveAttachmentText}">

                                <!-- The round fill stays on hover and press, as on the other remove buttons. -->
                                <Button.Resources>
                                    <ResourceDictionary>
                                        <ResourceDictionary.ThemeDictionaries>
                                            <ResourceDictionary x:Key="Light">
                                                <StaticResource x:Key="SubtleButtonBackgroundPointerOver" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                                                <StaticResource x:Key="SubtleButtonBackgroundPressed" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="Dark">
                                                <StaticResource x:Key="SubtleButtonBackgroundPointerOver" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                                                <StaticResource x:Key="SubtleButtonBackgroundPressed" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                                            </ResourceDictionary>
                                        </ResourceDictionary.ThemeDictionaries>
                                    </ResourceDictionary>
                                </Button.Resources>
                                <FontIcon FontSize="10" Glyph="&#xE711;" />
                            </Button>
                        </Grid>

                        <ItemsControl x:Name="AttachmentList" AutomationProperties.AutomationId="Chat.Attachments">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="messaging:PendingAttachment">
                                    <Grid
                                        Height="64"
                                        MinWidth="64"
                                        AutomationProperties.AutomationId="{x:Bind local:ChatPane.ChipIdOf('Chat.Attachment.', Id)}"
                                        AutomationProperties.Name="{x:Bind Name}"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Image
                                            Width="64"
                                            Height="64"
                                            Source="{x:Bind local:ChatPane.ChipImage(Open, Thumbnail, IsPhoto)}"
                                            Stretch="UniformToFill"
                                            Visibility="{x:Bind ShowsPicture}" />
                                        <StackPanel
                                            Padding="12,0,36,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            Visibility="{x:Bind local:UiHelpers.Not(ShowsPicture)}">
                                            <FontIcon FontSize="20" Glyph="{x:Bind controls:MessageBubble.FileGlyph(Kind)}" />
                                            <TextBlock
                                                MaxWidth="160"
                                                VerticalAlignment="Center"
                                                MaxLines="1"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button
                                            AutomationProperties.AutomationId="{x:Bind local:ChatPane.ChipIdOf('Chat.RemoveAttachment.', Id)}"
                                            AutomationProperties.Name="{x:Bind local:ChatPane.RemoveAttachmentText}"
                                            Click="OnRemoveAttachmentClick"
                                            Style="{StaticResource ChipRemoveButtonStyle}"
                                            ToolTipService.ToolTip="{x:Bind local:ChatPane.RemoveAttachmentText}">

                                            <!-- The round fill stays on hover and press, though the icon style
                                                 clears it. A press shrinks the circle, and a release springs it
                                                 back. IconPress does this with the animation effects on. High
                                                 contrast keeps the colors of the system. -->
                                            <Button.Resources>
                                                <ResourceDictionary>
                                                    <ResourceDictionary.ThemeDictionaries>
                                                        <ResourceDictionary x:Key="Light">
                                                            <StaticResource x:Key="SubtleButtonBackgroundPointerOver" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                                                            <StaticResource x:Key="SubtleButtonBackgroundPressed" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                                                        </ResourceDictionary>
                                                        <ResourceDictionary x:Key="Dark">
                                                            <StaticResource x:Key="SubtleButtonBackgroundPointerOver" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                                                            <StaticResource x:Key="SubtleButtonBackgroundPressed" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                                                        </ResourceDictionary>
                                                    </ResourceDictionary.ThemeDictionaries>
                                                </ResourceDictionary>
                                            </Button.Resources>
                                            <FontIcon FontSize="10" Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- In the message box, Enter sends and Shift + Enter adds a line. The owner chose the icons inside the box on
             the right: emoji, the paperclip, the voice message waveform and Send. The right
             padding of 140 keeps the text clear of them. That is 4 buttons of 32 px, their 6 px inset and a gap.
             Under the reply chip or the attachment chips, the box meets them with square top corners. -->
        <Grid Grid.Row="4" Padding="{x:Bind local:ChatPane.ComposePadding(Chat.IsReplying, Chat.HasAttachments, Chat.Voice.IsPreview), Mode=OneWay}">
            <TextBox
                x:Name="DraftBox"
                MinHeight="44"
                MaxHeight="160"
                Padding="12,11,140,11"
                AcceptsReturn="True"
                AutomationProperties.AutomationId="Chat.Draft"
                AutomationProperties.Name="Message"
                CornerRadius="{x:Bind local:ChatPane.DraftCorners(Chat.IsReplying, Chat.HasAttachments, Chat.Voice.IsPreview), Mode=OneWay}"
                Paste="OnDraftPaste"
                PlaceholderText="{x:Bind Chat.DraftPlaceholder, Mode=OneWay, FallbackValue=''}"
                PreviewKeyDown="OnDraftKeyDown"
                Text="{x:Bind Chat.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                TextChanged="OnDraftTextChanged"
                TextWrapping="Wrap">

                <!-- The box keeps 1 fill at rest, on hover and with focus, so it never changes color. The owner chose
                     a solid fill, so the list that fades out behind the box never shows through. The dark input
                     fill of Windows is see-through, so the dark box takes the solid base instead. The light fill is
                     already solid white. The border and the bottom accent line keep their normal Fluent focus look.
                     High contrast keeps the TextBox colors of the system. -->
                <TextBox.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default">
                                <StaticResource x:Key="TextControlBackground" ResourceKey="SolidBackgroundFillColorBaseBrush" />
                                <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SolidBackgroundFillColorBaseBrush" />
                                <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SolidBackgroundFillColorBaseBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <StaticResource x:Key="TextControlBackground" ResourceKey="ControlFillColorInputActiveBrush" />
                                <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="ControlFillColorInputActiveBrush" />
                                <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="ControlFillColorInputActiveBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast">
                                <StaticResource x:Key="TextControlBackground" ResourceKey="SystemControlBackgroundAltMediumLowBrush" />
                                <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SystemControlBackgroundAltMediumBrush" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </TextBox.Resources>
            </TextBox>

            <!-- The compose buttons sit in 1 row inside the bottom right of the box, 6 px in from its edges. Each
                 button is 32 px, with no gaps. -->
            <StackPanel
                Margin="0,0,6,6"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Orientation="Horizontal">

                <!-- This button opens the emoji panel of Windows, as Ctrl + Shift + e does. -->
                <Button
                    Width="32"
                    Height="32"
                    AutomationProperties.AutomationId="Chat.Emoji"
                    AutomationProperties.Name="Emoji"
                    Click="OnEmojiClick"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Emoji">
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE76E;" />
                </Button>

                <!-- The paperclip opens the file picker for any files, as Ctrl + Shift + a does. Ctrl + Shift + p
                     opens it for photos. -->
                <Button
                    Width="32"
                    Height="32"
                    AutomationProperties.AutomationId="Chat.Attach"
                    AutomationProperties.Name="{x:Bind local:ChatPane.AttachText}"
                    Click="OnAttachClick"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind local:ChatPane.AttachText}">
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE723;" />
                </Button>

                <!-- This button records a voice message and always shows. Its icon is a waveform: 5 rounded bars on
                     the 16 px grid, with the 1.5 px stroke of Fluent. The owner chose no mic, which reads as speech
                     to text. Segoe Fluent Icons has no waveform glyph. -->
                <Button
                    Width="32"
                    Height="32"
                    AutomationProperties.AutomationId="Chat.Record"
                    AutomationProperties.Name="{x:Bind local:ChatPane.RecordText}"
                    Click="OnRecordClick"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind local:ChatPane.RecordText}">
                    <PathIcon
                        Width="16"
                        Height="16"
                        Data="M2,6 a.75,.75 0 0 1 .75,.75 V9.25 a.75,.75 0 0 1 -1.5,0 V6.75 a.75,.75 0 0 1 .75,-.75Z M5,3.5 a.75,.75 0 0 1 .75,.75 V11.75 a.75,.75 0 0 1 -1.5,0 V4.25 a.75,.75 0 0 1 .75,-.75Z M8,1.5 a.75,.75 0 0 1 .75,.75 V13.75 a.75,.75 0 0 1 -1.5,0 V2.25 a.75,.75 0 0 1 .75,-.75Z M11,3.5 a.75,.75 0 0 1 .75,.75 V11.75 a.75,.75 0 0 1 -1.5,0 V4.25 a.75,.75 0 0 1 .75,-.75Z M14,6 a.75,.75 0 0 1 .75,.75 V9.25 a.75,.75 0 0 1 -1.5,0 V6.75 a.75,.75 0 0 1 .75,-.75Z"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>

                <Button
                    Width="32"
                    Height="32"
                    AutomationProperties.AutomationId="Chat.Send"
                    AutomationProperties.Name="Send"
                    Click="OnSendClick"
                    IsEnabled="{x:Bind Chat.CanSend, Mode=OneWay, FallbackValue=False}"
                    Style="{StaticResource IconButtonStyle}">
                    <!-- The icon keeps its own accent color, so the disabled color of the button cannot reach it. Thus
                         the opacity dims it while the button is disabled. -->
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE724;"
                        Opacity="{x:Bind local:ChatPane.EnabledOpacity(Chat.CanSend), Mode=OneWay, FallbackValue=0.4}" />
                </Button>
            </StackPanel>

            <!-- While the mic records, the recording bar covers the message box. It shows a red dot, the running
                 time and the live waveform of the input level. Then come Cancel recording, Pause or Resume, and Done.
                 Cancel recording deletes the recording. The code sets the glyph and name of Pause or Resume. Done is
                 a check mark and keeps the recording for the preview chip. The bar sits on a solid base, because the
                 fill of the box lets the content under it show. -->
            <Border
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                CornerRadius="{x:Bind local:ChatPane.DraftCorners(Chat.IsReplying, Chat.HasAttachments, Chat.Voice.IsPreview), Mode=OneWay}"
                Visibility="{x:Bind Chat.Voice.IsCapturing, Mode=OneWay, FallbackValue=Collapsed}">
                <!-- The buttons sit as the buttons of the message box do: 32 px each, side by side with no gap. They
                     sit 6 px in from the right edge of the box: 5 px padding inside the 1 px border. The
                     waveform fills the space between the timer and Cancel recording. -->
                <Grid
                    Padding="12,0,5,0"
                    Background="{ThemeResource ControlFillColorInputActiveBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ColumnSpacing="8"
                    CornerRadius="{x:Bind local:ChatPane.DraftCorners(Chat.IsReplying, Chat.HasAttachments, Chat.Voice.IsPreview), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                    <!-- The timer uses tabular digits and is at least as wide as a hidden 00:00. Thus the count never
                         moves the waveform or the buttons. The timer is tight to the ink of the digits, with no room
                         for descenders. Thus the digits center on the dot and the waveform. -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            AutomationProperties.AccessibilityView="Raw"
                            Opacity="0"
                            Text="00:00"
                            TextLineBounds="Tight"
                            Typography.NumeralAlignment="Tabular" />
                        <TextBlock
                            x:Name="RecordTimer"
                            AutomationProperties.AutomationId="Chat.RecordTimer"
                            TextLineBounds="Tight"
                            Typography.NumeralAlignment="Tabular" />
                    </Grid>
                    <controls:Waveform
                        x:Name="RecordBars"
                        Grid.Column="2"
                        AutomationProperties.AutomationId="Chat.RecordWave"
                        VerticalAlignment="Center"
                        BarBrush="{ThemeResource TextFillColorSecondaryBrush}" />
                    <!-- The recording buttons sit side by side as the buttons of the message box do. They have no
                         column spacing between them. -->
                    <StackPanel
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Width="32"
                            Height="32"
                            AutomationProperties.AutomationId="Chat.CancelRecording"
                            AutomationProperties.Name="{x:Bind local:ChatPane.CancelRecordingText}"
                            Click="OnCancelRecordingClick"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind local:ChatPane.CancelRecordingText}">
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE74D;" />
                        </Button>
                        <Button
                            x:Name="PauseRecordingButton"
                            Width="32"
                            Height="32"
                            AutomationProperties.AutomationId="Chat.RecordPause"
                            Click="OnPauseRecordingClick"
                            Style="{StaticResource IconButtonStyle}">
                            <FontIcon
                                x:Name="PauseRecordingGlyph"
                                FontSize="16"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                        <Button
                            x:Name="StopRecordingButton"
                            Width="32"
                            Height="32"
                            AutomationProperties.AutomationId="Chat.StopRecording"
                            AutomationProperties.Name="{x:Bind local:ChatPane.DoneText}"
                            Click="OnStopRecordingClick"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind local:ChatPane.DoneText}">
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE73E;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
