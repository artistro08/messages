<UserControl
    x:Class="GMessages.App.Views.StartChatPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GMessages.App.Views.Controls"
    xmlns:local="using:GMessages.App.Views"
    xmlns:main="using:GMessages.Presentation.Main">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Search: back (narrow only), the name or number box, and Go -->
        <Grid
            Padding="12,8,16,8"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="8">
            <Button
                Width="40"
                Height="36"
                Padding="0"
                AutomationProperties.AutomationId="StartChat.Back"
                AutomationProperties.Name="Back"
                Background="Transparent"
                BorderThickness="0"
                Click="OnBackClick"
                Visibility="{x:Bind ShowBack, Mode=OneWay}">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>
            <TextBox
                x:Name="QueryBox"
                Grid.Column="1"
                AutomationProperties.AutomationId="StartChat.Query"
                Text="{x:Bind StartChat.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />
            <Button
                Grid.Column="2"
                Width="40"
                Height="32"
                Padding="0"
                AutomationProperties.AutomationId="StartChat.Go"
                AutomationProperties.Name="Start"
                Click="OnGoClick"
                IsEnabled="{x:Bind StartChat.CanStart, Mode=OneWay, FallbackValue=False}"
                Style="{StaticResource AccentButtonStyle}">
                <FontIcon FontSize="16" Glyph="&#xE72A;" />
            </Button>
        </Grid>

        <!-- Start Failed (R11): shown until the next Go -->
        <TextBlock
            Grid.Row="1"
            Margin="16,8,16,0"
            AutomationProperties.AutomationId="StartChat.Error"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind StartChat.Error, Mode=OneWay, FallbackValue='', TargetNullValue=''}"
            TextWrapping="Wrap"
            Visibility="{x:Bind StartChat.HasError, Mode=OneWay, FallbackValue=Collapsed}" />

        <!-- Picked: one chip per person; clicking a chip removes it -->
        <GridView
            x:Name="PickedList"
            Grid.Row="2"
            Margin="12,8,12,0"
            AutomationProperties.AutomationId="StartChat.Picked"
            ContainerContentChanging="OnContainerContentChanging"
            IsItemClickEnabled="True"
            ItemClick="OnContactClick"
            SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="main:ContactRowViewModel">
                    <StackPanel
                        Padding="4,2,8,2"
                        Orientation="Horizontal"
                        Spacing="6">
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                        <FontIcon FontSize="10" Glyph="&#xE711;" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Contacts: a "Send to" row for a typed number first, then top contacts, then everyone else -->
        <ListView
            x:Name="ContactList"
            Grid.Row="3"
            AutomationProperties.AutomationId="StartChat.Contacts"
            ContainerContentChanging="OnContainerContentChanging"
            IsItemClickEnabled="True"
            ItemClick="OnContactClick"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="main:ContactRowViewModel">
                    <Grid
                        Padding="0,8"
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="12">
                        <controls:Avatar
                            VerticalAlignment="Center"
                            Color="{x:Bind AvatarColor}"
                            Initial="{x:Bind Initial}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                MaxLines="1"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                Text="{x:Bind Subtitle}"
                                Visibility="{x:Bind local:MainWindow.ShownIfText(Subtitle)}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
