<UserControl
    x:Class="GMessages.App.Views.StartChatPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GMessages.App.Views.Controls"
    xmlns:local="using:GMessages.App.Views"
    xmlns:main="using:GMessages.Presentation.Main">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Search: the name or number box and Go (a narrow window's back is the title bar's) -->
        <Grid
            Padding="12,8,16,8"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="8">
            <TextBox
                x:Name="QueryBox"
                AutomationProperties.AutomationId="StartChat.Query"
                Text="{x:Bind StartChat.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />
            <!-- Go: "Start Chat" with an arrow after it -->
            <Button
                Grid.Column="1"
                Height="32"
                AutomationProperties.AutomationId="StartChat.Go"
                AutomationProperties.Name="{x:Bind local:StartChatPane.GoText}"
                Click="OnGoClick"
                IsEnabled="{x:Bind StartChat.CanStart, Mode=OneWay, FallbackValue=False}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind local:StartChatPane.GoText}" />
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="14"
                        Glyph="&#xE72A;" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Start Failed (R11): shown until the next Go -->
        <TextBlock
            Grid.Row="1"
            Margin="16,8,16,0"
            AutomationProperties.AutomationId="StartChat.Error"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind StartChat.Error, Mode=OneWay, FallbackValue='', TargetNullValue=''}"
            TextWrapping="Wrap"
            Visibility="{x:Bind StartChat.HasError, Mode=OneWay, FallbackValue=Collapsed}" />

        <!-- Picked: one chip per person in a row under the box (scrolling sideways when they don't fit), each a rounded
             pill on the control fill with its stroke, so it stands apart from the pane: the avatar, the name, then a ×. A click, Enter
             or Space on a chip removes it, and the person goes back to the list below. Each chip keeps its own width (a
             grid would size them all like the first) -->
        <ListView
            x:Name="PickedList"
            Grid.Row="2"
            Margin="12,8,12,0"
            Padding="0,0,0,4"
            AutomationProperties.AutomationId="StartChat.Picked"
            ContainerContentChanging="OnContainerContentChanging"
            IsItemClickEnabled="True"
            ItemClick="OnContactClick"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollMode="Enabled"
            ScrollViewer.VerticalScrollMode="Disabled"
            SelectionMode="None"
            Visibility="{x:Bind StartChat.CanStart, Mode=OneWay, FallbackValue=Collapsed}">
            <ListView.Resources>
                <!-- The Chip Is The Look: The Row Itself Gets No Hover Or Press Fill Around It -->
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
            </ListView.Resources>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Margin" Value="0,0,8,0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="CornerRadius" Value="16" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="main:ContactRowViewModel">
                    <Border
                        Height="32"
                        Padding="3,0,8,0"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- Avatar: the person's letter circle, shrunk to fit inside the chip's height -->
                            <Viewbox
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center">
                                <controls:Avatar Color="{x:Bind AvatarColor}" Initial="{x:Bind Initial}" />
                            </Viewbox>
                            <TextBlock
                                MaxWidth="200"
                                VerticalAlignment="Center"
                                MaxLines="1"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE711;" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Contacts: a "Send to" row for a typed number first, then top contacts, then everyone else. A picked row fades
             out and the rows below slide up (the list's own transitions; the rows change in place). The list slides down,
             not jumps, when the chip row first shows above it -->
        <ListView
            x:Name="ContactList"
            Grid.Row="3"
            AutomationProperties.AutomationId="StartChat.Contacts"
            ContainerContentChanging="OnContainerContentChanging"
            IsItemClickEnabled="True"
            ItemClick="OnContactClick"
            SelectionMode="None">
            <ListView.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </ListView.Transitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="main:ContactRowViewModel">
                    <Grid
                        Padding="0,8"
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="12">
                        <controls:Avatar
                            VerticalAlignment="Center"
                            Color="{x:Bind AvatarColor}"
                            Initial="{x:Bind Initial}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                MaxLines="1"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                Text="{x:Bind Subtitle}"
                                Visibility="{x:Bind local:MainWindow.ShownIfText(Subtitle)}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Loading: while the contacts load, and while Go looks up the conversation -->
        <ProgressRing
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="StartChat.Loading"
            IsActive="{x:Bind StartChat.IsLoading, Mode=OneWay, FallbackValue=False}" />
    </Grid>
</UserControl>
