<!-- Shortcut Help: the wired shortcuts, keys left and action right, like Google's dialog -->
<ContentDialog
    x:Class="GMessages.App.Views.ShortcutHelpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Keyboard shortcuts"
    AutomationProperties.AutomationId="Shortcuts.Dialog"
    CloseButtonText="Close"
    DefaultButton="Close">

    <!-- Rows: filled from ShortcutMap.HelpRows in code -->
    <ScrollViewer>
        <Grid
            x:Name="RowsGrid"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="32"
            RowSpacing="12" />
    </ScrollViewer>
</ContentDialog>
