<UserControl
    x:Class="GMessages.App.Views.PairingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Signed-Out Reason: only above the sign-in -->
        <InfoBar
            Margin="16,16,16,0"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.ShowSignedOutReason, Mode=OneWay}"
            Message="{x:Bind ViewModel.SignedOutReason}"
            Severity="Warning" />

        <!-- Sign-In: the WebView2 is added in code, fresh for each attempt -->
        <Border
            x:Name="SignInHost"
            Grid.Row="1"
            Margin="0,8,0,0"
            Visibility="{x:Bind ViewModel.IsSigningIn, Mode=OneWay}" />

        <!-- Waiting For Phone -->
        <StackPanel
            Grid.Row="1"
            MaxWidth="440"
            Padding="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.IsWaitingForPhone, Mode=OneWay}">
            <ProgressRing
                Width="48"
                Height="48"
                AutomationProperties.AutomationId="Pairing.Waiting"
                IsActive="{x:Bind ViewModel.IsWaitingForPhone, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="Pairing.WaitingText"
                Text="Check your phone. If nothing shows up, open Google Messages on your phone."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
        <!-- /Waiting For Phone -->

        <!-- Emoji -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.IsShowingEmoji, Mode=OneWay}">
            <!-- The Emoji As The Website Draws It: Noto Color Emoji's image, bundled (set from code); the system emoji font
                 only if the image is missing -->
            <Grid HorizontalAlignment="Center">
                <Image
                    x:Name="EmojiImage"
                    Width="96"
                    Height="96"
                    AutomationProperties.AutomationId="Pairing.Emoji"
                    AutomationProperties.Name="{x:Bind ViewModel.Emoji, Mode=OneWay}"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="EmojiText"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="Pairing.EmojiText"
                    FontSize="96"
                    Text="{x:Bind ViewModel.Emoji, Mode=OneWay}" />
            </Grid>
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Tap this emoji on your phone" />
        </StackPanel>
        <!-- /Emoji -->

        <!-- Failure -->
        <StackPanel
            Grid.Row="1"
            MaxWidth="440"
            Padding="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.IsFailed, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="Pairing.Message"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="Pairing.TryAgain"
                Click="OnTryAgainClick"
                Content="Try again"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
        <!-- /Failure -->

        <!-- Footer -->
        <Button
            Grid.Row="2"
            Margin="16"
            HorizontalAlignment="Right"
            AutomationProperties.AutomationId="Pairing.Cancel"
            Click="OnCancelClick"
            Content="Cancel" />
    </Grid>
</UserControl>
