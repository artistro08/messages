<UserControl
    x:Class="GMessages.App.Views.ChatsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GMessages.App.Views.Controls"
    xmlns:local="using:GMessages.App.Views"
    xmlns:main="using:GMessages.Presentation.Main"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!-- The list is the pane of the SplitView, so ☰ slides it in and out as Windows does. The chat is its content.
         A narrow window widens the pane to the whole window and closes it while the chat shows. The code sets the
         width. -->
    <SplitView
        x:Name="Panes"
        CompactPaneLength="0"
        DisplayMode="Inline"
        IsPaneOpen="{x:Bind local:ChatsView.IsListOpen(ViewModel.IsListCollapsed, ViewModel.ShowChatPane), Mode=OneWay}"
        OpenPaneLength="360"
        PaneBackground="Transparent"
        SizeChanged="OnSizeChanged">

        <!-- The list pane sits on the Mica, held at the width of the pane. The SplitView first measures its pane at
             the width of the chat, then at its own width. Without the hold, every row laid out twice per resize step
             of the window. -->
        <SplitView.Pane>
            <Grid x:Name="ListPane" Width="{x:Bind Panes.OpenPaneLength, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The folder header shows Archived or Spam & blocked. The Back of the title bar returns to the
                     inbox. -->
                <TextBlock
                    Margin="16,8,12,8"
                    AutomationProperties.AutomationId="Main.ListTitle"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind local:ChatsView.FolderTitle(ViewModel.IsArchivedView), Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsFolderView, Mode=OneWay, FallbackValue=Collapsed}" />

                <!-- The connection banner hides while the app is connected. -->
                <TextBlock
                    Grid.Row="1"
                    Margin="16,0,16,8"
                    AutomationProperties.AutomationId="Main.Status"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatusBanner, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasStatusBanner, Mode=OneWay}" />

                <!-- The failure banner shows a conversation action that the phone did not make. A close dismisses
                     it. The banner collapses while closed, because a closed InfoBar still keeps its margin. That
                     margin pushed the list below the top edge of the chat island. -->
                <muxc:InfoBar
                    Grid.Row="2"
                    Margin="16,0,16,8"
                    AutomationProperties.AutomationId="Main.ActionError"
                    CloseButtonClick="OnActionErrorClosed"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasActionError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ActionError, Mode=OneWay, FallbackValue=''}"
                    Severity="Error"
                    Visibility="{x:Bind ViewModel.HasActionError, Mode=OneWay, FallbackValue=Collapsed}" />

                <!-- The battery banner shows only after a live low battery alert. A close hides it until the next
                     alert. It collapses while closed, as the banner above does. -->
                <muxc:InfoBar
                    Grid.Row="3"
                    Margin="16,0,16,8"
                    AutomationProperties.AutomationId="Main.BatteryLow"
                    Closed="OnBatteryLowClosed"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.IsPhoneBatteryLow, Mode=OneWay}"
                    Severity="Warning"
                    Title="{x:Bind local:ChatsView.BatteryTitle}"
                    Visibility="{x:Bind ViewModel.IsPhoneBatteryLow, Mode=OneWay, FallbackValue=Collapsed}" />

                <!-- The list keeps room at the bottom. Thus Start chat and the Undo bar above it never cover the last
                     row. See ListPadding. The list has no lane on the right. The scrollbar floats over the right
                     padding of the rows. The owner chose equal gaps from the rows to the chat island and to the left
                     edge of the window. -->
                <ListView
                    x:Name="ConversationList"
                    Grid.Row="4"
                    Padding="{x:Bind local:ChatsView.ListPadding(ViewModel.HasUndo, ViewModel.CurrentList.HasMorePages), Mode=OneWay}"
                    AutomationProperties.AutomationId="Main.ConversationList"
                    ContainerContentChanging="OnContainerContentChanging"
                    ContextRequested="OnConversationListContextRequested"
                    Loaded="OnConversationListLoaded"
                    SelectionChanged="OnSelectionChanged"
                    SelectionMode="Single"
                    SizeChanged="OnConversationListSizeChanged">
                    <!-- A click on a row opens the chat without taking the focus. Thus the message box keeps the
                         focus and never shows its unfocused look between chats. The owner saw that look as a flash.
                         Tab and the arrow keys still reach the rows. -->

                    <!-- The list has no item transitions, so loads, pages and folder switches never animate. The code
                         turns on the add, remove and reorder motion of Windows only for a live change. A new message
                         that lifts a row is a live change. See OnRowsChanging. -->
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>

                    <!-- A row or tile with keyboard focus shows a fill, not the focus ring of Windows. The owner
                         found the ring ugly. The row and the tile draw the fill themselves. See ShowFocusFill. High
                         contrast keeps the ring of Windows and has no fill. The tiles of the grid in the header use
                         these values too. -->
                    <ListView.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Default">
                                    <SolidColorBrush x:Key="TileFocusFillBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
                                    <Thickness x:Key="ItemFocusOuterThickness">0</Thickness>
                                    <Thickness x:Key="ItemFocusInnerThickness">0</Thickness>
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="HighContrast">
                                    <SolidColorBrush x:Key="TileFocusFillBrush" Color="Transparent" />
                                    <Thickness x:Key="ItemFocusOuterThickness">2</Thickness>
                                    <Thickness x:Key="ItemFocusInnerThickness">1</Thickness>
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </ListView.Resources>

                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                            <Setter Property="AllowFocusOnInteraction" Value="False" />
                            <!-- Every row spans the list, so the time of each row ends at the same right edge. -->
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualPrimaryThickness" Value="{ThemeResource ItemFocusOuterThickness}" />
                            <Setter Property="FocusVisualSecondaryThickness" Value="{ThemeResource ItemFocusInnerThickness}" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="main:ConversationRowViewModel">
                            <controls:ConversationRow
                                x:Name="RowView"
                                MoreRequested="OnRowMoreRequested"
                                Row="{x:Bind}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <!-- With "Show pinned chats as a grid" on in Settings, the pinned chats of the inbox sit above the
                         rows. They show as large pictures with their names, as in iMessage, and scroll with the list.
                         The code collapses the grid while there are none. The grid has no scroller of its own, because
                         a nested scroller kept the scrollbar of the list on screen. The grid is as tall as its tiles,
                         and the list scrolls it. Its sides, with the 3 px margins of the tiles, align with the rows.
                         The code splits its width into even columns, 3 or more. The arrow keys move the focus between
                         the tiles but open nothing. Enter opens the focused tile. -->
                    <ListView.Header>
                        <GridView
                            x:Name="PinnedGrid"
                            Margin="1,0,1,5"
                            AutomationProperties.AutomationId="Main.PinnedGrid"
                            ContextRequested="OnPinnedGridContextRequested"
                            SelectionChanged="OnPinnedSelectionChanged"
                            SelectionMode="Single"
                            SingleSelectionFollowsFocus="False"
                            SizeChanged="OnPinnedGridSizeChanged"
                            Visibility="Collapsed">
                            <GridView.Template>
                                <ControlTemplate TargetType="GridView">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </GridView.Template>

                            <!-- A selected tile has no accent outline, the tile look of Windows. It takes the
                                 selected fills of the rows instead, by color, so they follow a theme switch. The pill
                                 at the bottom of the tile is SelectionPill below. Default serves Light and Dark. The
                                 empty HighContrast falls through to the outline and colors of Windows. -->
                            <GridView.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="GridViewItemSelectedPointerOverBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="GridViewItemSelectedPressedBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="GridViewItemSelectedInnerBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="{ThemeResource SubtleFillColorSecondary}" />
                                            <!-- The owner chose no hover fill on the tiles. The card or the picture
                                                 shows the hover instead. See ShowTileHover. -->
                                            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="GridViewItemRevealBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="GridViewItemRevealBackgroundSelectedPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                                            <SolidColorBrush x:Key="GridViewItemRevealBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="GridViewItemPointerOverBorderBrush" Color="Transparent" />
                                            <!-- The name keeps its color on hover, press and select. -->
                                            <SolidColorBrush x:Key="GridViewItemForegroundPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                                            <SolidColorBrush x:Key="GridViewItemForegroundPressed" Color="{ThemeResource TextFillColorPrimary}" />
                                            <SolidColorBrush x:Key="GridViewItemForegroundSelected" Color="{ThemeResource TextFillColorPrimary}" />
                                            <SolidColorBrush x:Key="GridViewItemForegroundSelectedPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                                            <SolidColorBrush x:Key="GridViewItemForegroundSelectedPressed" Color="{ThemeResource TextFillColorPrimary}" />
                                            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                                            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="{ThemeResource SubtleFillColorSecondary}" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="HighContrast" />
                                    </ResourceDictionary.ThemeDictionaries>

                                    <!-- The accent pill of the tiles: the unread badge and the count of the card. -->
                                    <Style x:Key="PinnedPillStyle" TargetType="Border">
                                        <Setter Property="MinWidth" Value="20" />
                                        <Setter Property="Height" Value="20" />
                                        <Setter Property="Padding" Value="6,0" />
                                        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="BorderBrush" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="CornerRadius" Value="10" />
                                    </Style>
                                    <Style
                                        x:Key="PinnedPillTextStyle"
                                        BasedOn="{StaticResource CaptionTextBlockStyle}"
                                        TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter Property="MaxLines" Value="1" />
                                    </Style>
                                </ResourceDictionary>
                            </GridView.Resources>

                            <!-- The tiles have no transitions. They land in place, as the rows do on a load. -->
                            <GridView.ItemContainerTransitions>
                                <TransitionCollection />
                            </GridView.ItemContainerTransitions>

                            <!-- The tiles fill even columns from the left edge. The code sets ItemWidth. -->
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>

                            <GridView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                                    <Setter Property="AllowFocusOnInteraction" Value="False" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <!-- The owner chose a 6 px gap between tiles, so their hover and selected fills
                                         do not touch. -->
                                    <Setter Property="Margin" Value="3" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="FocusVisualPrimaryThickness" Value="{ThemeResource ItemFocusOuterThickness}" />
                                    <Setter Property="FocusVisualSecondaryThickness" Value="{ThemeResource ItemFocusInnerThickness}" />
                                </Style>
                            </GridView.ItemContainerStyle>

                            <!-- A tile shows the picture with the unread badge, the name below and the selection pill
                                 at the bottom. The picture draws at 52 px. The name is bold while unread. With cards
                                 on, an unread tile shows the square message card in place of the picture, as Google
                                 Messages does. Every picture then fills the same square, so the tiles stay even. The
                                 photo decodes at 128 px for the large picture. See TileArt, TilePhoto and
                                 OnPinnedArtSizeChanged. -->
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="main:ConversationRowViewModel">
                                    <!-- A tile always has a tooltip, because it shows no snippet and trims its
                                         name. -->
                                    <Grid
                                        PointerCanceled="OnPinnedTilePointerExited"
                                        PointerCaptureLost="OnPinnedTilePointerExited"
                                        PointerEntered="OnPinnedTilePointerEntered"
                                        PointerExited="OnPinnedTilePointerExited"
                                        ToolTipService.ToolTip="{x:Bind HoverText, Mode=OneWay}">
                                        <!-- The fill of a tile with keyboard focus. See ShowFocusFill. -->
                                        <Border
                                            x:Name="FocusFill"
                                            Background="{ThemeResource TileFocusFillBrush}"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            IsHitTestVisible="False"
                                            Opacity="0" />

                                        <!-- The 10 px at the bottom keeps the name clear of the selection pill. -->
                                        <Grid Padding="4,4,4,10" RowSpacing="4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- The art area holds the picture or the card. With cards on, the code
                                                 makes it square. See OnPinnedArtSizeChanged. A new message pops the
                                                 card. See OnCardMessageArrived. -->
                                            <Grid x:Name="PinnedArt" SizeChanged="OnPinnedArtSizeChanged">
                                                <Grid
                                                    Margin="{x:Bind local:ChatsView.PictureMargin(CardsOn), Mode=OneWay}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind local:UiHelpers.Not(ShowsCard), Mode=OneWay}">
                                                    <Viewbox
                                                        Width="{x:Bind local:ChatsView.TileArt(CardsOn), Mode=OneWay}"
                                                        Height="{x:Bind local:ChatsView.TileArt(CardsOn), Mode=OneWay}">
                                                        <Grid>
                                                            <controls:Avatar
                                                                PhotoSize="{x:Bind local:ChatsView.TilePhoto(CardsOn), Mode=OneWay}"
                                                                Color="{x:Bind AvatarColor, Mode=OneWay}"
                                                                Initial="{x:Bind Initial, Mode=OneWay}"
                                                                PhotoId="{x:Bind PhotoId, Mode=OneWay}"
                                                                SecondColor="{x:Bind SecondColor, Mode=OneWay}"
                                                                SecondInitial="{x:Bind SecondInitial, Mode=OneWay}"
                                                                SecondPhotoId="{x:Bind SecondPhotoId, Mode=OneWay}" />

                                                            <!-- The shine is a white light from the top left. It
                                                                 fades in over 50 ms while the pointer is on the tile,
                                                                 as the owner chose. -->
                                                            <Ellipse
                                                                x:Name="PictureShine"
                                                                IsHitTestVisible="False"
                                                                Opacity="0">
                                                                <Ellipse.Fill>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Offset="0" Color="#59FFFFFF" />
                                                                        <GradientStop Offset="0.55" Color="#14FFFFFF" />
                                                                        <GradientStop Offset="1" Color="#00FFFFFF" />
                                                                    </LinearGradientBrush>
                                                                </Ellipse.Fill>
                                                                <Ellipse.OpacityTransition>
                                                                    <ScalarTransition Duration="0:0:0.05" />
                                                                </Ellipse.OpacityTransition>
                                                            </Ellipse>
                                                        </Grid>
                                                    </Viewbox>

                                                    <!-- The unread badge is the system accent pill at the top right
                                                         of the picture. It shows the short newest message or the
                                                         unread count. See ChatFormat.UnreadBadge. It hangs past the
                                                         edge of the picture and grows to the left for 1 or 2 words. -->
                                                    <Border
                                                        MaxWidth="88"
                                                        Margin="0,-4,-8,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Style="{StaticResource PinnedPillStyle}"
                                                        Visibility="{x:Bind local:UiHelpers.ShownIfText(UnreadBadge), Mode=OneWay}">
                                                        <TextBlock
                                                            AutomationProperties.AutomationId="{x:Bind controls:ConversationRow.PartId('Pinned.Badge.', Id), Mode=OneWay}"
                                                            Style="{StaticResource PinnedPillTextStyle}"
                                                            Text="{x:Bind UnreadBadge, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </Grid>

                                                <!-- The message card: a small picture and the time at the top, the
                                                     newest message in bold below, and the unread count at the bottom
                                                     right. The card has the fill and stroke of a Windows card, and
                                                     CardHover lightens it while the pointer is on the tile. The count
                                                     is the accent pill of the tiles. It hangs 4 px past the corner of
                                                     the card, into the margin, so the tile does not cut it. -->
                                                <Grid x:Name="PinnedCard" Visibility="{x:Bind ShowsCard, Mode=OneWay}">
                                                    <Border
                                                        Margin="4,0,4,4"
                                                        Padding="10,8"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="16">
                                                        <Grid RowSpacing="2">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <Viewbox
                                                                Width="20"
                                                                Height="20"
                                                                HorizontalAlignment="Left">
                                                                <!-- The size of the large picture, so both pictures share
                                                                     1 decoded photo. -->
                                                                <controls:Avatar
                                                                    PhotoSize="128"
                                                                    Color="{x:Bind AvatarColor, Mode=OneWay}"
                                                                    Initial="{x:Bind Initial, Mode=OneWay}"
                                                                    PhotoId="{x:Bind PhotoId, Mode=OneWay}"
                                                                    SecondColor="{x:Bind SecondColor, Mode=OneWay}"
                                                                    SecondInitial="{x:Bind SecondInitial, Mode=OneWay}"
                                                                    SecondPhotoId="{x:Bind SecondPhotoId, Mode=OneWay}" />
                                                            </Viewbox>
                                                            <TextBlock
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                MaxLines="1"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Text="{x:Bind CardTime, Mode=OneWay}" />
                                                            <TextBlock
                                                                Grid.Row="1"
                                                                AutomationProperties.AutomationId="{x:Bind controls:ConversationRow.PartId('Pinned.Card.', Id), Mode=OneWay}"
                                                                FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                                                                MaxLines="4"
                                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                Text="{x:Bind CardText, Mode=OneWay}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Border>
                                                    <Border
                                                        x:Name="CardHover"
                                                        Margin="4,0,4,4"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="16"
                                                        IsHitTestVisible="False"
                                                        Opacity="0">
                                                        <Border.OpacityTransition>
                                                            <ScalarTransition Duration="0:0:0.05" />
                                                        </Border.OpacityTransition>
                                                    </Border>
                                                    <Border
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Style="{StaticResource PinnedPillStyle}">
                                                        <TextBlock
                                                            AutomationProperties.AutomationId="{x:Bind controls:ConversationRow.PartId('Pinned.Count.', Id), Mode=OneWay}"
                                                            Style="{StaticResource PinnedPillTextStyle}"
                                                            Text="{x:Bind UnreadCount, Mode=OneWay}" />
                                                    </Border>
                                                </Grid>
                                            </Grid>

                                            <TextBlock
                                                Grid.Row="1"
                                                HorizontalAlignment="Center"
                                                FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                                                FontWeight="{x:Bind controls:ColorConverters.Weight(IsUnread), Mode=OneWay}"
                                                MaxLines="1"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Name, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>

                                        <!-- The selection pill is the accent pill of the rows, laid flat at the bottom
                                             of the tile. Its scale is 0 until the user picks the tile. The code then
                                             grows it in from its middle, as Windows grows the pill of a row. See
                                             ShowPinnedPills. The code sets its scale and middle as it loads. The XAML
                                             of Windows ignores them in markup, and every tile showed its pill. -->
                                        <Border
                                            x:Name="SelectionPill"
                                            Width="16"
                                            Height="3"
                                            Margin="0,0,0,2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            AutomationProperties.AccessibilityView="Raw"
                                            Background="{ThemeResource ListViewItemSelectionIndicatorBrush}"
                                            CornerRadius="1.5"
                                            IsHitTestVisible="False"
                                            Loaded="OnSelectionPillLoaded" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </ListView.Header>

                    <!-- While older pages are left, placeholder rows end the list. The user sees them only at the
                         bottom, and the scroll to the bottom loads the next page. -->
                    <ListView.Footer>
                        <controls:ListLoadingRows
                            AutomationProperties.AutomationId="Main.ListLoadingMore"
                            Visibility="{x:Bind ViewModel.CurrentList.HasMorePages, Mode=OneWay, FallbackValue=Collapsed}" />
                    </ListView.Footer>
                </ListView>

                <!-- This ring shows while an empty list loads: the inbox, Archived or Spam & blocked. It has the
                     standard 32 px for a whole 4 px stroke. The size is explicit, so a style change cannot make the
                     stroke fractional. -->
                <muxc:ProgressRing
                    Grid.Row="4"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Main.ListLoading"
                    IsActive="{x:Bind ViewModel.CurrentList.IsLoadingFirstPage, Mode=OneWay}" />

                <!-- The bottom row floats over the rows. The Undo bar spans the width of the list, and Start chat
                     sits below it at the right. The row has no background, so clicks around them still reach the
                     rows. A stack leaves no gap under Undo when Start chat hides in a folder. The row sits 22 px up
                     from the bottom: the 8 px island gap plus the message box inset. The owner
                     measured that the bottom of Start chat then aligns with the bottom of the message box. -->
                <StackPanel
                    Grid.Row="4"
                    Margin="16,0,16,22"
                    VerticalAlignment="Bottom"
                    Spacing="8">

                    <!-- The owner chose that the Undo bar shows only after an archive. It shows for a few seconds,
                         and the view model hides it. The owner chose that it is as wide as the list, above Start
                         chat. Undo puts the conversation back, and the X hides the bar. The bar is solid and lifted
                         as Start chat is, with room above and below its text. A narrow list cuts the notice short
                         with "…". The bar never takes the focus, but Tab reaches it. Narrator announces the notice.
                         See AnnounceUndo. When a scroll slides Start chat away, the code slides Undo down into its
                         place. -->
                    <Grid
                        x:Name="UndoBar"
                        Padding="12,8,8,8"
                        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Translation="0,0,16"
                        Visibility="{x:Bind ViewModel.HasUndo, Mode=OneWay, FallbackValue=Collapsed}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.Shadow>
                            <ThemeShadow />
                        </Grid.Shadow>
                        <Grid.TranslationTransition>
                            <Vector3Transition />
                        </Grid.TranslationTransition>
                        <TextBlock
                            x:Name="UndoNoticeText"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Main.Undo"
                            AutomationProperties.LiveSetting="Polite"
                            Text="{x:Bind ViewModel.UndoNotice, Mode=OneWay, FallbackValue=''}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind ViewModel.UndoNotice, Mode=OneWay, FallbackValue=''}" />
                        <Button
                            x:Name="UndoButton"
                            Grid.Column="1"
                            MinHeight="24"
                            Margin="8,0,0,0"
                            Padding="8,1,8,2"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Main.Undo.Button"
                            Click="OnUndoClick"
                            Content="{x:Bind local:ChatsView.UndoText}"
                            GettingFocus="OnUndoGettingFocus" />

                        <!-- The close button is a bare X next to Undo. -->
                        <Button
                            Grid.Column="2"
                            Width="24"
                            Height="24"
                            Margin="2,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Main.Undo.Close"
                            AutomationProperties.Name="{x:Bind local:ChatsView.CloseText}"
                            Click="OnUndoClosed"
                            GettingFocus="OnUndoGettingFocus"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind local:ChatsView.CloseText}">
                            <FontIcon FontSize="10" Glyph="&#xE8BB;" />
                        </Button>
                    </Grid>

                    <!-- Start chat floats at the bottom right over the inbox, with the size of the standard accent
                         button. A scroll down slides it away, and a scroll up brings it back. The code sets this on
                         the backing, and its transitions animate it. The backing is solid, because the hover, pressed
                         and disabled accent fills of Windows are see-through. The rows showed through the button. -->
                    <Grid
                        x:Name="StartChatHost"
                        HorizontalAlignment="Right"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Translation="0,0,16"
                        Visibility="{x:Bind local:MainWindow.HiddenIf(ViewModel.IsFolderView), Mode=OneWay}">
                        <Grid.Shadow>
                            <ThemeShadow />
                        </Grid.Shadow>
                        <Grid.OpacityTransition>
                            <ScalarTransition />
                        </Grid.OpacityTransition>
                        <Grid.TranslationTransition>
                            <Vector3Transition />
                        </Grid.TranslationTransition>
                        <Button
                            x:Name="StartChatButton"
                            AutomationProperties.AutomationId="Main.StartChat"
                            Click="OnStartChatClick"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE8BD;" />
                                <TextBlock x:Name="StartChatText" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </SplitView.Pane>

        <!-- The chat pane holds the island, with the resize edge of the list in the gap to its left. The gap is there
             with the list open, collapsed by ☰ or in a narrow window. Thus the island always sits clear of the window
             edges. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Bind local:ChatsView.GapWidth(ViewModel.IsNarrow, ViewModel.IsListCollapsed), Mode=OneWay}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- A drag or the arrow keys on the resize edge resize the list. The edge shows only in a wide window
                 with the list open. -->
            <controls:PaneSplitter
                x:Name="ListSplitter"
                AutomationProperties.AutomationId="Main.ListSplitter"
                Resized="OnListResized"
                ResizeCompleted="OnListResizeCompleted"
                Visibility="{x:Bind local:ChatsView.SplitterVisibility(ViewModel.IsNarrow, ViewModel.IsListCollapsed), Mode=OneWay}" />

            <!-- The chat island holds the empty state, the open conversation or Start chat. It sits above the Mica, as
                 in Settings and File Explorer of Windows. It is rounded, with the same gap on its left, right and
                 bottom. -->
            <Grid
                x:Name="ChatArea"
                Grid.Column="1"
                Margin="0,0,8,8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind local:ChatsView.ChatVisibility(ViewModel.IsNarrow, ViewModel.ShowChatPane, ViewModel.IsListCollapsed), Mode=OneWay}">

                <!-- The empty state shows a large chat glyph above the prompt. -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Visibility="{x:Bind local:ChatsView.EmptyStateVisibility(ViewModel.IsChatOpen, ViewModel.IsStartChatOpen), Mode=OneWay}">
                    <FontIcon
                        FontSize="96"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE8BD;" />
                    <TextBlock
                        x:Name="EmptyStateText"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="Main.EmptyState"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>

                <local:ChatPane
                    x:Name="ChatView"
                    Chat="{x:Bind ViewModel.Chat, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsChatOpen, Mode=OneWay}" />

                <local:StartChatPane
                    x:Name="StartChatView"
                    StartChat="{x:Bind ViewModel.StartChat, Mode=OneWay}"
                    Started="OnChatStarted"
                    Visibility="{x:Bind ViewModel.IsStartChatOpen, Mode=OneWay}" />
            </Grid>
        </Grid>
    </SplitView>
</UserControl>
