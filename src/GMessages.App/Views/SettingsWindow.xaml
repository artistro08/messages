<Window
    x:Class="GMessages.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GMessages.App.Views.Controls"
    xmlns:local="using:GMessages.App.Views">

    <!-- Mica Background -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*">

        <!-- Title Bar: the title is set from code; Plan 3 adds the menu button and profile picture here -->
        <TitleBar
            x:Name="AppTitleBar"
            AutomationProperties.AutomationId="Settings.TitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer Grid.Row="1">
            <StackPanel
                MaxWidth="560"
                Padding="24"
                Spacing="20">

                <!-- Appearance -->
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Appearance" />
                    <ComboBox
                        AutomationProperties.AutomationId="Settings.Theme"
                        Header="Theme"
                        MinWidth="220"
                        SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Use system setting" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </StackPanel>

                <!-- Startup -->
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Startup" />
                    <ToggleSwitch
                        AutomationProperties.AutomationId="Settings.StartWithWindows"
                        Header="Start with Windows"
                        IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />

                    <!-- Startup Refused: why the switch went back off -->
                    <TextBlock
                        AutomationProperties.AutomationId="Settings.StartupMessage"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Text="{x:Bind ViewModel.StartupMessage, Mode=OneWay, TargetNullValue=''}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.HasStartupMessage, Mode=OneWay}" />
                </StackPanel>

                <!-- Notifications -->
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Notifications" />
                    <ToggleSwitch
                        AutomationProperties.AutomationId="Settings.Notifications"
                        Header="Show notifications for new messages"
                        IsOn="{x:Bind ViewModel.NotificationsEnabled, Mode=TwoWay}" />
                    <ToggleSwitch
                        AutomationProperties.AutomationId="Settings.NotifyViewedChat"
                        Header="Notify for the chat I'm viewing"
                        IsOn="{x:Bind ViewModel.NotifyForViewedChat, Mode=TwoWay}" />
                </StackPanel>

                <!-- Account And Logs -->
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Account" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- Unpair: hidden once unpaired, busy with a ring while it runs -->
                        <Button
                            AutomationProperties.AutomationId="Settings.Unpair"
                            AutomationProperties.Name="Unpair this PC"
                            Click="OnUnpairClick"
                            IsEnabled="{x:Bind local:SettingsWindow.Not(ViewModel.IsUnpairing), Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.CanUnpair, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsActive="{x:Bind ViewModel.IsUnpairing, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsUnpairing, Mode=OneWay}" />
                                <TextBlock Text="Unpair this PC" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.AutomationId="Settings.OpenLogs"
                            Click="OnOpenLogsClick"
                            Content="Open logs folder" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Unpair Confirm -->
        <controls:UnpairDialog x:Name="UnpairDialog" Grid.Row="1" />
    </Grid>
</Window>
