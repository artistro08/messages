<UserControl
    x:Class="GMessages.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GMessages.App.Views"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <UserControl.Resources>
        <!-- The card copies the Windows Settings look from SettingsCardStyle of Magic Buds. The icon, the header and
             the description sit on the left, and the control sits on the right. -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="MinHeight" Value="68" />
        </Style>

        <!-- The whole card is the button, as on the cards of Windows Settings that open something. -->
        <Style
            x:Key="SettingsCardButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- The switch has no On/Off text beside it. Thus it sits flush right, as the other controls on a card do. -->
        <Style
            x:Key="CardToggleSwitchStyle"
            BasedOn="{StaticResource DefaultToggleSwitchStyle}"
            TargetType="ToggleSwitch">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
        </Style>

        <Style x:Key="CardIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- This header sits above each group of cards. -->
        <Style
            x:Key="GroupHeaderStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,20,0,4" />
        </Style>

        <Style
            x:Key="CardDescriptionStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <!-- The page fills the width of the window. The cards center at up to 1000 wide, as in Windows Settings. The
         scrollbar stays on the window edge. -->
    <ScrollViewer>
        <Grid Padding="36,4,36,36">
            <StackPanel
                MaxWidth="1000"
                HorizontalAlignment="Stretch"
                Spacing="4">

                <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="Appearance" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;" Style="{StaticResource CardIconStyle}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="Theme" />
                        <ComboBox
                            Grid.Column="2"
                            MinWidth="220"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Settings.Theme"
                            AutomationProperties.Name="Theme"
                            SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Use system setting" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- This switch shows the pinned chats as large pictures above the inbox, as in iMessage. It is off
                     by default. -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE718;" Style="{StaticResource CardIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="PinnedGridHeader" TextWrapping="Wrap" />
                            <TextBlock x:Name="PinnedGridDescription" Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="PinnedGridSwitch"
                            Grid.Column="2"
                            AutomationProperties.AutomationId="Settings.PinnedGrid"
                            IsOn="{x:Bind ViewModel.ShowPinnedGrid, Mode=TwoWay}"
                            Style="{StaticResource CardToggleSwitchStyle}" />
                    </Grid>
                </Border>

                <!-- This switch shows an unread pinned chat as a message card, as Google Messages does. Off shows the
                     small pill. It is on by default, and it works only with the grid on. -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8BD;" Style="{StaticResource CardIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="PinnedCardsHeader" TextWrapping="Wrap" />
                            <TextBlock x:Name="PinnedCardsDescription" Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="PinnedCardsSwitch"
                            Grid.Column="2"
                            AutomationProperties.AutomationId="Settings.PinnedCards"
                            IsEnabled="{x:Bind ViewModel.ShowPinnedGrid, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.ShowPinnedCards, Mode=TwoWay}"
                            Style="{StaticResource CardToggleSwitchStyle}" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="Startup" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7E8;" Style="{StaticResource CardIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" />

                            <!-- This text tells why the switch went back off when Windows refused the startup. -->
                            <TextBlock
                                AutomationProperties.AutomationId="Settings.StartupMessage"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Style="{StaticResource CardDescriptionStyle}"
                                Text="{x:Bind ViewModel.StartupMessage, Mode=OneWay, TargetNullValue=''}"
                                Visibility="{x:Bind ViewModel.HasStartupMessage, Mode=OneWay}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            AutomationProperties.AutomationId="Settings.StartWithWindows"
                            AutomationProperties.Name="Start with Windows"
                            IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                            Style="{StaticResource CardToggleSwitchStyle}" />
                    </Grid>
                </Border>

                <!-- With Run in background off, a close of the window quits. The switch is separate from the tray
                     icon. -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE945;" Style="{StaticResource CardIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Run in the background" TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource CardDescriptionStyle}"
                                Text="Keep running after you close the window, so new messages still notify you. When off, closing the window quits."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            AutomationProperties.AutomationId="Settings.RunInBackground"
                            AutomationProperties.Name="Run in the background"
                            IsOn="{x:Bind ViewModel.RunInBackground, Mode=TwoWay}"
                            Style="{StaticResource CardToggleSwitchStyle}" />
                    </Grid>
                </Border>

                <!-- With the tray icon off, Start opens the app and the account menu quits it. -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE890;" Style="{StaticResource CardIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Show icon in the system tray" TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource CardDescriptionStyle}"
                                Text="When off, there's no icon while it runs in the background. Open it from Start, and quit it from the account menu."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            AutomationProperties.AutomationId="Settings.ShowTrayIcon"
                            AutomationProperties.Name="Show icon in the system tray"
                            IsOn="{x:Bind ViewModel.ShowTrayIcon, Mode=TwoWay}"
                            Style="{StaticResource CardToggleSwitchStyle}" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="Notifications" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEA8F;" Style="{StaticResource CardIconStyle}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="Show notifications for new messages"
                            TextWrapping="Wrap" />
                        <ToggleSwitch
                            Grid.Column="2"
                            AutomationProperties.AutomationId="Settings.Notifications"
                            AutomationProperties.Name="Show notifications for new messages"
                            IsOn="{x:Bind ViewModel.NotificationsEnabled, Mode=TwoWay}"
                            Style="{StaticResource CardToggleSwitchStyle}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8BD;" Style="{StaticResource CardIconStyle}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="Notify for the chat I'm viewing"
                            TextWrapping="Wrap" />
                        <ToggleSwitch
                            Grid.Column="2"
                            AutomationProperties.AutomationId="Settings.NotifyViewedChat"
                            AutomationProperties.Name="Notify for the chat I'm viewing"
                            IsOn="{x:Bind ViewModel.NotifyForViewedChat, Mode=TwoWay}"
                            Style="{StaticResource CardToggleSwitchStyle}" />
                    </Grid>
                </Border>

                <!-- This switch puts a one-time passcode from a new message on the clipboard. It is off by
                     default. -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8C8;" Style="{StaticResource CardIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Copy one-time codes automatically" TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource CardDescriptionStyle}"
                                Text="When a new message has a sign-in or verification code, it's copied so you can paste it right away. It's kept out of clipboard history."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            AutomationProperties.AutomationId="Settings.CopyCodes"
                            AutomationProperties.Name="Copy one-time codes automatically"
                            IsOn="{x:Bind ViewModel.CopyCodes, Mode=TwoWay}"
                            Style="{StaticResource CardToggleSwitchStyle}" />
                    </Grid>
                </Border>

                <!-- The snooze length is the wait of Snooze on a notification. -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE708;" Style="{StaticResource CardIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="SnoozeHeader" TextWrapping="Wrap" />
                            <TextBlock x:Name="SnoozeDescription" Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox
                            x:Name="SnoozeBox"
                            Grid.Column="2"
                            MinWidth="220"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Settings.SnoozeLength"
                            SelectedIndex="{x:Bind ViewModel.SnoozeIndex, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="Privacy" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE71B;" Style="{StaticResource CardIconStyle}" />
                        <TextBlock
                            x:Name="ReceivedPreviewsHeader"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                        <ToggleSwitch
                            x:Name="ReceivedPreviewsSwitch"
                            Grid.Column="2"
                            AutomationProperties.AutomationId="Settings.ReceivedLinkPreviews"
                            IsOn="{x:Bind ViewModel.ShowReceivedLinkPreviews, Mode=TwoWay}"
                            Style="{StaticResource CardToggleSwitchStyle}" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="Voice messages" />

                <!-- The box offers "Windows default", then each active microphone by name. -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE720;" Style="{StaticResource CardIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="MicrophoneHeader" TextWrapping="Wrap" />
                            <TextBlock x:Name="MicrophoneDescription" Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox
                            x:Name="MicrophoneBox"
                            Grid.Column="2"
                            MinWidth="220"
                            MaxWidth="320"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Settings.Microphone"
                            SelectedIndex="{x:Bind ViewModel.MicrophoneIndex, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="Account" />

                <!-- Unpair hides after the unpair and shows a busy ring while it runs. -->
                <Button
                    AutomationProperties.AutomationId="Settings.Unpair"
                    AutomationProperties.Name="Unpair this PC"
                    Click="OnUnpairClick"
                    IsEnabled="{x:Bind local:SettingsPage.Not(ViewModel.IsUnpairing), Mode=OneWay}"
                    Style="{StaticResource SettingsCardButtonStyle}"
                    Visibility="{x:Bind ViewModel.CanUnpair, Mode=OneWay}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- The phone with a slash is mobile_off of Material Symbols, Apache 2.0, outlined and drawn on
                             20 px. -->
                        <PathIcon
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Data="M17.083 19.417 0.583 2.917 l1.167 -1.167 L18.25 18.25 l-1.167 1.167ZM4.167 5.354 l1.667 1.667 v7.979 h8 l2 2 v0.5 q0 0.688 -0.49 1.177 T14.167 19.167 H5.833 q-0.688 0 -1.177 -0.49 T4.167 17.5 v-12.146Zm1.667 11.312 v0.833 h8.333 v-0.833 H5.833Zm1.521 -11.667 -1.646 -1.667 h8.458 v-0.833 H4.875 l-0.583 -0.583 q0.208 -0.479 0.615 -0.781 T5.833 0.833 h8.333 q0.688 0 1.177 0.49 T15.833 2.5 v10.958 l-1.667 -1.667 v-6.792 H7.354Zm2.646 11.667Zm-0.479 -13.333Z" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="Unpair this PC" />
                        <muxc:ProgressRing
                            Grid.Column="2"
                            Width="16"
                            Height="16"
                            IsActive="{x:Bind ViewModel.IsUnpairing, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsUnpairing, Mode=OneWay}" />
                    </Grid>
                </Button>

                <!-- This card opens the logs folder in File Explorer. -->
                <Button
                    AutomationProperties.AutomationId="Settings.OpenLogs"
                    AutomationProperties.Name="Open logs folder"
                    Click="OnOpenLogsClick"
                    Style="{StaticResource SettingsCardButtonStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" Style="{StaticResource CardIconStyle}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="Open logs folder" />
                        <FontIcon
                            Grid.Column="2"
                            FontSize="12"
                            Glyph="&#xE8A7;" />
                    </Grid>
                </Button>

                <!-- About comes from the About page of Magic Buds. -->
                <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="About" />

                <!-- This card shows the name, the version and the maker of the app. -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Width="32"
                            Height="32"
                            VerticalAlignment="Center"
                            Source="ms-appx:///Assets/AppIcon.ico" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                AutomationProperties.AutomationId="Settings.AppName"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind local:SettingsPage.AppName}" />
                            <TextBlock
                                AutomationProperties.AutomationId="Settings.Version"
                                Style="{StaticResource CardDescriptionStyle}"
                                Text="{x:Bind local:SettingsPage.VersionText}" />
                            <TextBlock Style="{StaticResource CardDescriptionStyle}">
                                <Run Text="By " /><Hyperlink AutomationProperties.AutomationId="Settings.Author" NavigateUri="https://github.com/artistro08">
                                    artistro08
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE943;" Style="{StaticResource CardIconStyle}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{x:Bind local:SettingsPage.RepositoryText}"
                            TextWrapping="Wrap" />
                        <HyperlinkButton
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Settings.Repository"
                            Content="View on GitHub"
                            NavigateUri="https://github.com/artistro08/messages" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
