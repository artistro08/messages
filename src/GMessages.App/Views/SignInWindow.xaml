<Window
    x:Class="GMessages.App.Views.SignInWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Mica Background -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*">

        <!-- Title Bar: the title is set from code -->
        <TitleBar
            x:Name="AppTitleBar"
            AutomationProperties.AutomationId="SignIn.TitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Sign-In: the WebView2 is added in code -->
        <Border
            x:Name="SignInHost"
            Grid.Row="1" />
    </Grid>
</Window>
