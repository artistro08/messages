<!-- Photo Viewer: a clicked photo (zoomable) or video (playing) over the whole window (the title bar row too, so all of the
     app is tinted) on a dark scrim, with Close, Open in Photos (Open in default app for a video), Download and Save as in
     the title bar row's top-left corner. Dark theme always, so its icons read on the scrim. Hidden until shown (see the
     code) -->
<UserControl
    x:Class="GMessages.App.Views.Controls.PhotoViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GMessages.App.Views.Controls"
    RequestedTheme="Dark"
    Visibility="Collapsed">

    <!-- Scrim Color: near black, so the chat under it doesn't compete with the photo; the window color in high contrast -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="PhotoViewerScrimBrush" Color="#E6000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PhotoViewerScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Scrim: Tab and Shift + Tab cycle inside, so focus never leaves the viewer -->
    <Grid
        x:Name="Scrim"
        RowDefinitions="48,*"
        TabFocusNavigation="Cycle">

        <!-- Window Activation: the toolbar's icons dim while the window is inactive, as the title bar's text does (set from
             the window's Activated, through ShowActive) -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Activation">
                <VisualState x:Name="Active" />
                <VisualState x:Name="Inactive">
                    <VisualState.Setters>
                        <Setter Target="CloseIcon.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                        <Setter Target="OpenIcon.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                        <Setter Target="DownloadIcon.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                        <Setter Target="SaveAsIcon.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Backdrop: the tint, its own layer so it fades in and out (from code) while the photo grows and shrinks. No
             implicit transitions here or on the toolbar and stage: the code takes their visuals -->
        <Border
            x:Name="Backdrop"
            Grid.RowSpan="2"
            Background="{ThemeResource PhotoViewerScrimBrush}" />

        <!-- Toolbar: in the title bar row's top-left corner (48 px, the tall caption buttons' height), Close first. The
             window lets clicks through to these buttons only (set from the window's code) -->
        <StackPanel
            x:Name="ToolbarPanel"
            Margin="8,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="4">

            <!-- Close: a back arrow on a round, softly filled plate, so it never reads as Windows' square caption close -->
            <Button
                x:Name="CloseButton"
                Width="40"
                Height="40"
                AutomationProperties.AutomationId="PhotoViewer.Close"
                AutomationProperties.Name="{x:Bind local:PhotoViewer.CloseText}"
                Click="OnCloseClick"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind local:PhotoViewer.CloseText}">
                <Grid>
                    <Ellipse
                        Width="36"
                        Height="36"
                        Fill="{ThemeResource ControlFillColorSecondaryBrush}"
                        Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                        StrokeThickness="1" />
                    <FontIcon
                        x:Name="CloseIcon"
                        FontSize="16"
                        Glyph="&#xE72B;" />
                </Grid>
            </Button>

            <!-- Open In Photos, Or Open In Default App For A Video: Named From Code On Each Open (A Bound Name Was Set Back
                 Once The Viewer First Loaded) -->
            <Button
                x:Name="OpenInPhotosButton"
                Width="40"
                Height="40"
                AutomationProperties.AutomationId="PhotoViewer.OpenInPhotos"
                Click="OnOpenInPhotosClick"
                Style="{StaticResource IconButtonStyle}">
                <FontIcon
                    x:Name="OpenIcon"
                    FontSize="16"
                    Glyph="&#xE8A7;" />
            </Button>
            <Button
                x:Name="DownloadButton"
                Width="40"
                Height="40"
                AutomationProperties.AutomationId="PhotoViewer.Download"
                AutomationProperties.Name="{x:Bind local:PhotoViewer.DownloadText}"
                Click="OnDownloadClick"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind local:PhotoViewer.DownloadText}">
                <FontIcon
                    x:Name="DownloadIcon"
                    FontSize="16"
                    Glyph="&#xE896;" />
            </Button>
            <Button
                x:Name="SaveAsButton"
                Width="40"
                Height="40"
                AutomationProperties.AutomationId="PhotoViewer.SaveAs"
                AutomationProperties.Name="{x:Bind local:PhotoViewer.SaveAsText}"
                Click="OnSaveAsClick"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind local:PhotoViewer.SaveAsText}">
                <FontIcon
                    x:Name="SaveAsIcon"
                    FontSize="16"
                    Glyph="&#xE792;" />
            </Button>
        </StackPanel>
        <!-- /Toolbar -->

        <!-- Stage: the photo or the video, grown from the bubble on open and shrunk back on close (from code) -->
        <Grid x:Name="Stage" Grid.Row="1">

            <!-- Photo: centered and fitted at 1x (a smaller photo at its own size), Ctrl + mouse wheel and pinch zoom up to
                 8x, a double-click zooms in or back out. Named for Narrator by the photo's caption (or "Photo"); a click
                 beside the photo closes the viewer -->
            <ScrollViewer
                x:Name="Zoomer"
                AutomationProperties.AutomationId="PhotoViewer.Photo"
                Background="Transparent"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                IsTabStop="True"
                MaxZoomFactor="8"
                MinZoomFactor="1"
                SizeChanged="OnZoomerSizeChanged"
                Tapped="OnZoomerTapped"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto"
                ViewChanged="OnZoomerViewChanged"
                ZoomMode="Enabled">
                <Image
                    x:Name="PhotoImage"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DoubleTapped="OnPhotoDoubleTapped"
                    Stretch="Uniform" />
            </ScrollViewer>

            <!-- Video: a clicked video plays here, fitted inside the photo's 24 px margin, with Windows' full transport
                 controls (made in code; PhotoViewer.Video). Shown instead of the photo -->
            <Grid
                x:Name="VideoHost"
                Margin="24"
                Visibility="Collapsed" />
        </Grid>
        <!-- /Stage -->
    </Grid>
</UserControl>
