<!-- A turning ring on a small round plate. It shows while a file of mine sends from here. -->
<UserControl
    x:Class="GMessages.App.Views.Controls.UploadSpinner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GMessages.App.Views.Controls"
    Width="28"
    Height="28"
    IsHitTestVisible="False">

    <!-- An Ellipse, not a Border with round corners. At 125 % scale the Border drew a jagged edge over a photo. -->
    <Grid>
        <Ellipse Fill="{ThemeResource ControlOnImageFillColorDefaultBrush}" />
        <local:Spinner />
    </Grid>
</UserControl>
