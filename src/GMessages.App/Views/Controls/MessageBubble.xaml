<UserControl
    x:Class="GMessages.App.Views.Controls.MessageBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GMessages.App.Views.Controls"
    PointerCanceled="OnPointerLeft"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerLeft">

    <!-- Row: the bubble, with an avatar lane on its left for received bubbles in a group chat (the avatar beside a group's
         last bubble). Bubbles of one group sit 2 px apart, groups further -->
    <Grid
        x:Name="Row"
        Margin="{x:Bind local:MessageBubble.GroupMargin(Bubble.IsFirstInGroup, Bubble.IsLastInGroup), Mode=OneWay}">

        <!-- Sent Or Received: sent RCS sits right on a lighter shade of the accent, sent SMS right on the accent color,
             received left on the card color; the reaction pill takes the bubble's inner corner. The quote is tinted to suit
             the bubble it sits in. The groups must stay on the control's root element: GoToState only looks there, and
             on any element below it every state silently fails to apply -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Side">
                <VisualState x:Name="Received" />
                <VisualState x:Name="Sent">
                    <VisualState.Setters>
                        <Setter Target="Root.HorizontalAlignment" Value="Right" />
                        <Setter Target="BackRow.HorizontalAlignment" Value="Right" />
                        <Setter Target="BackFill.Background" Value="{ThemeResource RcsBubbleBrush}" />
                        <Setter Target="BackFill.BorderBrush" Value="{ThemeResource RcsBubbleBorderBrush}" />
                        <Setter Target="Body.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Setter Target="Under.HorizontalAlignment" Value="Right" />
                        <Setter Target="PillHost.(Grid.Column)" Value="0" />
                        <Setter Target="PillHost.Margin" Value="0,-8,6,0" />
                        <Setter Target="Captions.(Grid.Column)" Value="2" />
                        <Setter Target="HoverStrip.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SentSms">
                    <VisualState.Setters>
                        <Setter Target="Root.HorizontalAlignment" Value="Right" />
                        <Setter Target="BackRow.HorizontalAlignment" Value="Right" />
                        <Setter Target="BackFill.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="BackFill.BorderThickness" Value="0" />
                        <Setter Target="Body.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="Quote.Background" Value="{ThemeResource QuoteOnAccentFillBrush}" />
                        <Setter Target="QuoteBar.Background" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="QuoteSender.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="QuoteText.Foreground" Value="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                        <Setter Target="FileCard.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="FileDetail.Foreground" Value="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                        <Setter Target="VoicePlay.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="VoiceLength.Foreground" Value="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                        <Setter Target="VoiceBars.BarBrush" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="PreviewCard.Background" Value="{ThemeResource QuoteOnAccentFillBrush}" />
                        <Setter Target="PreviewCard.BorderThickness" Value="0" />
                        <Setter Target="PreviewTitle.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="PreviewSite.Foreground" Value="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                        <Setter Target="Under.HorizontalAlignment" Value="Right" />
                        <Setter Target="PillHost.(Grid.Column)" Value="0" />
                        <Setter Target="PillHost.Margin" Value="0,-8,6,0" />
                        <Setter Target="Captions.(Grid.Column)" Value="2" />
                        <Setter Target="HoverStrip.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!-- My Reaction: the pill gets a soft accent fill (ReactionPillMineBrush in App.xaml), no ring. On the fill under the
                 button, so the button's hover only tints it -->
            <VisualStateGroup x:Name="Reaction">
                <VisualState x:Name="NotMine" />
                <VisualState x:Name="Mine">
                    <VisualState.Setters>
                        <Setter Target="PillBack.Background" Value="{ThemeResource ReactionPillMineBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!-- Hover: react, reply and the ⋮ fade in while the pointer is over a bubble that takes them (CanAct), as the
                 conversation row's ⋮ does -->
            <VisualStateGroup x:Name="Hover">
                <VisualStateGroup.Transitions>
                    <VisualTransition To="Shown">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverStrip" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame
                                    KeySpline="{StaticResource ControlFastOutSlowInKeySpline}"
                                    KeyTime="{StaticResource ControlFastAnimationDuration}"
                                    Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Hidden" />
                <VisualState x:Name="Shown">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="HoverStrip"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="0" />
                    </Storyboard>
                    <VisualState.Setters>
                        <Setter Target="HoverReact.IsHitTestVisible" Value="True" />
                        <Setter Target="HoverReply.IsHitTestVisible" Value="True" />
                        <Setter Target="HoverMore.IsHitTestVisible" Value="True" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!-- Focus Ring: the ring around the back while the bubble's row has keyboard (or programmatic) focus, set by the
                 chat pane. Named apart from Hover's Hidden and Shown: GoToState finds a state by name across groups -->
            <VisualStateGroup x:Name="FocusRingStates">
                <VisualState x:Name="RingHidden" />
                <VisualState x:Name="RingShown">
                    <VisualState.Setters>
                        <Setter Target="FocusRing.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Bubble: sender name, the quote, text and link preview on its colored back, the reaction pill on its bottom corner, then the
             time (once clicked) or the retry link, and the caption row (time, delivery icon and lock) under my newest message.
             As wide as its content, up to 70% of the chat (560 px at most; set from code). The padding keeps the avatar lane's
             and the hover strip's space on their sides -->
        <StackPanel
            x:Name="Root"
            Padding="{x:Bind local:MessageBubble.LanePadding(Bubble.HasAvatarLane, Bubble.FromMe), Mode=OneWay}"
            HorizontalAlignment="Left"
            Opacity="{x:Bind local:MessageBubble.SendingOpacity(Bubble.IsSending), Mode=OneWay}"
            Spacing="2">

            <!-- Bubble Menu: right-click, the Application key or Shift + F10. No Copy on a photo or file without a caption, and
                 no Open on a received program or script (only Save as) -->
            <StackPanel.ContextFlyout>
                <MenuFlyout x:Name="Menu">
                    <MenuFlyoutItem
                        AutomationProperties.AutomationId="Bubble.Copy"
                        Click="OnCopyClick"
                        Text="{x:Bind local:MessageBubble.CopyText}"
                        Visibility="{x:Bind Bubble.HasCopyText, Mode=OneWay, FallbackValue=Collapsed}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8C8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        AutomationProperties.AutomationId="Bubble.Open"
                        Click="OnOpenClick"
                        Text="{x:Bind local:MessageBubble.OpenText}"
                        Visibility="{x:Bind Bubble.CanOpenMedia, Mode=OneWay, FallbackValue=Collapsed}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8E5;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        AutomationProperties.AutomationId="Bubble.SaveAs"
                        Click="OnSaveAsClick"
                        Text="{x:Bind local:MessageBubble.SaveAsText}"
                        Visibility="{x:Bind Bubble.HasMediaFile, Mode=OneWay, FallbackValue=Collapsed}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE792;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        AutomationProperties.AutomationId="Bubble.Download"
                        Click="OnDownloadClick"
                        Text="{x:Bind local:MessageBubble.DownloadText}"
                        Visibility="{x:Bind Bubble.HasMediaFile, Mode=OneWay, FallbackValue=Collapsed}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE896;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        AutomationProperties.AutomationId="Bubble.React"
                        Click="OnReactClick"
                        KeyboardAcceleratorTextOverride="Shift + +"
                        Text="{x:Bind local:MessageBubble.ReactText}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE76E;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        AutomationProperties.AutomationId="Bubble.Reply"
                        Click="OnReplyClick"
                        KeyboardAcceleratorTextOverride="Ctrl + Enter"
                        Text="{x:Bind local:MessageBubble.ReplyText}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE97A;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </StackPanel.ContextFlyout>


            <!-- Sender: first bubble of a received group in a group chat, in the color of their letter circle -->
            <TextBlock
                Margin="12,0"
                Foreground="{x:Bind local:ColorConverters.ToBrush(Bubble.SenderColor), Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Bubble.SenderName, Mode=OneWay, TargetNullValue=''}"
                Visibility="{x:Bind Bubble.HasSenderName, Mode=OneWay, FallbackValue=Collapsed}" />

            <!-- Bubble Back With The Avatar Lane And The Hover Strip: both reach out into the row's padding, so the avatar sits
                 beside the bubble itself, bottoms aligned (not beside the pill, time or caption row below it), and the strip
                 beside the back, centered on it. Kept to its own width on the bubble's outer side (the Side states), so a
                 wider time or caption row under a short message never stretches the back past its text -->
            <Grid
                x:Name="BackRow"
                Margin="{x:Bind local:MessageBubble.LaneOverhang(Bubble.HasAvatarLane, Bubble.FromMe), Mode=OneWay}"
                HorizontalAlignment="Left"
                ColumnDefinitions="Auto,*,Auto">

                <!-- Avatar Lane: the sender's avatar at the group's last bubble, made only where it shows -->
                <Grid Width="{x:Bind local:MessageBubble.LaneWidth(Bubble.HasAvatarLane), Mode=OneWay}">
                    <Viewbox
                        x:Name="SenderAvatar"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        x:Load="{x:Bind Bubble.ShowsAvatar, Mode=OneWay, FallbackValue=False}">
                        <local:Avatar
                            Color="{x:Bind Bubble.SenderColor, Mode=OneWay, FallbackValue=0}"
                            Initial="{x:Bind Bubble.AvatarInitial, Mode=OneWay, FallbackValue=''}"
                            PhotoId="{x:Bind Bubble.AvatarPhotoId, Mode=OneWay, FallbackValue=''}" />
                    </Viewbox>
                </Grid>

                <!-- Fill: the bubble's color and edge, behind its content. A photo or video with nothing else in its bubble hides
                     it, so its own edge is the bubble's edge and no fill or stroke shows around it -->
                <Border
                    x:Name="BackFill"
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{x:Bind local:MessageBubble.CornersOf(Bubble.FromMe, Bubble.IsFirstInGroup, Bubble.IsLastInGroup), Mode=OneWay}"
                    Visibility="{x:Bind local:MessageBubble.FillShown(Bubble.FillsBubble, Bubble.HasBodyText, Bubble.HasQuote), Mode=OneWay, FallbackValue=Collapsed}" />

                <!-- Text: a click shows or hides the time -->
                <Border
                    x:Name="Back"
                    Grid.Column="1"
                    Padding="{x:Bind local:MessageBubble.BackPadding(Bubble.FillsBubble), Mode=OneWay}"
                    Background="Transparent"
                    CornerRadius="{x:Bind local:MessageBubble.CornersOf(Bubble.FromMe, Bubble.IsFirstInGroup, Bubble.IsLastInGroup), Mode=OneWay}">
                    <StackPanel>

                        <!-- Quote: the message this one replies to on a tint of the bubble's color, after an accent bar; sender in
                             caption style and at most two lines of text -->
                        <Grid
                            x:Name="Quote"
                            Margin="-4,0,-4,6"
                            Padding="0,0,8,0"
                            Background="{ThemeResource QuoteFillBrush}"
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="8"
                            CornerRadius="8"
                            Visibility="{x:Bind Bubble.HasQuote, Mode=OneWay, FallbackValue=Collapsed}">
                            <Border
                                x:Name="QuoteBar"
                                Width="3"
                                Background="{ThemeResource QuoteBarBrush}" />

                            <!-- Quoted Media: its thumbnail (or a file icon) left of two lines, the sender in semibold and
                                 "Image", "Video", "GIF" in italic (or the file's name) -->
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
                                <local:MediaThumb
                                    Margin="0,6,8,6"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('QuoteThumb.', Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                                    Media="{x:Bind Bubble.QuoteMedia, Mode=OneWay}"
                                    Visibility="{x:Bind Bubble.HasQuoteMedia, Mode=OneWay, FallbackValue=Collapsed}" />
                                <StackPanel
                                    Grid.Column="1"
                                    Padding="0,6"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="QuoteSender"
                                        FontWeight="{x:Bind local:MessageBubble.QuoteSenderWeight(Bubble.HasQuoteMedia), Mode=OneWay}"
                                        MaxLines="1"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Bubble.QuoteSender, Mode=OneWay, FallbackValue=''}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind local:MessageBubble.ShownIfText(Bubble.QuoteSender), Mode=OneWay, FallbackValue=Collapsed}" />
                                    <TextBlock
                                        x:Name="QuoteText"
                                        AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Quote.', Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                                        FontStyle="{x:Bind local:MessageBubble.LabelStyle(Bubble.QuoteIsLabel), Mode=OneWay}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="2"
                                        Text="{x:Bind Bubble.QuoteText, Mode=OneWay, FallbackValue=''}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Photo: edge to edge in the bubble, rounded to its corners. The thumbnail shows first, decoded tiny
                             and stretched (blurred), then the full image fades in over it. The size is kept from the photo's
                             dimensions before anything loads (set from code), so nothing moves when it arrives. A click opens it
                             in the default photo app, or after a failure tries again. Named by its caption, else "Photo" -->
                        <Button
                            x:Name="Photo"
                            Padding="0"
                            BorderThickness="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Bubble.Photo.', Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Bubble.PhotoName, Mode=OneWay, FallbackValue=''}"
                            Click="OnPhotoClick"
                            CornerRadius="{x:Bind local:MessageBubble.PhotoCorners(Bubble.FromMe, Bubble.IsFirstInGroup, Bubble.IsLastInGroup, Bubble.HasBodyText), Mode=OneWay}"
                            Style="{StaticResource IconButtonStyle}"
                            Visibility="{x:Bind Bubble.HasPhoto, Mode=OneWay, FallbackValue=Collapsed}">
                            <Grid>
                                <Border x:Name="PhotoBlur" />
                                <!-- The full image: a still photo is this layer's ImageBrush, which its corners clip; a GIF is
                                     the Image (a brush shows only a GIF's first frame, an Image plays it), clipped to the
                                     photo's corners from code -->
                                <Border x:Name="PhotoFull" Opacity="0">
                                    <Image x:Name="PhotoFullImage" Stretch="UniformToFill" />
                                </Border>

                                <!-- Note: waiting for the phone, or the failure (click to try again), on a small plate over the photo -->
                                <Border
                                    x:Name="PhotoNoteBack"
                                    Margin="12"
                                    Padding="8,4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="PhotoNote"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </Button>
                        <!-- /Photo -->

                        <!-- Video: edge to edge in the bubble like a photo, at the size its dimensions give (set from code),
                             rounded to the bubble's corners. Its still frame (the thumbnail the phone sent, else one made
                             here from the video; a plain fill until it loads) with a play button over it. A click on the frame opens the window's viewer; the
                             play button plays it here, with sound and compact controls (play or pause, seek, volume; made in
                             code, in VideoHost), and the expand button then opens the viewer where it got to. The frame is
                             named by the caption, else "Video", and shows the hand cursor (LinkCardButton) -->
                        <Grid
                            x:Name="Video"
                            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                            CornerRadius="{x:Bind local:MessageBubble.PhotoCorners(Bubble.FromMe, Bubble.IsFirstInGroup, Bubble.IsLastInGroup, Bubble.HasBodyText), Mode=OneWay}"
                            Visibility="{x:Bind Bubble.HasVideo, Mode=OneWay, FallbackValue=Collapsed}">
                            <local:LinkCardButton
                                x:Name="VideoFrame"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Bubble.Video.', Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind Bubble.VideoName, Mode=OneWay, FallbackValue=''}"
                                BorderThickness="0"
                                Click="OnVideoFrameClick"
                                CornerRadius="{x:Bind local:MessageBubble.PhotoCorners(Bubble.FromMe, Bubble.IsFirstInGroup, Bubble.IsLastInGroup, Bubble.HasBodyText), Mode=OneWay}"
                                Style="{StaticResource IconButtonStyle}">
                                <Border
                                    x:Name="VideoThumb"
                                    CornerRadius="{x:Bind local:MessageBubble.PhotoCorners(Bubble.FromMe, Bubble.IsFirstInGroup, Bubble.IsLastInGroup, Bubble.HasBodyText), Mode=OneWay}" />
                            </local:LinkCardButton>

                            <!-- Play: on a round plate over the frame's middle -->
                            <Button
                                x:Name="VideoPlay"
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Video.Play.', Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind local:MessageBubble.PlayVideoText}"
                                Click="OnVideoPlayClick"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind local:MessageBubble.PlayVideoText}">
                                <Grid>
                                    <Ellipse
                                        Width="48"
                                        Height="48"
                                        Fill="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
                                    <FontIcon FontSize="20" Glyph="&#xE768;" />
                                </Grid>
                            </Button>

                            <!-- Player: the playing video and its compact controls, added and removed from code -->
                            <Grid x:Name="VideoHost" />

                            <!-- Expand: while it plays, opens it in the viewer where it got to -->
                            <Button
                                x:Name="VideoExpand"
                                Width="32"
                                Height="32"
                                Margin="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Video.Expand.', Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind local:MessageBubble.OpenVideoText}"
                                Click="OnVideoExpandClick"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind local:MessageBubble.OpenVideoText}"
                                Visibility="Collapsed">
                                <Grid>
                                    <Ellipse
                                        Width="32"
                                        Height="32"
                                        Fill="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
                                    <FontIcon FontSize="14" Glyph="&#xE740;" />
                                </Grid>
                            </Button>

                            <!-- Note: downloading, or the failure, on a small plate at the bottom -->
                            <Border
                                x:Name="VideoNoteBack"
                                Margin="12"
                                Padding="8,4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                CornerRadius="4"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="VideoNote"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                        <!-- /Video -->

                        <!-- File Card: a video or file, with its thumbnail when one came (else its type's icon), its name, and its
                             size as Explorer writes it, or "Downloading…" while it opens, or the failure. A click (or Enter or
                             Space) downloads it and opens it in its default app. Named by the file name -->
                        <Button
                            x:Name="FileCard"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Bubble.File.', Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Bubble.FileName, Mode=OneWay, FallbackValue=''}"
                            Click="OnFileClick"
                            Style="{StaticResource IconButtonStyle}"
                            Visibility="{x:Bind Bubble.HasFileCard, Mode=OneWay, FallbackValue=Collapsed}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Grid
                                    Width="40"
                                    Height="40"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <FontIcon FontSize="20" Glyph="{x:Bind local:MessageBubble.FileGlyph(Bubble.Kind), Mode=OneWay, FallbackValue=''}" />
                                    <Border x:Name="FileThumb" CornerRadius="6" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        MaxLines="1"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Bubble.FileName, Mode=OneWay, FallbackValue=''}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="FileDetail"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <!-- /File Card -->

                        <!-- Voice: play or pause, the waveform that fills as it plays (a click seeks) and the length, read from the
                             audio once it downloads. The length is named Bubble.Voice.{id} -->
                        <Grid
                            x:Name="Voice"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="8"
                            Visibility="{x:Bind Bubble.HasVoice, Mode=OneWay, FallbackValue=Collapsed}">
                            <Button
                                x:Name="VoicePlay"
                                Width="32"
                                Height="32"
                                Margin="-6,0,0,0"
                                AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Voice.Play.', Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                                Click="OnVoicePlayClick"
                                Style="{StaticResource IconButtonStyle}">
                                <FontIcon x:Name="VoiceGlyph" FontSize="16" />
                            </Button>
                            <local:Waveform
                                x:Name="VoiceBars"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Voice.Wave.', Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                                BarBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                SeekRequested="OnVoiceSeekRequested" />
                            <TextBlock
                                x:Name="VoiceLength"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Bubble.Voice.', Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>
                        <!-- /Voice -->

                        <!-- Upload: how much of my photo or file has gone up, while it sends from here -->
                        <ProgressBar
                            Margin="10,6"
                            AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Upload.', Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                            Maximum="100"
                            Value="{x:Bind Bubble.UploadPercent, Mode=OneWay, FallbackValue=0}"
                            Visibility="{x:Bind Bubble.IsUploading, Mode=OneWay, FallbackValue=Collapsed}" />

                        <!-- Text: while the preview card shows, without the card's link (Bubble.BodyText); a message that was
                             only the link shows the card alone -->
                        <TextBlock
                            x:Name="Body"
                            Margin="{x:Bind local:MessageBubble.CaptionMargin(Bubble.FillsBubble), Mode=OneWay}"
                            AutomationProperties.AutomationId="{x:Bind local:MessageBubble.AutomationIdOf(Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                            AutomationProperties.ItemType="{x:Bind Bubble.ItemTypeName, Mode=OneWay, FallbackValue=''}"
                            IsTextSelectionEnabled="True"
                            IsColorFontEnabled="True"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind Bubble.HasBodyText, Mode=OneWay, FallbackValue=Collapsed}" />

                        <!-- Link Preview: the page's image, its title (two lines at most) and its site in caption style; a click,
                             Enter or Space opens the link in the default browser. Named by its title and the link's host.
                             Right-click, the Application key or Shift + F10 opens its own menu, with Copy link. The card's
                             look lives on PreviewCard; the button itself has no hover or press fill (IconButtonStyle), so
                             pointing at it never flashes a different color (owner report). The hand cursor shows over it, as
                             over a link (LinkCardButton) -->
                        <local:LinkCardButton
                            x:Name="Preview"
                            Margin="{x:Bind local:MessageBubble.PreviewMargin(Bubble.HasBodyText), Mode=OneWay}"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Preview.', Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Bubble.PreviewName, Mode=OneWay, FallbackValue=''}"
                            Click="OnPreviewClick"
                            CornerRadius="8"
                            Style="{StaticResource IconButtonStyle}"
                            Visibility="{x:Bind Bubble.HasPreview, Mode=OneWay, FallbackValue=Collapsed}">
                            <local:LinkCardButton.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="Preview.CopyLink"
                                        Click="OnCopyLinkClick"
                                        Text="{x:Bind local:MessageBubble.CopyLinkText}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE71B;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </local:LinkCardButton.ContextFlyout>
                            <Border
                                x:Name="PreviewCard"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel MaxWidth="240">
                                    <Image
                                        x:Name="PreviewImage"
                                        MaxWidth="240"
                                        Stretch="Uniform"
                                        Visibility="Collapsed" />
                                    <StackPanel Padding="10,6,10,8" Spacing="2">
                                        <TextBlock
                                            x:Name="PreviewTitle"
                                            MaxLines="2"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Bubble.Preview.Title, Mode=OneWay, FallbackValue=''}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="PreviewSite"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="1"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Bubble.Preview.Site, Mode=OneWay, FallbackValue=''}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </local:LinkCardButton>
                    </StackPanel>
                </Border>

                <!-- Focus Ring: hugs the back (photos and cards too) 3 px out, following its corners, grouped ones included:
                     Fluent's focus stroke, a 2 px outer ring with a 1 px inner one, as Windows' own focus visual. Drawn only
                     while the row has keyboard focus (see FocusRingStates); never in high contrast, where the row's system
                     focus visual shows instead. Takes no clicks -->
                <Border
                    x:Name="FocusRing"
                    Grid.Column="1"
                    Margin="-3"
                    BorderBrush="{ThemeResource FocusStrokeColorOuterBrush}"
                    BorderThickness="2"
                    CornerRadius="{x:Bind local:MessageBubble.RingCorners(Bubble.FromMe, Bubble.IsFirstInGroup, Bubble.IsLastInGroup, 3), Mode=OneWay}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <Border
                        BorderBrush="{ThemeResource FocusStrokeColorInnerBrush}"
                        BorderThickness="1"
                        CornerRadius="{x:Bind local:MessageBubble.RingCorners(Bubble.FromMe, Bubble.IsFirstInGroup, Bubble.IsLastInGroup, 1), Mode=OneWay}" />
                </Border>

                <!-- Hover Strip: react, reply and the ⋮ (see Hover above), right of a received back and left of a sent one (the
                     Side states move it). Always there and always the same width, so no bubble moves when it shows; as tall
                     as the back and transparent, so the pointer stays on the bubble on its way to the buttons. Not tab stops:
                     the keyboard has the bubble menu, Shift + + and Ctrl + Enter -->
                <StackPanel
                    x:Name="HoverStrip"
                    Grid.Column="2"
                    Padding="4,0"
                    Background="Transparent"
                    Opacity="0"
                    Orientation="Horizontal">
                    <Button
                        x:Name="HoverReact"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('HoverReact.', Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                        Click="OnHoverReactClick"
                        IsHitTestVisible="False"
                        IsTabStop="False"
                        Style="{StaticResource IconButtonStyle}">
                        <FontIcon FontSize="16" Glyph="&#xE76E;" />
                    </Button>
                    <Button
                        x:Name="HoverReply"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('HoverReply.', Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                        Click="OnHoverReplyClick"
                        IsHitTestVisible="False"
                        IsTabStop="False"
                        Style="{StaticResource IconButtonStyle}">
                        <FontIcon FontSize="16" Glyph="&#xE97A;" />
                    </Button>
                    <Button
                        x:Name="HoverMore"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('HoverMore.', Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                        Click="OnHoverMoreClick"
                        IsHitTestVisible="False"
                        IsTabStop="False"
                        Style="{StaticResource IconButtonStyle}">
                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                    </Button>
                </StackPanel>
                <!-- /Hover Strip -->
            </Grid>

            <!-- Under The Bubble: the reaction pill on the bubble's inner corner, and the time or caption row on its outer side,
                 side by side, so a reaction never pushes the time down. At least as wide as the back (set from code), so the
                 pill sits on the back's corner; under a short bubble the row grows past it on the inner side instead, and the
                 pill moves over just enough to clear the time -->
            <Grid
                x:Name="Under"
                Margin="12,0"
                HorizontalAlignment="Left"
                ColumnDefinitions="Auto,*,Auto">

                <!-- Reactions: a pill over the bubble's bottom corner; a click (or Enter or Space) lists who reacted, in every chat
                     (built in code; never the reaction picker). A whole-pixel height (24,
                     more for large text) with corners of half of it, and its fill under the stroke, so the ends draw as smooth half
                     circles at any scale. Its top 8 px overlap the back, and it keeps 6 px from the time -->
                <Grid
                    x:Name="PillHost"
                    Grid.Column="2"
                    Margin="6,-8,0,0"
                    VerticalAlignment="Top"
                    Visibility="{x:Bind Bubble.HasReactions, Mode=OneWay, FallbackValue=Collapsed}">

                    <!-- Pill Fill: under the button, so the button's hover and press only tint it and my reaction's accent
                         (the Mine state) stays through them. Set on the button, the fill was swapped for the hover fill on
                         every hover, through the button's 83 ms brush transition (the flicker) -->
                    <Border
                        x:Name="PillBack"
                        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                        CornerRadius="12"
                        UseLayoutRounding="True" />
                    <Button
                        x:Name="Pill"
                        MinHeight="24"
                        Padding="8,0"
                        VerticalContentAlignment="Center"
                        AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Reactions.', Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                        Background="Transparent"
                        BackgroundSizing="OuterBorderEdge"
                        BorderBrush="{ThemeResource ReactionPillBorderBrush}"
                        BorderThickness="1"
                        Click="OnPillClick"
                        Content="{x:Bind Bubble.ReactionsText, Mode=OneWay, FallbackValue=''}"
                        CornerRadius="12"
                        FontSize="12"
                        UseLayoutRounding="True">

                        <!-- Hover And Press: see-through tints over the fill, so the brush transition runs from clear to a faint
                             tint and never through a bright gray. No outline: the 1 px border is clear (ReactionPillBorderBrush
                             in App.xaml; the fill runs under it, so the pill keeps its size). High contrast keeps an edge and the
                             system button's own hover and press colors, so the pill and its hover still show -->
                        <Button.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Light">
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Button.Resources>
                    </Button>
                </Grid>
                <!-- /Reactions -->

                <!-- Captions: the time or retry link, or the caption row, on the bubble's outer side -->
                <StackPanel x:Name="Captions" Spacing="2">

                    <!-- Time (Hidden Until The Bubble Is Clicked), Or The Retry Link When The Send Failed -->
                    <Grid x:Name="Footer">
                        <TextBlock
                            AutomationProperties.AutomationId="{x:Bind local:MessageBubble.TimeIdOf(Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Bubble.Time, Mode=OneWay}"
                            Visibility="{x:Bind local:MessageBubble.TimeVisibility(Bubble.IsTimeShown, Bubble.IsFailed, Bubble.ShowsStatusRow), Mode=OneWay}" />

                        <!-- Not Sent: a red error mark before the retry link -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{x:Bind Bubble.IsFailed, Mode=OneWay}">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xE783;" />
                            <HyperlinkButton
                                Padding="0"
                                AutomationProperties.AutomationId="{x:Bind local:MessageBubble.RetryIdOf(Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                                Click="OnRetryClick"
                                Content="{x:Bind Bubble.NotSentText, Mode=OneWay, FallbackValue=''}"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Caption Row: only under the chat's newest bubble, until it is clicked. The time (Caption.{id}), then on my bubble
                         the delivery icon (a stopwatch while sending, a check in a ring when sent, two when delivered, two filled when
                         read), and the lock in an encrypted chat. The icon is drawn, not text; its name (Status.{id}) is "Sent",
                         "Delivered" or "Read" for screen readers -->
                    <StackPanel
                        x:Name="StatusRow"
                        Orientation="Horizontal"
                        Spacing="4"
                        Visibility="{x:Bind Bubble.ShowsStatusRow, Mode=OneWay, FallbackValue=Collapsed}">
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Caption.', Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Bubble.Time, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="&#x00B7;"
                            Visibility="{x:Bind Bubble.ShowsCaptionDot, Mode=OneWay, FallbackValue=Collapsed}" />

                        <!-- Delivery Icon: the owner's icons (Assets/Status/*.svg), 12 px tall. Each path is the SVG's own, placed
                             by the SVG's own transforms (its two groups' matrices, folded into one scale and offset) on a canvas
                             of the SVG's view box -->
                        <Grid VerticalAlignment="Center">

                            <!-- Sending: a stopwatch -->
                            <Viewbox
                                Height="12"
                                Visibility="{x:Bind local:MessageBubble.ShownFor(Bubble.StatusIcon, '1'), Mode=OneWay, FallbackValue=Collapsed}">
                                <Canvas Width="20" Height="24">
