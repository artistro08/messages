                            <!-- This element gives the status words to screen readers and the tests. It draws
                                 nothing. -->
                            <TextBlock
                                AutomationProperties.AccessibilityView="Content"
                                AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Status.', Bubble.PartKey), Mode=OneWay}"
                                AutomationProperties.LiveSetting="Polite"
                                AutomationProperties.Name="{x:Bind Bubble.StatusText, Mode=OneWay, FallbackValue=''}" />
                        </Grid>

                        <!-- The SMS label Sms.{id} takes the place of the delivery icon for a message sent as SMS or
                             MMS. The status name above still says Sent or Delivered. -->
                        <TextBlock
                            x:Name="StatusSms"
                            x:Load="{x:Bind Bubble.ShowsSmsLabel, Mode=OneWay, FallbackValue=False}"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Sms.', Bubble.PartKey), Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind local:MessageBubble.SmsText}" />

                        <!-- The lock shows that the chat is end-to-end encrypted. -->
                        <FontIcon
                            x:Name="StatusLock"
                            x:Load="{x:Bind Bubble.ShowsLock, Mode=OneWay, FallbackValue=False}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind local:MessageBubble.EncryptedText}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE72E;"
                            ToolTipService.ToolTip="{x:Bind local:MessageBubble.EncryptedText}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- A system line shows the name change of a group in the words of Google. It is small, centered and gray, in
             place of a bubble. -->
        <TextBlock
            x:Name="SystemLine"
            x:Load="{x:Bind Bubble.IsSystemLine, Mode=OneWay, FallbackValue=False}"
            Margin="24,8"
            HorizontalAlignment="Center"
            AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Line.', Bubble.PartKey), Mode=OneWay}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind Bubble.Text, Mode=OneWay}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
