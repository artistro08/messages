                                            <CompositeTransform
                                                ScaleX="2.085664"
                                                ScaleY="2.085664"
                                                TranslateX="-421.569297"
                                                TranslateY="-579.115477" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Canvas>
                            </Viewbox>

                            <!-- Sent: a check in a ring -->
                            <Viewbox
                                Height="12"
                                Visibility="{x:Bind local:MessageBubble.ShownFor(Bubble.StatusIcon, '2'), Mode=OneWay, FallbackValue=Collapsed}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M360.495,229.539C367.791,229.539 373.715,235.462 373.715,242.759C373.715,250.055 367.791,255.979 360.495,255.979C353.198,255.979 347.275,250.055 347.275,242.759C347.275,235.462 353.198,229.539 360.495,229.539ZM360.495,231.737C354.412,231.737 349.473,236.676 349.473,242.759C349.473,248.841 354.412,253.78 360.495,253.78C366.577,253.78 371.516,248.841 371.516,242.759C371.516,236.676 366.577,231.737 360.495,231.737ZM353.232,244.628C352.799,244.203 352.792,243.506 353.217,243.073C353.642,242.64 354.339,242.634 354.772,243.059L357.87,246.1L365.591,238.052C366.011,237.614 366.708,237.6 367.146,238.02C367.583,238.44 367.598,239.136 367.178,239.574L358.687,248.424C358.483,248.636 358.204,248.758 357.91,248.762C357.616,248.767 357.333,248.653 357.123,248.447L353.232,244.628Z" Fill="{ThemeResource TextFillColorSecondaryBrush}">
