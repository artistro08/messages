                                            <CompositeTransform
                                                ScaleX="0.87531"
                                                ScaleY="0.87531"
                                                TranslateX="-303.749258"
                                                TranslateY="-200.216764" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Canvas>
                            </Viewbox>

                            <!-- Delivered: two checks in rings -->
                            <Viewbox
                                Height="12"
                                Visibility="{x:Bind local:MessageBubble.ShownFor(Bubble.StatusIcon, '3'), Mode=OneWay, FallbackValue=Collapsed}">
                                <Canvas Width="38" Height="24">
                                    <Path Data="M360.495,229.539C367.791,229.539 373.715,235.462 373.715,242.759C373.715,250.055 367.791,255.979 360.495,255.979C353.198,255.979 347.275,250.055 347.275,242.759C347.275,235.462 353.198,229.539 360.495,229.539ZM360.495,231.737C354.412,231.737 349.473,236.676 349.473,242.759C349.473,248.841 354.412,253.78 360.495,253.78C366.577,253.78 371.516,248.841 371.516,242.759C371.516,236.676 366.577,231.737 360.495,231.737ZM353.232,244.628C352.799,244.203 352.792,243.506 353.217,243.073C353.642,242.64 354.339,242.634 354.772,243.059L357.87,246.1L365.591,238.052C366.011,237.614 366.708,237.6 367.146,238.02C367.583,238.44 367.598,239.136 367.178,239.574L358.687,248.424C358.483,248.636 358.204,248.758 357.91,248.762C357.616,248.767 357.333,248.653 357.123,248.447L353.232,244.628ZM350.093,254.38C348.219,255.399 346.072,255.979 343.79,255.979C336.494,255.979 330.571,250.055 330.571,242.759C330.571,235.462 336.494,229.539 343.79,229.539C346.072,229.539 348.219,230.118 350.093,231.137C349.521,231.649 348.988,232.202 348.497,232.792C347.07,232.116 345.474,231.737 343.79,231.737C337.708,231.737 332.769,236.676 332.769,242.759C332.769,248.841 337.708,253.78 343.79,253.78C345.474,253.78 347.07,253.402 348.497,252.726C348.988,253.316 349.521,253.869 350.093,254.38ZM345.084,245.192L341.982,248.424C341.779,248.636 341.499,248.758 341.206,248.762C340.912,248.767 340.629,248.653 340.419,248.447L336.528,244.628C336.095,244.203 336.088,243.506 336.513,243.073C336.938,242.64 337.635,242.634 338.068,243.059L341.166,246.1L344.904,242.203C344.898,242.387 344.895,242.573 344.895,242.759C344.895,243.586 344.959,244.399 345.084,245.192Z" Fill="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Path.RenderTransform>
                                            <CompositeTransform
                                                ScaleX="0.87531"
                                                ScaleY="0.87531"
                                                TranslateX="-289.151299"
                                                TranslateY="-200.730342" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Canvas>
                            </Viewbox>

                            <!-- Read: two filled circles with the checks cut out -->
                            <Viewbox
                                Height="12"
                                Visibility="{x:Bind local:MessageBubble.ShownFor(Bubble.StatusIcon, '4'), Mode=OneWay, FallbackValue=Collapsed}">
                                <Canvas Width="39" Height="24">
                                    <Path Data="M360.495,229.539C367.791,229.539 373.715,235.462 373.715,242.759C373.715,250.055 367.791,255.979 360.495,255.979C353.198,255.979 347.275,250.055 347.275,242.759C347.275,235.462 353.198,229.539 360.495,229.539ZM353.232,244.628L357.123,248.447C357.333,248.653 357.616,248.767 357.91,248.762C358.204,248.758 358.483,248.636 358.687,248.424L367.178,239.574C367.598,239.136 367.583,238.44 367.146,238.02C366.708,237.6 366.011,237.614 365.591,238.052L357.87,246.1L354.772,243.059C354.339,242.634 353.642,242.64 353.217,243.073C352.792,243.506 352.799,244.203 353.232,244.628ZM345.1,245.291C345.689,248.898 347.518,252.091 350.134,254.418C348.277,255.414 346.155,255.979 343.902,255.979C336.605,255.979 330.682,250.055 330.682,242.759C330.682,235.462 336.605,229.539 343.902,229.539C346.155,229.539 348.277,230.104 350.134,231.099C347.022,233.868 345.023,237.863 344.901,242.323L341.277,246.1L338.179,243.059C337.746,242.634 337.049,242.64 336.624,243.073C336.199,243.506 336.206,244.203 336.639,244.628L340.53,248.447C340.74,248.653 341.023,248.767 341.317,248.762C341.61,248.758 341.89,248.636 342.094,248.424L345.1,245.291Z" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}">
                                        <Path.RenderTransform>
                                            <CompositeTransform
                                                ScaleX="0.87531"
                                                ScaleY="0.87531"
                                                TranslateX="-288.575044"
                                                TranslateY="-200.730342" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Canvas>
                            </Viewbox>

                            <!-- Name: the status words for screen readers and the tests; draws nothing -->
                            <TextBlock
                                AutomationProperties.AccessibilityView="Content"
                                AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Status.', Bubble.Id, Bubble.TmpId), Mode=OneWay}"
                                AutomationProperties.LiveSetting="Polite"
                                AutomationProperties.Name="{x:Bind Bubble.StatusText, Mode=OneWay, FallbackValue=''}" />
                        </Grid>

                        <!-- Lock: end-to-end encrypted -->
                        <FontIcon
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind local:MessageBubble.EncryptedText}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE72E;"
                            ToolTipService.ToolTip="{x:Bind local:MessageBubble.EncryptedText}"
                            Visibility="{x:Bind Bubble.ShowsLock, Mode=OneWay, FallbackValue=Collapsed}" />
                    </StackPanel>
                    <!-- /Caption Row -->
                </StackPanel>
                <!-- /Captions -->
            </Grid>
            <!-- /Under The Bubble -->
        </StackPanel>
        <!-- /Bubble -->
    </Grid>
    <!-- /Row -->
</UserControl>
