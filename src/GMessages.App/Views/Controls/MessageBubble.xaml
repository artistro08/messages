<UserControl
    x:Class="GMessages.App.Views.Controls.MessageBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GMessages.App.Views.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:views="using:GMessages.App.Views"
    PointerCanceled="OnPointerLeft"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerLeft">

    <!-- The row holds the bubble. Received bubbles in a group chat have an avatar lane on the left. The avatar sits
         beside the last bubble of a group. Bubbles of 1 group sit 2 px apart, and groups sit further apart. The row is
         transparent, so a click anywhere on it shows the time. -->
    <Grid
        x:Name="Row"
        Background="Transparent"
        Margin="{x:Bind local:MessageBubble.GroupMargin(Bubble.IsFirstInGroup, Bubble.IsLastInGroup), Mode=OneWay}">

        <!-- Sent RCS sits on the right on a lighter shade of the accent color. Sent SMS sits on the right on the accent
             color. Received sits on the left on the card color. The reaction pill takes the bottom corner of the bubble
             toward the middle of the chat. That is bottom right on a received bubble and bottom left on a sent bubble,
             as the owner asked. PillHost binds the column and the margin of the pill. The time keeps the outer side of
             the bubble. The quote takes a tint that suits its bubble. The groups must stay on the root element of the
             control. GoToState looks only there, and on any element below it every state fails with no error. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Side">
                <VisualState x:Name="Received" />
                <VisualState x:Name="Sent">
                    <VisualState.Setters>
                        <Setter Target="Root.HorizontalAlignment" Value="Right" />
                        <Setter Target="BackRow.HorizontalAlignment" Value="Right" />
                        <Setter Target="BackFill.Background" Value="{ThemeResource RcsBubbleBrush}" />
                        <Setter Target="BackFill.BorderBrush" Value="{ThemeResource RcsBubbleBorderBrush}" />
                        <Setter Target="Body.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Setter Target="Under.HorizontalAlignment" Value="Right" />
                        <Setter Target="Captions.(Grid.Column)" Value="1" />
                        <Setter Target="Captions.HorizontalAlignment" Value="Right" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SentSms">
                    <VisualState.Setters>
                        <Setter Target="Root.HorizontalAlignment" Value="Right" />
                        <Setter Target="BackRow.HorizontalAlignment" Value="Right" />
                        <Setter Target="BackFill.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="BackFill.BorderThickness" Value="0" />
                        <Setter Target="Body.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="Under.HorizontalAlignment" Value="Right" />
                        <Setter Target="Captions.(Grid.Column)" Value="1" />
                        <Setter Target="Captions.HorizontalAlignment" Value="Right" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!-- Emoji alone show big, as issue #11 asked. Other text keeps the body size of the theme. -->
            <VisualStateGroup x:Name="TextSize">
                <VisualState x:Name="BodyText" />
                <VisualState x:Name="BigEmoji">
                    <VisualState.Setters>
                        <Setter Target="Body.FontSize" Value="32" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!-- The parts of a sent SMS bubble take the on-accent brushes. Through x:Load, the parts load only when the
                 message uses them. A setter would load its part, so each part has its own group. ShowPartStates goes to
                 that group only while the part is loaded. The hover strip binds its column with StripColumn for the
                 same reason. -->
            <VisualStateGroup x:Name="QuoteSide">
                <VisualState x:Name="QuotePlain" />
                <VisualState x:Name="QuoteOnAccent">
                    <VisualState.Setters>
                        <Setter Target="Quote.Background" Value="{ThemeResource QuoteOnAccentFillBrush}" />
                        <Setter Target="QuoteBar.Background" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="QuoteSender.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="QuoteText.Foreground" Value="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="FileSide">
                <VisualState x:Name="FilePlain" />
                <VisualState x:Name="FileOnAccent">
                    <VisualState.Setters>
                        <Setter Target="FileCard.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="FileDetail.Foreground" Value="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="VoiceSide">
                <VisualState x:Name="VoicePlain" />
                <VisualState x:Name="VoiceOnAccent">
                    <VisualState.Setters>
                        <Setter Target="VoicePlay.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="VoiceLength.Foreground" Value="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                        <Setter Target="VoiceBars.BarBrush" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="PreviewSide">
                <VisualState x:Name="PreviewPlain" />
                <VisualState x:Name="PreviewOnAccent">
                    <VisualState.Setters>
                        <Setter Target="PreviewCard.Background" Value="{ThemeResource QuoteOnAccentFillBrush}" />
                        <Setter Target="PreviewCard.BorderThickness" Value="0" />
                        <Setter Target="PreviewTitle.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="PreviewSite.Foreground" Value="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!-- My reaction gives the pill a soft accent fill and no ring. The brush is ReactionPillMineBrush in
                 App.xaml. The fill is under the button, so the hover of the button only tints it. ShowPartStates goes
                 to this group only while the pill is loaded. -->
            <VisualStateGroup x:Name="Reaction">
                <VisualState x:Name="NotMine" />
                <VisualState x:Name="Mine">
                    <VisualState.Setters>
                        <Setter Target="PillBack.Background" Value="{ThemeResource ReactionPillMineBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!-- React, reply and the ⋮ fade in while the pointer is over a bubble that takes them. See CanAct. The ⋮ of
                 the conversation row does the same. ShowHover goes to Shown only after the strip loads. -->
            <VisualStateGroup x:Name="Hover">
                <VisualStateGroup.Transitions>
                    <VisualTransition To="Shown">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverStrip" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame
                                    KeySpline="{StaticResource ControlFastOutSlowInKeySpline}"
                                    KeyTime="{StaticResource ControlFastAnimationDuration}"
                                    Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Hidden" />
                <VisualState x:Name="Shown">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="HoverStrip"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="0" />
                    </Storyboard>
                    <VisualState.Setters>
                        <Setter Target="HoverReact.IsHitTestVisible" Value="True" />
                        <Setter Target="HoverReply.IsHitTestVisible" Value="True" />
                        <Setter Target="HoverMore.IsHitTestVisible" Value="True" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!-- The ring around the back shows while the row of the bubble has keyboard or programmatic focus. The chat
                 pane sets the state. The names differ from Hidden and Shown of Hover, because GoToState finds a state
                 by name across groups. -->
            <VisualStateGroup x:Name="FocusRingStates">
                <VisualState x:Name="RingHidden" />
                <VisualState x:Name="RingShown">
                    <VisualState.Setters>
                        <Setter Target="FocusRing.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- The bubble shows the sender name, the quote, the text and the link preview on its colored back. The
             reaction pill sits on its bottom corner. Then come the time after a click or the retry link, and the
             caption row under my newest message. The caption row holds the time, the delivery icon and the lock. The
             bubble is as wide as its content, up to 70% of the chat and 560 px at most. The code sets that cap. The
             padding keeps the space of the avatar lane and the hover strip on their sides. -->
        <StackPanel
            x:Name="Root"
            Padding="{x:Bind local:MessageBubble.LanePadding(Bubble.HasAvatarLane, Bubble.FromMe), Mode=OneWay}"
            HorizontalAlignment="Left"
            Spacing="2"
            Visibility="{x:Bind views:MainWindow.HiddenIf(Bubble.IsSystemLine), Mode=OneWay, FallbackValue=Visible}">

            <!-- The chat pane has 1 bubble menu, BubbleMenu, for every bubble. The right-click, Application key and
                 Shift + F10 handling of the pane opens it. The ⋮ of the hover strip and MenuRequested open it too. -->

            <!-- The sender shows on the first bubble of a received group in a group chat. Its color is the color of
                 the letter circle. -->
            <TextBlock
                Margin="12,0"
                FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                Foreground="{x:Bind local:ColorConverters.ToBrush(Bubble.SenderColor), Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Bubble.SenderName, Mode=OneWay, TargetNullValue=''}"
                Visibility="{x:Bind Bubble.HasSenderName, Mode=OneWay, FallbackValue=Collapsed}" />

            <!-- The back sits in a row with the avatar lane and the hover strip. Both extend into the padding of the
                 row. Thus the avatar sits beside the bubble itself, and their bottoms align. It does not sit beside the
                 pill, the time or the caption row. The strip sits beside the back, centered on it. The Side states keep
                 the row at its own width on the outer side of the bubble. Thus a wider time or caption row under a
                 short message never stretches the back past its text. -->
            <Grid
                x:Name="BackRow"
                Margin="{x:Bind local:MessageBubble.LaneOverhang(Bubble.HasAvatarLane, Bubble.FromMe), Mode=OneWay}"
                HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The lane holds the avatar of the sender at the last bubble of the group. x:Load makes the avatar
                     only where it shows. -->
                <Grid Width="{x:Bind local:MessageBubble.LaneWidth(Bubble.HasAvatarLane), Mode=OneWay}">
                    <Viewbox
                        x:Name="SenderAvatar"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        x:Load="{x:Bind Bubble.ShowsAvatar, Mode=OneWay, FallbackValue=False}">
                        <local:Avatar
                            Color="{x:Bind Bubble.SenderColor, Mode=OneWay, FallbackValue=0}"
                            Initial="{x:Bind Bubble.AvatarInitial, Mode=OneWay, FallbackValue=''}"
                            PhotoId="{x:Bind Bubble.AvatarPhotoId, Mode=OneWay, FallbackValue=''}" />
                    </Viewbox>
                </Grid>

                <!-- The fill gives the bubble its color and edge behind its content. A photo or video with nothing else
                     in its bubble hides the fill. Its own edge is then the edge of the bubble, with no fill or stroke
                     around it. Emoji alone also hide the fill. -->
                <Border
                    x:Name="BackFill"
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{x:Bind local:MessageBubble.CornersOf(Bubble.FromMe, Bubble.IsFirstInGroup, Bubble.IsLastInGroup), Mode=OneWay}"
                    Visibility="{x:Bind local:MessageBubble.FillShown(Bubble.FillsBubble, Bubble.HasBodyText, Bubble.HasQuote, Bubble.IsEmojiOnly), Mode=OneWay, FallbackValue=Collapsed}" />

                <!-- A click on the back shows or hides the time. -->
                <Border
                    x:Name="Back"
                    Grid.Column="1"
                    Padding="{x:Bind local:MessageBubble.BackPadding(Bubble.FillsBubble, Bubble.IsEmojiOnly), Mode=OneWay}"
                    Background="Transparent"
                    CornerRadius="{x:Bind local:MessageBubble.CornersOf(Bubble.FromMe, Bubble.IsFirstInGroup, Bubble.IsLastInGroup), Mode=OneWay}">
                    <StackPanel>

                        <!-- The quote shows the message that this message answers. It sits on a tint of the bubble
                             color, after an accent bar. The sender is in caption style, with at most 2 lines of text. A
                             click, Enter or Space jumps to the quoted message. The chat finds it, pages older messages
                             when needed, and pulses it. The hand shows over the quote, as over a link. IconButtonStyle
                             gives no hover or press fill, so the quote keeps its own tint. -->
                        <local:LinkCardButton
                            x:Name="QuoteButton"
                            Margin="-4,0,-4,6"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('QuoteJump.', Bubble.PartKey), Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind local:MessageBubble.QuoteJumpText}"
                            x:Load="{x:Bind Bubble.HasQuote, Mode=OneWay, FallbackValue=False}"
                            Click="OnQuoteClick"
                            CornerRadius="8"
                            Loaded="OnPartLoaded"
                            Style="{StaticResource IconButtonStyle}">
                            <Grid
                                x:Name="Quote"
                                Padding="0,0,8,0"
                                Background="{ThemeResource QuoteFillBrush}"
                                ColumnSpacing="8"
                                CornerRadius="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="QuoteBar"
                                    Width="3"
                                    Background="{ThemeResource QuoteBarBrush}" />

                                <!-- Quoted media shows its thumbnail or a file icon left of 2 lines. The sender is
                                     semibold, and "Image", "Video" or "GIF" is italic. A file shows its name. -->
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <local:MediaThumb
                                        Margin="0,6,8,6"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('QuoteThumb.', Bubble.PartKey), Mode=OneWay}"
                                        Media="{x:Bind Bubble.QuoteMedia, Mode=OneWay}"
                                        Visibility="{x:Bind Bubble.HasQuoteMedia, Mode=OneWay, FallbackValue=Collapsed}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Padding="0,6"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="QuoteSender"
                                            FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                                            FontWeight="{x:Bind local:MessageBubble.QuoteSenderWeight(Bubble.HasQuoteMedia), Mode=OneWay}"
                                            MaxLines="1"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Bubble.QuoteSender, Mode=OneWay, FallbackValue=''}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind views:UiHelpers.ShownIfText(Bubble.QuoteSender), Mode=OneWay, FallbackValue=Collapsed}" />
                                        <TextBlock
                                            x:Name="QuoteText"
                                            AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Quote.', Bubble.PartKey), Mode=OneWay}"
                                            FontStyle="{x:Bind local:MessageBubble.LabelStyle(Bubble.QuoteIsLabel), Mode=OneWay}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="2"
                                            Text="{x:Bind Bubble.QuoteText, Mode=OneWay, FallbackValue=''}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </local:LinkCardButton>

                        <!-- The photo fills the bubble from edge to edge, rounded to its corners. The thumbnail shows
                             first, decoded tiny and stretched, so it looks blurred. Then the full image fades in over
                             it. The code sets the size from the dimensions of the photo before anything loads, so
                             nothing moves when it arrives. A click opens it in the photo viewer of the window, or tries
                             again after a failure. Its name is its caption, else "Photo". -->
                        <Button
                            x:Name="Photo"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            BorderThickness="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Bubble.Photo.', Bubble.PartKey), Mode=OneWay}"
                            x:Load="{x:Bind Bubble.HasPhoto, Mode=OneWay, FallbackValue=False}"
                            AutomationProperties.Name="{x:Bind Bubble.PhotoName, Mode=OneWay, FallbackValue=''}"
                            Click="OnPhotoClick"
                            CornerRadius="{x:Bind local:MessageBubble.PhotoCorners(Bubble.FromMe, Bubble.IsFirstInGroup, Bubble.IsLastInGroup, Bubble.HasBodyText), Mode=OneWay}"
                            Style="{StaticResource IconButtonStyle}">
                            <Grid>
                                <Border x:Name="PhotoBlur" CornerRadius="{x:Bind local:MessageBubble.PhotoCorners(Bubble.FromMe, Bubble.IsFirstInGroup, Bubble.IsLastInGroup, Bubble.HasBodyText), Mode=OneWay}" />
                                <!-- A still photo is the ImageBrush of this layer, and the corners of the layer clip
                                     it. A GIF is the Image. A brush shows only the first frame of a GIF, and an Image
                                     plays it. The code clips the Image to the corners of the photo. The Image is on a
                                     Canvas, and the code gives it the size of the Canvas. An Image with UniformToFill
                                     asks for all the width of the row. A GIF with no caption then made its bubble full
                                     width and cut the GIF. -->
                                <Border
                                    x:Name="PhotoFull"
                                    CornerRadius="{x:Bind local:MessageBubble.PhotoCorners(Bubble.FromMe, Bubble.IsFirstInGroup, Bubble.IsLastInGroup, Bubble.HasBodyText), Mode=OneWay}"
                                    Opacity="0">
                                    <Canvas SizeChanged="OnPhotoFullCanvasSizeChanged">
                                        <Image
                                            x:Name="PhotoFullImage"
                                            Loaded="OnPhotoFullLoaded"
                                            SizeChanged="OnPhotoFullSizeChanged"
                                            Stretch="UniformToFill" />
                                    </Canvas>
                                </Border>

                                <!-- The note shows the wait for the phone or the failure on a small plate over the
                                     photo. After a failure, a click tries again. -->
                                <Border
                                    x:Name="PhotoNoteBack"
                                    Margin="12"
                                    Padding="8,4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="PhotoNote"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- The video fills the bubble from edge to edge as a photo does. The code sets its size from
                             its dimensions, and it has the corners of the bubble. Its still frame is the thumbnail from
                             the phone, else a frame that the app makes from the video. A plain fill shows until the
                             frame loads, with a play button over it. A click on the frame opens the viewer of the
                             window. The play button plays the video here with sound and compact controls: play or
                             pause, seek and volume. The code makes the player in VideoHost. The expand button then
                             opens the viewer at the same position. The frame is named by the caption, else "Video".
                             LinkCardButton shows the hand cursor over it. -->
                        <Grid
                            x:Name="Video"
                            x:Load="{x:Bind Bubble.HasVideo, Mode=OneWay, FallbackValue=False}"
                            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                            CornerRadius="{x:Bind local:MessageBubble.PhotoCorners(Bubble.FromMe, Bubble.IsFirstInGroup, Bubble.IsLastInGroup, Bubble.HasBodyText), Mode=OneWay}">
                            <local:LinkCardButton
                                x:Name="VideoFrame"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Bubble.Video.', Bubble.PartKey), Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind Bubble.VideoName, Mode=OneWay, FallbackValue=''}"
                                BorderThickness="0"
                                Click="OnVideoFrameClick"
                                CornerRadius="{x:Bind local:MessageBubble.PhotoCorners(Bubble.FromMe, Bubble.IsFirstInGroup, Bubble.IsLastInGroup, Bubble.HasBodyText), Mode=OneWay}"
                                Style="{StaticResource IconButtonStyle}">
                                <Border
                                    x:Name="VideoThumb"
                                    CornerRadius="{x:Bind local:MessageBubble.PhotoCorners(Bubble.FromMe, Bubble.IsFirstInGroup, Bubble.IsLastInGroup, Bubble.HasBodyText), Mode=OneWay}" />
                            </local:LinkCardButton>

                            <!-- The play button sits on a round plate over the middle of the frame. It has no border.
                                 The 1 px border of the button would shrink its content to 46 px. That would cut the
                                 right and the bottom of the 48 px plate. -->
                            <Button
                                x:Name="VideoPlay"
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderThickness="0"
                                AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Video.Play.', Bubble.PartKey), Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind local:MessageBubble.PlayVideoText}"
                                Click="OnVideoPlayClick"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind local:MessageBubble.PlayVideoText}">
                                <Grid>
                                    <Ellipse
                                        Width="48"
                                        Height="48"
                                        Fill="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
                                    <FontIcon FontSize="20" Glyph="&#xE768;" />
                                </Grid>
                            </Button>

                            <!-- The frames of the playing video draw here as the picture of a box with the corners of
                                 the bubble. The own picture of the player draws on its own layer, above everything that
                                 the chat draws. No clip applies to that layer. Thus in the installed app of the owner,
                                 the video played square. The compact controls of the player sit over the picture. The
                                 code adds and removes them. -->
                            <Grid
                                x:Name="VideoHost"
                                CornerRadius="{x:Bind local:MessageBubble.PhotoCorners(Bubble.FromMe, Bubble.IsFirstInGroup, Bubble.IsLastInGroup, Bubble.HasBodyText), Mode=OneWay}">
                                <Image
                                    x:Name="VideoPicture"
                                    SizeChanged="OnVideoPictureSizeChanged"
                                    Stretch="Uniform" />
                            </Grid>

                            <!-- While the video plays, the expand button opens it in the viewer at the same
                                 position. -->
                            <Button
                                x:Name="VideoExpand"
                                Width="32"
                                Height="32"
                                Margin="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                BorderThickness="0"
                                AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Video.Expand.', Bubble.PartKey), Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind local:MessageBubble.OpenVideoText}"
                                Click="OnVideoExpandClick"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind local:MessageBubble.OpenVideoText}"
                                Visibility="Collapsed">
                                <Grid>
                                    <Ellipse
                                        Width="32"
                                        Height="32"
                                        Fill="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
                                    <FontIcon FontSize="14" Glyph="&#xE740;" />
                                </Grid>
                            </Button>

                            <!-- The note shows the download or the failure on a small plate at the bottom. -->
                            <Border
                                x:Name="VideoNoteBack"
                                Margin="12"
                                Padding="8,4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                CornerRadius="4"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="VideoNote"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Border>
                        </Grid>

                        <!-- The file card shows a video or a file with its thumbnail, else the icon of its type. It
                             also shows the name and the size as Explorer writes it. While the file opens,
                             "Downloading…" or the failure takes the place of the size. A click, Enter or Space
                             downloads the file and opens it in its default app. The card is named by the file name. -->
                        <Button
                            x:Name="FileCard"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Bubble.File.', Bubble.PartKey), Mode=OneWay}"
                            x:Load="{x:Bind Bubble.HasFileCard, Mode=OneWay, FallbackValue=False}"
                            AutomationProperties.Name="{x:Bind Bubble.FileName, Mode=OneWay, FallbackValue=''}"
                            Click="OnFileClick"
                            Loaded="OnPartLoaded"
                            Style="{StaticResource IconButtonStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Width="40"
                                    Height="40"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <FontIcon FontSize="20" Glyph="{x:Bind local:MessageBubble.FileGlyph(Bubble.Kind), Mode=OneWay, FallbackValue=''}" />
                                    <Border x:Name="FileThumb" CornerRadius="6" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        MaxLines="1"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Bubble.FileName, Mode=OneWay, FallbackValue=''}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="FileDetail"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- The voice message shows play or pause, the waveform and the length. The waveform fills as
                             the message plays, and a click on it seeks. The length comes from the audio after the
                             download. The length is named Bubble.Voice.{id}. -->
                        <Grid
                            x:Name="Voice"
                            x:Load="{x:Bind Bubble.HasVoice, Mode=OneWay, FallbackValue=False}"
                            ColumnSpacing="8"
                            Loaded="OnPartLoaded">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="VoicePlay"
                                Width="32"
                                Height="32"
                                Margin="-6,0,0,0"
                                AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Voice.Play.', Bubble.PartKey), Mode=OneWay}"
                                Click="OnVoicePlayClick"
                                Style="{StaticResource IconButtonStyle}">
                                <FontIcon x:Name="VoiceGlyph" FontSize="16" />
                            </Button>
                            <local:Waveform
                                x:Name="VoiceBars"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Voice.Wave.', Bubble.PartKey), Mode=OneWay}"
                                BarBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                SeekRequested="OnVoiceSeekRequested" />
                            <TextBlock
                                x:Name="VoiceLength"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Bubble.Voice.', Bubble.PartKey), Mode=OneWay}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>

                        <!-- The upload bar shows how much of my photo or file is up while it sends from here. -->
                        <muxc:ProgressBar
                            x:Name="UploadBar"
                            Margin="10,6"
                            x:Load="{x:Bind Bubble.IsUploading, Mode=OneWay, FallbackValue=False}"
                            AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Upload.', Bubble.PartKey), Mode=OneWay}"
                            Maximum="100"
                            Value="{x:Bind Bubble.UploadPercent, Mode=OneWay, FallbackValue=0}" />

                        <!-- While the preview card shows, the text omits the link of the card. See
                             Bubble.BodyText. A message that was only the link shows the card alone. The BigEmoji state
                             shows emoji alone big. -->
                        <Grid
                            Margin="{x:Bind local:MessageBubble.CaptionMargin(Bubble.FillsBubble), Mode=OneWay}"
                            Visibility="{x:Bind Bubble.HasBodyText, Mode=OneWay, FallbackValue=Collapsed}">
                            <TextBlock
                                x:Name="Body"
                                AutomationProperties.AutomationId="{x:Bind local:MessageBubble.AutomationIdOf(Bubble.PartKey), Mode=OneWay}"
                                AutomationProperties.ItemType="{x:Bind Bubble.ItemTypeName, Mode=OneWay, FallbackValue=''}"
                                IsTextSelectionEnabled="True"
                                IsColorFontEnabled="True"
                                SizeChanged="OnBodySizeChanged"
                                TextWrapping="Wrap" />

                            <!-- Clear strips cover the empty space at the end of each line where a link ends. Thus the
                                 pointer there is never over the link. The text maps the empty end of a line to its last
                                 letter. BlockLinkEnds sets the strips. A tap on a strip still reaches the bubble. -->
                            <Canvas x:Name="LinkBlockers" />
                        </Grid>

                        <!-- The preview shows the page image, its title in 2 lines at most, and its site in caption
                             style. A click, Enter or Space opens the link in the default browser. The card is named by
                             its title and the host of the link. A right-click, the Application key or Shift + F10 opens
                             its own menu with Copy link. That menu is PreviewMenu of the chat pane, which finds the
                             card by its name. The look of the card is on PreviewCard. IconButtonStyle gives the button
                             no hover or press fill. Thus the card never flashes another color under the pointer, as the
                             owner reported. Through LinkCardButton, the hand cursor shows over it, as over a link. -->
                        <local:LinkCardButton
                            x:Name="Preview"
                            Margin="{x:Bind local:MessageBubble.PreviewMargin(Bubble.HasBodyText), Mode=OneWay}"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            x:Load="{x:Bind Bubble.HasPreview, Mode=OneWay, FallbackValue=False}"
                            AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Preview.', Bubble.PartKey), Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Bubble.PreviewName, Mode=OneWay, FallbackValue=''}"
                            Click="OnPreviewClick"
                            CornerRadius="8"
                            Loaded="OnPartLoaded"
                            Style="{StaticResource IconButtonStyle}">
                            <Border
                                x:Name="PreviewCard"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel MaxWidth="240">
                                    <Image
                                        x:Name="PreviewImage"
                                        MaxWidth="240"
                                        Stretch="Uniform"
                                        Visibility="Collapsed" />
                                    <StackPanel Padding="10,6,10,8" Spacing="2">
                                        <TextBlock
                                            x:Name="PreviewTitle"
                                            FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                                            MaxLines="2"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Bubble.Preview.Title, Mode=OneWay, FallbackValue=''}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="PreviewSite"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="1"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Bubble.Preview.Site, Mode=OneWay, FallbackValue=''}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </local:LinkCardButton>
                    </StackPanel>
                </Border>

                <!-- The focus ring hugs the back 3 px out and follows its corners, also on photos, cards and grouped
                     bubbles. It is a 2 px ring in the accent color, with a 1 px gap inside it. The owner found the
                     white focus stroke of Windows too glaring. The accent ring still shows clearly on every bubble
                     color. It draws only while the row has keyboard focus. See FocusRingStates. It never draws in
                     high contrast, where the system focus visual of the row shows instead. It takes no clicks. -->
                <Border
                    x:Name="FocusRing"
                    Grid.Column="1"
                    Margin="-3"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="{x:Bind local:MessageBubble.RingCorners(Bubble.FromMe, Bubble.IsFirstInGroup, Bubble.IsLastInGroup, 3), Mode=OneWay}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />

                <!-- The hover strip holds react, reply and the ⋮. See Hover above. It sits right of a received back and
                     left of a sent back. Its slot is always there with the width of the strip, StripWidth from
                     HoverStripWidth. Thus no bubble moves when the strip shows. The slot is as tall as the back and
                     transparent. Thus the pointer stays on the bubble on its way to the buttons. LoadHoverStrip loads
                     the strip on the first hover or keyboard focus of the bubble. The buttons are not tab stops,
                     because the keyboard has the bubble menu, Shift + + and Ctrl + Enter. -->
                <Grid
                    Grid.Column="{x:Bind local:MessageBubble.StripColumn(Bubble.FromMe), Mode=OneWay, FallbackValue=2}"
                    Width="{x:Bind local:MessageBubble.StripWidth}"
                    Background="Transparent">
                    <StackPanel
                        x:Name="HoverStrip"
                        Padding="4,0"
                        x:Load="False"
                        Background="Transparent"
                        Opacity="0"
                        Orientation="Horizontal">
                        <Button
                            x:Name="HoverReact"
                            Width="32"
                            Height="32"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('HoverReact.', Bubble.PartKey), Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind local:MessageBubble.ReactText}"
                            Click="OnHoverReactClick"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind local:MessageBubble.ReactText}">
                            <FontIcon FontSize="16" Glyph="&#xE76E;" />
                        </Button>
                        <Button
                            x:Name="HoverReply"
                            Width="32"
                            Height="32"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('HoverReply.', Bubble.PartKey), Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind local:MessageBubble.ReplyText}"
                            Click="OnHoverReplyClick"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind local:MessageBubble.ReplyText}">
                            <FontIcon FontSize="16" Glyph="&#xE97A;" />
                        </Button>
                        <Button
                            x:Name="HoverMore"
                            Width="32"
                            Height="32"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('HoverMore.', Bubble.PartKey), Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind local:MessageBubble.MoreOptionsText}"
                            Click="OnHoverMoreClick"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind local:MessageBubble.MoreOptionsText}">
                            <FontIcon FontSize="16" Glyph="&#xE712;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Under the bubble, the reaction pill sits on the bottom corner toward the middle of the chat. On a
                 received bubble, that is bottom right in the right column. On a sent bubble, it is bottom left in the
                 left column. The time or the caption row sits on the outer side: the left of a received bubble, the
                 right of a sent bubble. The code makes this row at least as wide as the back. Thus the pill sits on the
                 corner of the back. When the time is wider than the room beside the pill, LayPill moves the pill back
                 onto the corner. The time then drops below it. -->
            <Grid
                x:Name="Under"
                Margin="12,0"
                HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The reactions show in a pill over the bottom corner of the bubble. In every chat, a click, Enter or
                     Space lists who reacted. The code builds that list, and the pill never opens the reaction picker.
                     The pill has a whole-pixel height of 24, more for large text, and corners of half of it. Its fill
                     is under the stroke. Thus the ends draw as smooth half circles at any scale. Its top 8 px overlap
                     the back, and it keeps 6 px from the time. -->
                <Grid
                    x:Name="PillHost"
                    Grid.Column="{x:Bind local:MessageBubble.PillColumn(Bubble.FromMe), Mode=OneWay}"
                    Margin="{x:Bind local:MessageBubble.PillMargin(Bubble.FromMe), Mode=OneWay}"
                    VerticalAlignment="Top"
                    x:Load="{x:Bind Bubble.HasReactions, Mode=OneWay, FallbackValue=False}"
                    Loaded="OnPillHostLoaded"
                    SizeChanged="OnPillHostSizeChanged">

                    <!-- LayPill moves the pill with this shift, for example onto the corner of a short bubble. -->
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="PillShift" />
                    </Grid.RenderTransform>

                    <!-- The fill of the pill is under the button. Thus the hover and press of the button only tint it,
                         and the accent of my reaction stays through them. The Mine state sets that accent. On the
                         button, the fill changed to the hover fill on every hover. The 83 ms brush transition of the
                         button made that change flicker. -->
                    <Border
                        x:Name="PillBack"
                        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                        CornerRadius="12"
                        UseLayoutRounding="True" />
                    <Button
                        x:Name="Pill"
                        MinHeight="24"
                        Padding="8,0"
                        VerticalContentAlignment="Center"
                        AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Reactions.', Bubble.PartKey), Mode=OneWay}"
                        Background="Transparent"
                        BackgroundSizing="OuterBorderEdge"
                        BorderBrush="{ThemeResource ReactionPillBorderBrush}"
                        BorderThickness="1"
                        Click="OnPillClick"
                        Content="{x:Bind Bubble.ReactionsText, Mode=OneWay, FallbackValue=''}"
                        CornerRadius="12"
                        FontSize="12"
                        UseLayoutRounding="True">

                        <!-- The hover and press fills are see-through tints over the fill. Thus the brush transition
                             runs from clear to a faint tint, never through a bright gray. The pill has no outline,
                             because the 1 px border is clear. See ReactionPillBorderBrush in App.xaml. The fill runs
                             under the border, so the pill keeps its size. High contrast keeps an edge and the own hover
                             and press colors of the system button. Thus the pill and its hover still show. -->
                        <Button.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Light">
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Button.Resources>
                    </Button>
                </Grid>

                <!-- The time, the retry link or the caption row sits on the outer side of the bubble. -->
                <StackPanel x:Name="Captions" Spacing="2">

                    <!-- The time is hidden until a click on the bubble. It has the lock on an encrypted RCS message.
                         The retry link takes its place when the send failed. -->
                    <Grid x:Name="Footer">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{x:Bind local:MessageBubble.TimeVisibility(Bubble.IsTimeShown, Bubble.IsFailed, Bubble.ShowsStatusRow), Mode=OneWay}">
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="{x:Bind local:MessageBubble.TimeIdOf(Bubble.PartKey), Mode=OneWay}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Bubble.Time, Mode=OneWay}" />
                            <FontIcon
                                x:Name="TimeLock"
                                x:Load="{x:Bind Bubble.ShowsLock, Mode=OneWay, FallbackValue=False}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind local:MessageBubble.EncryptedText}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE72E;"
                                ToolTipService.ToolTip="{x:Bind local:MessageBubble.EncryptedText}" />
                        </StackPanel>

                        <!-- A failed send shows a red error mark before the retry link. -->
                        <StackPanel
                            x:Name="FailedFooter"
                            x:Load="{x:Bind Bubble.IsFailed, Mode=OneWay, FallbackValue=False}"
                            Orientation="Horizontal"
                            Spacing="4">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xE783;" />
                            <HyperlinkButton
                                Padding="0"
                                AutomationProperties.AutomationId="{x:Bind local:MessageBubble.RetryIdOf(Bubble.PartKey), Mode=OneWay}"
                                Click="OnRetryClick"
                                Content="{x:Bind Bubble.NotSentText, Mode=OneWay, FallbackValue=''}"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- The caption row shows only under the newest bubble of the chat, until a click on it. It shows
                         the time Caption.{id}. On my bubble, the delivery icon follows. The icon is a stopwatch while
                         sending and a check in a ring when sent. It is 2 checks in rings when delivered and 2 filled
                         circles when read. In an encrypted chat, the lock follows. The icon is drawn, not text. Its
                         name Status.{id} is "Sent", "Delivered" or "Read" for screen readers. -->
                    <StackPanel
                        x:Name="StatusRow"
                        x:Load="{x:Bind Bubble.ShowsStatusRow, Mode=OneWay, FallbackValue=False}"
                        Orientation="Horizontal"
                        Spacing="4">
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="{x:Bind local:MessageBubble.PartIdOf('Caption.', Bubble.PartKey), Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Bubble.Time, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="&#x00B7;"
                            Visibility="{x:Bind Bubble.ShowsCaptionDot, Mode=OneWay, FallbackValue=Collapsed}" />

                        <!-- The delivery icons of the owner come from Assets/Status/*.svg and are 12 px tall. Each path
                             is the own path of the SVG on a canvas of its view box. The own transforms of the SVG place
                             it. The matrices of its 2 groups fold into 1 scale and offset. -->
                        <Grid VerticalAlignment="Center">

                            <!-- Sending shows a stopwatch. -->
                            <Viewbox
                                Height="12"
                                Visibility="{x:Bind local:MessageBubble.ShownFor(Bubble.StatusIcon, '1'), Mode=OneWay, FallbackValue=Collapsed}">
                                <Canvas Width="20" Height="24">
                                    <Path Data="M210.356,281.588C211.001,282.376 211.388,283.383 211.388,284.48C211.388,287.002 209.339,289.051 206.817,289.051C204.294,289.051 202.245,287.002 202.245,284.48C202.245,281.957 204.294,279.908 206.817,279.908C207.872,279.908 208.845,280.267 209.619,280.869L210.268,280.093C210.45,279.875 210.774,279.846 210.991,280.028C211.208,280.209 211.237,280.533 211.056,280.751L210.356,281.588ZM206.817,280.935C204.86,280.935 203.272,282.523 203.272,284.48C203.272,286.436 204.86,288.024 206.817,288.024C208.773,288.024 210.361,286.436 210.361,284.48C210.361,282.523 208.773,280.935 206.817,280.935ZM206.303,282.053C206.303,281.77 206.533,281.54 206.817,281.54C207.1,281.54 207.33,281.77 207.33,282.053L207.33,284.48C207.33,284.763 207.1,284.993 206.817,284.993C206.533,284.993 206.303,284.763 206.303,284.48L206.303,282.053ZM205.132,279.027C204.849,279.027 204.619,278.797 204.619,278.514C204.619,278.231 204.849,278.001 205.132,278.001L208.34,278.001C208.623,278.001 208.853,278.231 208.853,278.514C208.853,278.797 208.623,279.027 208.34,279.027L205.132,279.027Z" Fill="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Path.RenderTransform>
                                            <CompositeTransform
                                                ScaleX="2.085664"
                                                ScaleY="2.085664"
                                                TranslateX="-421.569297"
                                                TranslateY="-579.115477" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Canvas>
                            </Viewbox>

                            <!-- Sent shows a check in a ring. -->
                            <Viewbox
                                Height="12"
                                Visibility="{x:Bind local:MessageBubble.ShownFor(Bubble.StatusIcon, '2'), Mode=OneWay, FallbackValue=Collapsed}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M360.495,229.539C367.791,229.539 373.715,235.462 373.715,242.759C373.715,250.055 367.791,255.979 360.495,255.979C353.198,255.979 347.275,250.055 347.275,242.759C347.275,235.462 353.198,229.539 360.495,229.539ZM360.495,231.737C354.412,231.737 349.473,236.676 349.473,242.759C349.473,248.841 354.412,253.78 360.495,253.78C366.577,253.78 371.516,248.841 371.516,242.759C371.516,236.676 366.577,231.737 360.495,231.737ZM353.232,244.628C352.799,244.203 352.792,243.506 353.217,243.073C353.642,242.64 354.339,242.634 354.772,243.059L357.87,246.1L365.591,238.052C366.011,237.614 366.708,237.6 367.146,238.02C367.583,238.44 367.598,239.136 367.178,239.574L358.687,248.424C358.483,248.636 358.204,248.758 357.91,248.762C357.616,248.767 357.333,248.653 357.123,248.447L353.232,244.628Z" Fill="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Path.RenderTransform>
                                            <CompositeTransform
                                                ScaleX="0.87531"
                                                ScaleY="0.87531"
                                                TranslateX="-303.749258"
                                                TranslateY="-200.216764" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Canvas>
                            </Viewbox>

                            <!-- Delivered shows 2 checks in rings. -->
                            <Viewbox
                                Height="12"
                                Visibility="{x:Bind local:MessageBubble.ShownFor(Bubble.StatusIcon, '3'), Mode=OneWay, FallbackValue=Collapsed}">
                                <Canvas Width="38" Height="24">
                                    <Path Data="M360.495,229.539C367.791,229.539 373.715,235.462 373.715,242.759C373.715,250.055 367.791,255.979 360.495,255.979C353.198,255.979 347.275,250.055 347.275,242.759C347.275,235.462 353.198,229.539 360.495,229.539ZM360.495,231.737C354.412,231.737 349.473,236.676 349.473,242.759C349.473,248.841 354.412,253.78 360.495,253.78C366.577,253.78 371.516,248.841 371.516,242.759C371.516,236.676 366.577,231.737 360.495,231.737ZM353.232,244.628C352.799,244.203 352.792,243.506 353.217,243.073C353.642,242.64 354.339,242.634 354.772,243.059L357.87,246.1L365.591,238.052C366.011,237.614 366.708,237.6 367.146,238.02C367.583,238.44 367.598,239.136 367.178,239.574L358.687,248.424C358.483,248.636 358.204,248.758 357.91,248.762C357.616,248.767 357.333,248.653 357.123,248.447L353.232,244.628ZM350.093,254.38C348.219,255.399 346.072,255.979 343.79,255.979C336.494,255.979 330.571,250.055 330.571,242.759C330.571,235.462 336.494,229.539 343.79,229.539C346.072,229.539 348.219,230.118 350.093,231.137C349.521,231.649 348.988,232.202 348.497,232.792C347.07,232.116 345.474,231.737 343.79,231.737C337.708,231.737 332.769,236.676 332.769,242.759C332.769,248.841 337.708,253.78 343.79,253.78C345.474,253.78 347.07,253.402 348.497,252.726C348.988,253.316 349.521,253.869 350.093,254.38ZM345.084,245.192L341.982,248.424C341.779,248.636 341.499,248.758 341.206,248.762C340.912,248.767 340.629,248.653 340.419,248.447L336.528,244.628C336.095,244.203 336.088,243.506 336.513,243.073C336.938,242.64 337.635,242.634 338.068,243.059L341.166,246.1L344.904,242.203C344.898,242.387 344.895,242.573 344.895,242.759C344.895,243.586 344.959,244.399 345.084,245.192Z" Fill="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Path.RenderTransform>
                                            <CompositeTransform
                                                ScaleX="0.87531"
                                                ScaleY="0.87531"
                                                TranslateX="-289.151299"
                                                TranslateY="-200.730342" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Canvas>
                            </Viewbox>

                            <!-- Read shows 2 filled circles with the checks cut out. -->
                            <Viewbox
                                Height="12"
                                Visibility="{x:Bind local:MessageBubble.ShownFor(Bubble.StatusIcon, '4'), Mode=OneWay, FallbackValue=Collapsed}">
                                <Canvas Width="39" Height="24">
