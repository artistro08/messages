<!-- Media Thumb: a 40 px rounded square for a quoted or replied-to message's media. A photo's or video's thumbnail cropped to
     fill (a GIF still), on a neutral fill until it arrives; a file icon for anything else -->
<UserControl
    x:Class="GMessages.App.Views.Controls.MediaThumb"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="40"
    Height="40">

    <!-- Placeholder Fill, The Icon, Then The Picture Over Them -->
    <Grid
        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
        CornerRadius="6">
        <FontIcon
            x:Name="Icon"
            FontSize="18"
            Glyph="&#xE8A5;"
            Visibility="Collapsed" />
        <Border x:Name="Picture" CornerRadius="6" />
    </Grid>
</UserControl>
