<!-- The 40 px rounded square shows the media of a quoted message. A photo or a video shows its thumbnail, cropped to
     fill, and a GIF shows still. A neutral fill shows until the thumbnail arrives. Other media shows its icon from
     MessageBubble.FileGlyph, such as the microphone for a voice message. -->
<UserControl
    x:Class="GMessages.App.Views.Controls.MediaThumb"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="40"
    Height="40">

    <!-- The picture covers the icon, and the icon covers the placeholder fill. -->
    <Grid
        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
        CornerRadius="6">
        <FontIcon
            x:Name="Icon"
            FontSize="18"
            Glyph="&#xE8A5;"
            Visibility="Collapsed" />
        <Border x:Name="Picture" CornerRadius="6" />
    </Grid>
</UserControl>
