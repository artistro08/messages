<UserControl
    x:Class="GMessages.App.Views.Controls.ConversationRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GMessages.App.Views.Controls"
    PointerCanceled="OnPointerLeft"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerLeft">

    <!-- The fill of a row with keyboard focus. High contrast has no fill, because the focus ring of Windows shows
         there. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="RowFocusFillBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="RowFocusFillBrush" Color="Transparent" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The row shows the avatar, the name and snippet, the time with the pin and muted icons, then the ⋮. The ⋮ takes
         no space until a hover. The transparent background lets the full row take the pointer, not only its text. -->
    <Grid
        x:Name="Root"
        Padding="0,10"
        Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Until a hover, the ⋮ is collapsed. Thus it takes no space, and screen readers do not find it. On a hover,
             the ⋮ takes its 32 px at the right edge and fades in. The time and icons of the row slide left to give it
             space. The ⋮ shows or collapses only once for each hover. It shows at the start of the slide in. It
             collapses at the end of the slide back. Thus the name trims once and never for each frame. The slide
             itself is a render transform. The slide names no start value and runs from the current place of the
             time. Thus a hover that returns during a slide changes direction smoothly. The code behind sets the start
             value for a slide in from rest. The group must stay on the root element of the control, because GoToState
             looks only there. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Hover">
                <VisualStateGroup.Transitions>

                    <!-- The slide in gives the ⋮ its space at once. The time slides left from its current place. -->
                    <VisualTransition To="Shown">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MoreButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MoreButton" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame
                                    KeySpline="{StaticResource ControlFastOutSlowInKeySpline}"
                                    KeyTime="{StaticResource ControlFastAnimationDuration}"
                                    Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TimeShift" Storyboard.TargetProperty="X">
                                <SplineDoubleKeyFrame
                                    KeySpline="{StaticResource ControlFastOutSlowInKeySpline}"
                                    KeyTime="{StaticResource ControlFastAnimationDuration}"
                                    Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualTransition>

                    <!-- On the slide out, the time slides back while the ⋮ keeps its space and fades. Hidden then
                         collapses the ⋮. The time is already at the right edge, so nothing jumps. -->
                    <VisualTransition To="Hidden">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MoreButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MoreButton" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame
                                    KeySpline="{StaticResource ControlFastOutSlowInKeySpline}"
                                    KeyTime="{StaticResource ControlFastAnimationDuration}"
                                    Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TimeShift" Storyboard.TargetProperty="X">
                                <SplineDoubleKeyFrame
                                    KeySpline="{StaticResource ControlFastOutSlowInKeySpline}"
                                    KeyTime="{StaticResource ControlFastAnimationDuration}"
                                    Value="32" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualTransition>
                </VisualStateGroup.Transitions>

                <!-- In Hidden, the ⋮ keeps its default collapsed state, and the time is at rest. -->
                <VisualState x:Name="Hidden" />
                <VisualState x:Name="Shown">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MoreButton" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                        </ObjectAnimationUsingKeyFrames>
                        <DoubleAnimation
                            Storyboard.TargetName="MoreButton"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="0" />
                        <DoubleAnimation
                            Storyboard.TargetName="TimeShift"
                            Storyboard.TargetProperty="X"
                            To="0"
                            Duration="0" />
                    </Storyboard>
                    <VisualState.Setters>
                        <Setter Target="MoreButton.IsHitTestVisible" Value="True" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!-- An unread row draws its snippet and time in primary text, as bright as its bold name. A read row keeps
                 the default secondary text. -->
            <VisualStateGroup x:Name="ReadState">
                <VisualState x:Name="Read" />
                <VisualState x:Name="Unread">
                    <VisualState.Setters>
                        <Setter Target="SnippetText.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Setter Target="TimeText.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- The fill of a row with keyboard focus. The list shows it. See ShowFocusFill in ChatsView.xaml.cs. The
             margin takes the fill out to the hover fill of the list item, past the padding of the row and the item. -->
        <Border
            x:Name="FocusFill"
            Grid.ColumnSpan="4"
            Margin="-12,-8,-8,-8"
            Background="{ThemeResource RowFocusFillBrush}"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            IsHitTestVisible="False"
            Opacity="0" />

        <local:Avatar
            VerticalAlignment="Center"
            Color="{x:Bind Row.AvatarColor, Mode=OneWay}"
            Initial="{x:Bind Row.Initial, Mode=OneWay}"
            PhotoId="{x:Bind Row.PhotoId, Mode=OneWay}"
            SecondColor="{x:Bind Row.SecondColor, Mode=OneWay}"
            SecondInitial="{x:Bind Row.SecondInitial, Mode=OneWay}"
            SecondPhotoId="{x:Bind Row.SecondPhotoId, Mode=OneWay}" />

        <!-- The name and snippet are bold while unread. Margins make the gaps to the avatar and the time. Column
             spacing would keep a gap for the hidden ⋮. -->
        <StackPanel
            Grid.Column="1"
            Margin="12,0"
            VerticalAlignment="Center">
            <TextBlock
                x:Name="NameText"
                FontWeight="{x:Bind local:ColorConverters.Weight(Row.IsUnread), Mode=OneWay}"
                IsTextTrimmedChanged="OnTextTrimmedChanged"
                MaxLines="1"
                Text="{x:Bind Row.Name, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="SnippetText"
                AutomationProperties.AutomationId="{x:Bind local:ConversationRow.PartId('Row.Snippet.', Row.Id), Mode=OneWay, FallbackValue=''}"
                FontStyle="{x:Bind local:ColorConverters.Style(Row.IsDraft), Mode=OneWay}"
                FontWeight="{x:Bind local:ColorConverters.Weight(Row.IsUnread), Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsTextTrimmedChanged="OnTextTrimmedChanged"
                MaxLines="1"
                Text="{x:Bind Row.Snippet, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Spacing="4">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="TimeShift" />
            </StackPanel.RenderTransform>
            <TextBlock
                x:Name="TimeText"
                HorizontalAlignment="Right"
                AutomationProperties.AutomationId="{x:Bind local:ConversationRow.PartId('Row.Time.', Row.Id), Mode=OneWay, FallbackValue=''}"
                FontWeight="{x:Bind local:ColorConverters.Weight(Row.IsUnread), Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Row.Time, Mode=OneWay}" />
            <!-- The icon line always keeps its 16 px, so the time of each row sits at the same height. -->
            <StackPanel
                Height="16"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">

                <!-- Muted is a text glyph, so screen readers and the tests can find it by name. -->
                <TextBlock
                    x:Name="MutedIcon"
                    AutomationProperties.AutomationId="{x:Bind local:ConversationRow.PartId('Row.Muted.', Row.Id), Mode=OneWay, FallbackValue=''}"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="&#xE7ED;"
                    Visibility="{x:Bind Row.IsMuted, Mode=OneWay, FallbackValue=Collapsed}" />
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE718;"
                    Visibility="{x:Bind Row.IsPinned, Mode=OneWay, FallbackValue=Collapsed}" />
            </StackPanel>
        </StackPanel>

        <!-- More options is the ⋮. It stays collapsed until a hover on the row, as the Hover group above shows. It is
             not a tab stop. The Application key or Shift + F10 on the row opens the same menu. -->
        <Button
            x:Name="MoreButton"
            Grid.Column="3"
            Width="32"
            Height="32"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="{x:Bind local:ConversationRow.PartId('Row.More.', Row.Id), Mode=OneWay, FallbackValue=''}"
            Click="OnMoreClick"
            IsHitTestVisible="False"
            IsTabStop="False"
            Opacity="0"
            Style="{StaticResource IconButtonStyle}"
            Visibility="Collapsed">
            <FontIcon FontSize="16" Glyph="&#xE712;" />
        </Button>
    </Grid>
</UserControl>
