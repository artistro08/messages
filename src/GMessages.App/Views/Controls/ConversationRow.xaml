<UserControl
    x:Class="GMessages.App.Views.Controls.ConversationRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GMessages.App.Views.Controls"
    PointerCanceled="OnPointerLeft"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerLeft">

    <!-- Row: avatar, name and snippet, the time with the pin and muted icons, then the ⋮. Transparent, so the whole row
         takes the pointer (hover) and not just its text -->
    <Grid
        x:Name="Root"
        Padding="0,10"
        Background="Transparent"
        ColumnDefinitions="Auto,*,Auto,Auto"
        ColumnSpacing="12">

        <!-- Hover: the ⋮ fades and slides in while the pointer is over the row. Its space is always kept, so rows never
             reflow. The group must stay on the control's root element: GoToState only looks there -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Hover">
                <VisualStateGroup.Transitions>
                    <VisualTransition To="Shown">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MoreButton" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame
                                    KeySpline="{StaticResource ControlFastOutSlowInKeySpline}"
                                    KeyTime="{StaticResource ControlFastAnimationDuration}"
                                    Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MoreShift" Storyboard.TargetProperty="X">
                                <SplineDoubleKeyFrame
                                    KeySpline="{StaticResource ControlFastOutSlowInKeySpline}"
                                    KeyTime="{StaticResource ControlFastAnimationDuration}"
                                    Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Hidden" />
                <VisualState x:Name="Shown">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="MoreButton"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="0" />
                        <DoubleAnimation
                            Storyboard.TargetName="MoreShift"
                            Storyboard.TargetProperty="X"
                            To="0"
                            Duration="0" />
                    </Storyboard>
                    <VisualState.Setters>
                        <Setter Target="MoreButton.IsHitTestVisible" Value="True" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Avatar -->
        <local:Avatar
            VerticalAlignment="Center"
            Color="{x:Bind Row.AvatarColor, Mode=OneWay}"
            Initial="{x:Bind Row.Initial, Mode=OneWay}"
            PhotoId="{x:Bind Row.PhotoId, Mode=OneWay}"
            SecondColor="{x:Bind Row.SecondColor, Mode=OneWay}"
            SecondInitial="{x:Bind Row.SecondInitial, Mode=OneWay}"
            SecondPhotoId="{x:Bind Row.SecondPhotoId, Mode=OneWay}" />

        <!-- Name And Snippet: bold while unread -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock
                FontWeight="{x:Bind local:ColorConverters.Weight(Row.IsUnread), Mode=OneWay}"
                MaxLines="1"
                Text="{x:Bind Row.Name, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                FontWeight="{x:Bind local:ColorConverters.Weight(Row.IsUnread), Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="1"
                Text="{x:Bind Row.Snippet, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Time, Then The Muted And Pin Icons -->
        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Spacing="4">
            <TextBlock
                HorizontalAlignment="Right"
                FontWeight="{x:Bind local:ColorConverters.Weight(Row.IsUnread), Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Row.Time, Mode=OneWay}" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">

                <!-- Muted: a text glyph, so screen readers and the tests can find it by name -->
                <TextBlock
                    x:Name="MutedIcon"
                    AutomationProperties.AutomationId="{x:Bind local:ConversationRow.PartId('Row.Muted.', Row.Id), Mode=OneWay, FallbackValue=''}"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="&#xE7ED;"
                    Visibility="{x:Bind Row.IsMuted, Mode=OneWay, FallbackValue=Collapsed}" />
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE718;"
                    Visibility="{x:Bind Row.IsPinned, Mode=OneWay, FallbackValue=Collapsed}" />
            </StackPanel>
        </StackPanel>

        <!-- More Options: the ⋮, shown on hover (see Hover above). Not a tab stop: the keyboard opens the same menu with
             the Application key or Shift + F10 on the row -->
        <Button
            x:Name="MoreButton"
            Grid.Column="3"
            Width="32"
            Height="32"
            Padding="0"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="{x:Bind local:ConversationRow.PartId('Row.More.', Row.Id), Mode=OneWay, FallbackValue=''}"
            Click="OnMoreClick"
            IsHitTestVisible="False"
            IsTabStop="False"
            Opacity="0"
            Style="{StaticResource SubtleButtonStyle}">
            <Button.RenderTransform>
                <TranslateTransform x:Name="MoreShift" X="8" />
            </Button.RenderTransform>
            <FontIcon FontSize="16" Glyph="&#xE712;" />
        </Button>
    </Grid>
    <!-- /Row -->
</UserControl>
