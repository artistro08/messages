<UserControl
    x:Class="GMessages.App.Views.Controls.ConversationRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GMessages.App.Views.Controls"
    PointerCanceled="OnPointerLeft"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerLeft">

    <!-- Flash: a new message lights the row in the accent color for a moment, then it fades out (see Flash) -->
    <UserControl.Resources>
        <Storyboard x:Name="FlashStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FlashFill" Storyboard.TargetProperty="Opacity">
                <SplineDoubleKeyFrame
                    KeySpline="{StaticResource ControlFastOutSlowInKeySpline}"
                    KeyTime="0:0:0.15"
                    Value="0.3" />
                <SplineDoubleKeyFrame
                    KeySpline="{StaticResource ControlFastOutSlowInKeySpline}"
                    KeyTime="0:0:0.95"
                    Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <!-- Row: avatar, name and snippet, the time with the pin and muted icons, then the ⋮ (no space until hovered).
         Transparent, so the whole row takes the pointer (hover) and not just its text -->
    <Grid
        x:Name="Root"
        Padding="0,10"
        Background="Transparent"
        ColumnDefinitions="Auto,*,Auto,Auto">

        <!-- Hover: the ⋮ (collapsed until then, so it takes no space and screen readers don't find it) takes its 32 px
             at the right edge and fades in, and this row's time and icons slide left to make room. The ⋮ shows or
             collapses once per hover (at the start of the slide in, at the end of the slide back), so the name trims
             once, never per frame; the slide itself is a render transform. The slide never names a start: it runs
             from wherever the time is, so a hover that comes back mid-slide turns around smoothly (the code behind sets
             the start for a slide in from rest). The group must stay on the control's root element: GoToState only
             looks there -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Hover">
                <VisualStateGroup.Transitions>

                    <!-- In: the ⋮'s space at once, while the time slides left from where it is -->
                    <VisualTransition To="Shown">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MoreButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MoreButton" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame
                                    KeySpline="{StaticResource ControlFastOutSlowInKeySpline}"
                                    KeyTime="{StaticResource ControlFastAnimationDuration}"
                                    Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TimeShift" Storyboard.TargetProperty="X">
                                <SplineDoubleKeyFrame
                                    KeySpline="{StaticResource ControlFastOutSlowInKeySpline}"
                                    KeyTime="{StaticResource ControlFastAnimationDuration}"
                                    Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualTransition>

                    <!-- Out: the time slides back while the ⋮ keeps its space and fades; Hidden then collapses the ⋮, with the
                         time already at the right edge, so nothing jumps -->
                    <VisualTransition To="Hidden">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MoreButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MoreButton" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame
                                    KeySpline="{StaticResource ControlFastOutSlowInKeySpline}"
                                    KeyTime="{StaticResource ControlFastAnimationDuration}"
                                    Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TimeShift" Storyboard.TargetProperty="X">
                                <SplineDoubleKeyFrame
                                    KeySpline="{StaticResource ControlFastOutSlowInKeySpline}"
                                    KeyTime="{StaticResource ControlFastAnimationDuration}"
                                    Value="32" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualTransition>
                </VisualStateGroup.Transitions>

                <!-- Hidden: the ⋮ stays collapsed (its default) and the time sits at rest -->
                <VisualState x:Name="Hidden" />
                <VisualState x:Name="Shown">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MoreButton" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                        </ObjectAnimationUsingKeyFrames>
                        <DoubleAnimation
                            Storyboard.TargetName="MoreButton"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="0" />
                        <DoubleAnimation
                            Storyboard.TargetName="TimeShift"
                            Storyboard.TargetProperty="X"
                            To="0"
                            Duration="0" />
                    </Storyboard>
                    <VisualState.Setters>
                        <Setter Target="MoreButton.IsHitTestVisible" Value="True" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Flash Fill: behind the whole row, padding included, clear until a new message flashes it -->
        <Border
            x:Name="FlashFill"
            Grid.ColumnSpan="4"
            Margin="0,-10"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            CornerRadius="{StaticResource ControlCornerRadius}"
            IsHitTestVisible="False"
            Opacity="0" />

        <!-- Avatar -->
        <local:Avatar
            VerticalAlignment="Center"
            Color="{x:Bind Row.AvatarColor, Mode=OneWay}"
            Initial="{x:Bind Row.Initial, Mode=OneWay}"
            PhotoId="{x:Bind Row.PhotoId, Mode=OneWay}"
            SecondColor="{x:Bind Row.SecondColor, Mode=OneWay}"
            SecondInitial="{x:Bind Row.SecondInitial, Mode=OneWay}"
            SecondPhotoId="{x:Bind Row.SecondPhotoId, Mode=OneWay}" />

        <!-- Name And Snippet: bold while unread. Its margins make the gaps to the avatar and the time (no column spacing,
             which would keep a gap for the hidden ⋮) -->
        <StackPanel
            Grid.Column="1"
            Margin="12,0"
            VerticalAlignment="Center">
            <TextBlock
                FontWeight="{x:Bind local:ColorConverters.Weight(Row.IsUnread), Mode=OneWay}"
                MaxLines="1"
                Text="{x:Bind Row.Name, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                FontWeight="{x:Bind local:ColorConverters.Weight(Row.IsUnread), Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="1"
                Text="{x:Bind Row.Snippet, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Time, Then The Muted And Pin Icons -->
        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Spacing="4">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="TimeShift" />
            </StackPanel.RenderTransform>
            <TextBlock
                HorizontalAlignment="Right"
                AutomationProperties.AutomationId="{x:Bind local:ConversationRow.PartId('Row.Time.', Row.Id), Mode=OneWay, FallbackValue=''}"
                FontWeight="{x:Bind local:ColorConverters.Weight(Row.IsUnread), Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Row.Time, Mode=OneWay}" />
            <!-- Icons: the line is always kept (16 px), so every row's time sits at the same height -->
            <StackPanel
                Height="16"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">

                <!-- Muted: a text glyph, so screen readers and the tests can find it by name -->
                <TextBlock
                    x:Name="MutedIcon"
                    AutomationProperties.AutomationId="{x:Bind local:ConversationRow.PartId('Row.Muted.', Row.Id), Mode=OneWay, FallbackValue=''}"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="&#xE7ED;"
                    Visibility="{x:Bind Row.IsMuted, Mode=OneWay, FallbackValue=Collapsed}" />
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE718;"
                    Visibility="{x:Bind Row.IsPinned, Mode=OneWay, FallbackValue=Collapsed}" />
            </StackPanel>
        </StackPanel>

        <!-- More Options: the ⋮, collapsed until the row is hovered (see Hover above). Not a tab stop: the keyboard opens
             the same menu with the Application key or Shift + F10 on the row -->
        <Button
            x:Name="MoreButton"
            Grid.Column="3"
            Width="32"
            Height="32"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="{x:Bind local:ConversationRow.PartId('Row.More.', Row.Id), Mode=OneWay, FallbackValue=''}"
            Click="OnMoreClick"
            IsHitTestVisible="False"
            IsTabStop="False"
            Opacity="0"
            Style="{StaticResource IconButtonStyle}"
            Visibility="Collapsed">
            <FontIcon FontSize="16" Glyph="&#xE712;" />
        </Button>
    </Grid>
    <!-- /Row -->
</UserControl>
