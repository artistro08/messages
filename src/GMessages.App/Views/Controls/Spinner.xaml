<!-- A turning arc, 16 px. It replaces ProgressRing in the message bubbles. ProgressRing draws with composition shapes,
     and they lost their smooth edges there. A XAML path draws at the screen scale with smooth edges, as the other round
     shapes of the app do. -->
<UserControl
    x:Class="GMessages.App.Views.Controls.Spinner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="16"
    Height="16"
    AutomationProperties.AccessibilityView="Raw"
    IsHitTestVisible="False"
    IsTabStop="False">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation
                        Storyboard.TargetName="Turn"
                        Storyboard.TargetProperty="Angle"
                        From="0"
                        To="360"
                        Duration="0:0:1" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <!-- A quarter circle of radius 7 with a 2 px stroke fills the 16 px box. -->
    <Path
        Data="M 8,1 A 7,7 0 0 1 15,8"
        RenderTransformOrigin="0.5,0.5"
        Stroke="{ThemeResource AccentFillColorDefaultBrush}"
        StrokeEndLineCap="Round"
        StrokeStartLineCap="Round"
        StrokeThickness="2">
        <Path.RenderTransform>
            <RotateTransform x:Name="Turn" />
        </Path.RenderTransform>
    </Path>
</UserControl>
