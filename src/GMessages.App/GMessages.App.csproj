<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>GMessages.App</RootNamespace>
    <!-- The exe is named from the single display name property -->
    <AssemblyName>$(AppDisplayName)</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Tray app with a small heap: no background GC thread and its reserved memory -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Exe icon, drawn by scripts/New-AppAssets.ps1 -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- TODO: Task 11 turns on EnableMsixTooling and the Msix project capability for packaging -->
  </PropertyGroup>

  <!-- Debug: unpackaged, with the test hooks compiled in -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <WindowsPackageType>None</WindowsPackageType>
    <DefineConstants>$(DefineConstants);EnableTestHooks</DefineConstants>
  </PropertyGroup>

  <!-- Release guard: the test hooks must never ship -->
  <Target Name="GuardTestHooks" BeforeTargets="CoreCompile" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="$(DefineConstants.Contains('EnableTestHooks'))" Text="EnableTestHooks must not be defined in a Release build." />
  </Target>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icons and logos: the tray loads its .ico files from the output folder at runtime -->
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GMessages.Presentation\GMessages.Presentation.csproj" />
  </ItemGroup>

</Project>
