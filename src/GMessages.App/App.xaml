<Application
    x:Class="GMessages.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Title Bars: the content fills the space up to the caption buttons (the main window pins its profile
                 picture to that end), with no spare drag strip after it. Set here because the template reads them from
                 the app, not from the TitleBar -->
            <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
            <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
        </ResourceDictionary>
    </Application.Resources>
</Application>
