<Application
    x:Class="GMessages.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Title Bars: no spare drag strip between a right header (the main window's profile picture) and the caption
                 buttons. Set here because the template's column reads it from the app, not from the TitleBar -->
            <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
