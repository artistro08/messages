<Application
    x:Class="GMessages.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GMessages.App.Views.Controls">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!-- Icon Buttons (owner, Task 22): a button that is just an icon gets no background or border on hover or
                     press. The subtle button's hover and press brushes, which only SubtleButtonStyle (and so IconButtonStyle)
                     reads, are clear in Light and Dark. The title bar's Back keeps Windows' default feedback (owner, Plan 7),
                     and so does ☰, which puts the subtle brushes back in its own resources. A merged dictionary after the controls'
                     resources, the only place that overrides theirs: a merged dictionary is searched before this one's own
                     theme dictionaries. No high contrast dictionary, so high contrast keeps the system's own hover and press
                     colors; the foreground, focus visual and disabled look stay Fluent's -->
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="SubtleButtonBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="SubtleButtonBackgroundPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="SubtleButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="SubtleButtonBorderBrushPressed" Color="Transparent" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="SubtleButtonBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="SubtleButtonBackgroundPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="SubtleButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="SubtleButtonBorderBrushPressed" Color="Transparent" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <!-- Sent RCS Bubble: a lighter (Light) or darker (Dark) shade of the accent, with the regular text color on it
                 (sent SMS and MMS take the full accent). Its border matches the fill there; in high contrast the fill is the
                 window color, so the border is the text color to keep the bubble's edge.
                 Reply Quote: a tint of the bubble it sits in with an accent bar. On the card color and on the RCS shade it is the
                 accent, faint; on the full accent (SMS) it is the text-on-accent color, faint, with a bar of that color. In
                 high contrast the quote takes the bubble's own color (window, or highlight on SMS) and a highlight bar.
                 Reaction Pill Edge: none (clear) in Light and Dark; the text color in high contrast, so the pill keeps an edge.
                 Reaction Pill Mine: a soft accent tint as the fill (no ring).
                 Here, not in the pill's own resources: a ThemeResource on an element can't see keys its own Resources define
                 after it, and the failed lookup crashed the app as soon as a bubble was made -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="RcsBubbleBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="RcsBubbleBorderBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="QuoteFillBrush" Opacity="0.14" Color="{ThemeResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="QuoteBarBrush" Color="{ThemeResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="QuoteOnAccentFillBrush" Opacity="0.18" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                    <SolidColorBrush x:Key="ReactionPillBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ReactionPillMineBrush" Color="{ThemeResource SystemAccentColorLight3}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="RcsBubbleBrush" Color="{ThemeResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="RcsBubbleBorderBrush" Color="{ThemeResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="QuoteFillBrush" Opacity="0.18" Color="{ThemeResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="QuoteBarBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="QuoteOnAccentFillBrush" Opacity="0.18" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                    <SolidColorBrush x:Key="ReactionPillBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ReactionPillMineBrush" Color="{ThemeResource SystemAccentColorDark2}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="RcsBubbleBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="RcsBubbleBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="QuoteFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="QuoteBarBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="QuoteOnAccentFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ReactionPillBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ReactionPillMineBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Icon Button: every button that is just an icon (or a picture). Fluent's subtle button with no padding, so the
                 icon centers in the button's set size; its hover and press backgrounds are clear (Icon Buttons, above).
                 Pressing shrinks the icon and releasing springs it back (IconPress). Defined here, before any page or
                 control that uses it loads -->
            <Style
                x:Key="IconButtonStyle"
                BasedOn="{StaticResource SubtleButtonStyle}"
                TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="controls:IconPress.IsEnabled" Value="True" />
            </Style>

            <!-- Who Reacted: the flyout's thin edge matches a menu's, so the compact rows sit close to its border -->
            <Style
                x:Key="ReactorsFlyoutPresenterStyle"
                BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
                TargetType="FlyoutPresenter">
                <Setter Property="Padding" Value="0,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
