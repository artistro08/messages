<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- LibraryImport (DPI Awareness Setup) Generates Unsafe Code -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Test Names Use Underscores -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GMessages.Protocol\GMessages.Protocol.csproj" />
    <!-- AppInfo.DisplayName: Window Titles And The Tray Icon Name -->
    <ProjectReference Include="..\GMessages.Presentation\GMessages.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FlaUI Drives The Real Exe In The UI Tests (Task 10) -->
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="MSTest" Version="3.11.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Media Fixtures: A 2 s, 160 x 120 H.264 + AAC Clip (ffmpeg testsrc And A 440 Hz Tone) -->
    <None Include="Fixtures\clip.mp4" CopyToOutputDirectory="PreserveNewest" />
    <!-- A 20 s, 160 x 120 Clip Made The Same Way, Long Enough To Pause Mid-Play -->
    <None Include="Fixtures\clip-long.mp4" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
